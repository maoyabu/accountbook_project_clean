<% layout('layouts/boilerplate') %>

<div class="row g-3">
  <div class="col-12 col-lg-6">
    <div class="card">
      <div class="card-header text-white" style="background-color: #3a7ca5;">
        マイリスト
      </div>
      <div class="card-body">
        <% if (wantolistItems.length > 0) { %>
          <ul class="list-group small">
            <% wantolistItems.forEach(item => { %>
              <li class="list-group-item d-flex justify-content-between">
                <span><%= item.title %></span>
                <span class="text-muted"><%= item.item %></span>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <div class="text-muted">マイリストの登録がありません。</div>
        <% } %>
        <div class="mt-3">
          <a class="btn btn-outline-primary btn-sm" href="/allaboutme/wantolist">マイリストへ</a>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12 col-lg-6">
    <div class="card">
      <div class="card-header text-white" style="background-color: #3a7ca5;">
        マイ日記
      </div>
      <div class="card-body">
        <% if (diaryEntries.length > 0) { %>
          <ul class="list-group small">
            <% diaryEntries.forEach(entry => { %>
              <li class="list-group-item">
                <div class="fw-bold"><%= entry.event || 'イベント未入力' %></div>
                <div class="text-muted"><%= entry.date ? entry.date.toISOString().split('T')[0] : '' %></div>
                <div class="text-truncate"><%= entry.content || '内容未入力' %></div>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <div class="text-muted">マイ日記の登録がありません。</div>
        <% } %>
        <div class="mt-3 d-flex flex-wrap gap-2">
          <a class="btn btn-outline-primary btn-sm" href="/allaboutme/eventcal">マイ日記へ</a>
          <a class="btn btn-outline-primary btn-sm" href="/allaboutme/export-diary">My日記書出し</a>
          <a class="btn btn-outline-primary btn-sm" href="/allaboutme/eventcal_events">My日記設定</a>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12">
    <div class="card">
      <div class="card-header text-white" style="background-color: #3a7ca5;">
        Myselfメニュー
      </div>
      <div class="card-body d-flex flex-wrap gap-2">
        <a class="btn btn-outline-primary btn-sm" href="/history/list">My History</a>
        <a class="btn btn-outline-primary btn-sm" href="/history/categories">My History設定</a>
        <a class="btn btn-outline-primary btn-sm" href="/resume/myresume">My 履歴書</a>
        <a class="btn btn-outline-primary btn-sm" href="/relation">My Relation</a>
        <a class="btn btn-outline-primary btn-sm" href="/allaboutme/report/mylist">All About me レポート</a>
      </div>
    </div>
  </div>
</div>
