<% layout('layouts/boilerplate') %>

<div class="row g-3">
  <div class="col-12">
    <div class="card">
      <div class="card-header text-white d-flex justify-content-between align-items-center" style="background-color: #4A6A7A;">
        <span>All About me レポート</span>
        <a class="btn btn-outline-light btn-sm" href="/allaboutme/report/mylist"><i class="fa-regular fa-clipboard me-2"></i>レポート詳細</a>
      </div>
      <div class="card-body">
        <div class="fw-bold mb-2"><%= reportYear %>年<%= reportMonth %>月のMyリスト</div>
        <div class="row g-3">
          <div class="col-12 col-lg-6">
            <div class="fw-bold mb-2">先月新規追加（<%= reportNewItems.length %>件）</div>
            <% if (reportNewItems.length > 0) { %>
              <ul class="list-group small">
                <% reportNewItems.forEach(item => { %>
                  <li class="list-group-item">
                    <strong><%= item.title %></strong> &lt;<%= item.item %>&gt;
                    <small class="text-muted">（<%= new Date(item.entry_date).toLocaleDateString() %>）</small>
                  </li>
                <% }) %>
              </ul>
            <% } else { %>
              <div class="text-muted">新規追加はありません。</div>
            <% } %>
          </div>
          <div class="col-12 col-lg-6">
            <div class="fw-bold mb-2">先月完了/破棄（<%= reportCompletedItems.length %>件）</div>
            <% if (reportCompletedItems.length > 0) { %>
              <ul class="list-group small">
                <% reportCompletedItems.forEach(item => { %>
                  <li class="list-group-item">
                    <strong><%= item.title %></strong> &lt;<%= item.item %>&gt;
                    <span class="badge bg-secondary"><%= item.status %></span>
                    <small class="text-muted">（<%= new Date(item.update_date).toLocaleDateString() %>）</small>
                  </li>
                <% }) %>
              </ul>
            <% } else { %>
              <div class="text-muted">完了/破棄はありません。</div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12 col-lg-6">
    <div class="card">
      <div class="card-header text-white" style="background-color: #4A6A7A;">
        マイリスト
      </div>
      <div class="card-body">
        <% if (wantolistItems.length > 0) { %>
          <ul class="list-group small">
            <% wantolistItems.forEach(item => { %>
              <li class="list-group-item d-flex justify-content-between">
                <span><%= item.title %></span>
                <span class="text-muted"><%= item.item %></span>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <div class="text-muted">マイリストの登録がありません。</div>
        <% } %>
        <div class="mt-3">
          <a class="btn btn-sm myself-action-btn" href="/allaboutme/wantolist"><i class="fa-solid fa-list-check me-2"></i>マイリスト</a>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12 col-lg-6">
    <div class="card">
      <div class="card-header text-white d-flex justify-content-between align-items-center" style="background-color: #4A6A7A;">
        <span>MyDiary</span>
        <a class="btn btn-outline-light btn-sm" href="/allaboutme/diary-settings"><i class="fa-solid fa-gear me-2"></i>MyDiary設定</a>
      </div>
      <div class="card-body">
        <% if (diaryEntries.length > 0) { %>
          <ul class="list-group small">
            <% diaryEntries.forEach(entry => { %>
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <span class="text-truncate" style="max-width: 70%;">
                  <strong><%= entry.event || 'イベント未入力' %></strong>
                  <span class="text-muted ms-2"><%= entry.date ? entry.date.toISOString().split('T')[0] : '' %></span>
                  <span class="ms-2"><%= entry.content || '内容未入力' %></span>
                </span>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <div class="text-muted">MyDiaryの登録がありません。</div>
        <% } %>
        <div class="mt-3 d-flex flex-wrap gap-2">
          <a class="btn btn-sm myself-action-btn" href="/allaboutme/eventcal2"><i class="fa-solid fa-calendar-days me-2"></i>今日のMyDiary</a>
          <a class="btn btn-sm myself-action-btn" href="/allaboutme/export-diary"><i class="fa-regular fa-file-lines me-2"></i>MyDiary書出し</a>
          <a class="btn btn-sm myself-action-btn" href="/allaboutme/diary-keywords"><i class="fa-solid fa-chart-column me-2"></i>キーワードランキング/マッピング</a>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12">
    <div class="card">
      <div class="card-header text-white d-flex justify-content-between align-items-center" style="background-color: #4A6A7A;">
        <span>My History</span>
        <a class="btn btn-outline-light btn-sm" href="/history/categories"><i class="fa-solid fa-gear me-2"></i>My History設定</a>
      </div>
      <div class="card-body">
        <% if (recentHistories.length > 0) { %>
          <ul class="list-group small">
            <% recentHistories.forEach(history => { %>
              <li class="list-group-item d-flex justify-content-between">
                <span>
                  <strong><%= history.category?.name || '未分類' %></strong>
                  <%= history.content ? ` / ${history.content}` : '' %>
                </span>
                <small class="text-muted"><%= history.entry_date ? new Date(history.entry_date).toLocaleDateString() : '' %></small>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <div class="text-muted">My Historyの登録がありません。</div>
        <% } %>
        <div class="mt-3 d-flex flex-wrap gap-2">
          <a class="btn btn-sm myself-action-btn" href="/history/list"><i class="fa-solid fa-clock-rotate-left me-2"></i>My History</a>
          <a class="btn btn-sm myself-action-btn" href="/resume/myresume"><i class="fa-solid fa-book me-2"></i>My 履歴書</a>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12">
    <div class="card">
      <div class="card-header text-white" style="background-color: #4A6A7A;">
        Myselfメニュー
      </div>
      <div class="card-body d-flex flex-wrap gap-2">
        <a class="btn btn-sm myself-action-btn" href="/relation"><i class="fa-solid fa-people-group me-2"></i>My Relation</a>
      </div>
    </div>
  </div>
</div>
