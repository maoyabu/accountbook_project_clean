<!DOCTYPE html>
<html lang="jp">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <!-- Bootstrap 5.1 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/@fullcalendar/bootstrap5@6.1.10/index.global.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/locales/ja.global.min.js"></script>
      
    <link rel="stylesheet" href="/css/main.css">
    <title>All About me</title>
    <link rel="icon" href="/images/App_icon.png" type="image/png">
</head>
<body class="d-flex flex-column vh-100">
    <%- include('../partials/header_login_nav') %>
    <main class ="<%= typeof mainClass !== 'undefined' ? mainClass : 'container' %>">
        <%- include('../partials/flash') %>
        <%- body -%>
    </main>
    <% const fabSvc = (typeof services !== 'undefined' && services)
      ? Object.assign({ allaboutme: true, finance: true, assets: true, message: true }, services)
      : { allaboutme: true, finance: true, assets: true, message: true }; %>
    <% const fabActiveSvc = (typeof activeService !== 'undefined' && activeService) ? activeService : 'finance'; %>
    <% const fabCu = (typeof currentUser !== 'undefined') ? currentUser : null; %>
    <% const fabAgid = (typeof activeGroupId !== 'undefined') ? activeGroupId : null; %>
    <% const fabAgStr = fabAgid ? fabAgid.toString() : null; %>
    <% const fabHasGroup = fabCu && Array.isArray(fabCu.groups) && fabCu.groups.length > 0 && fabAgStr && fabCu.groups.some(group => group && group._id && group._id.toString() === fabAgStr); %>
    <% const fabQuickItems = (typeof financeQuickMenuItems !== 'undefined' && Array.isArray(financeQuickMenuItems)) ? financeQuickMenuItems : []; %>
    <% const fabQuickEnabled = typeof financeQuickMenuEnabled === 'undefined' ? true : financeQuickMenuEnabled !== false; %>
    <% if (fabActiveSvc === 'finance' && fabSvc.finance && fabHasGroup) { %>
      <div class="finance-quick-fab <%= fabQuickEnabled ? '' : 'is-disabled' %>" id="finance-quick-fab" aria-label="家計簿のよく使う項目" data-finance-quick-enabled="<%= fabQuickEnabled ? 'true' : 'false' %>">
        <div class="finance-quick-fab-top">
          <div class="finance-quick-fab-title">
            <span class="finance-quick-fab-dots" aria-hidden="true">
              <span></span><span></span><span></span>
              <span></span><span></span><span></span>
              <span></span><span></span><span></span>
            </span>
            <span>よく使うメニュー</span>
          </div>
          <a href="/finance/budget#financeQuickMenuSettings" class="finance-quick-fab-control" aria-label="よく使う項目を設定" title="設定">
            <i class="fa-solid fa-gear"></i>
          </a>
          <button
            type="button"
            class="finance-quick-fab-control finance-quick-fab-collapse"
            data-finance-quick-collapse
            aria-label="よく使う項目の表示切替"
            aria-expanded="<%= fabQuickEnabled ? 'true' : 'false' %>"
            title="表示切替"
          >
            <i class="fa-solid fa-chevron-down"></i>
          </button>
        </div>
        <div class="finance-quick-fab-content">
          <div class="finance-quick-fab-items">
            <a
              href="/finance/entry"
              class="finance-quick-fab-item finance-quick-fab-mobile-entry"
              data-finance-quick-key="new_entry"
              title="新規登録"
            >
              <i class="fa-solid fa-plus"></i>
              <span>新規登録</span>
            </a>
            <% fabQuickItems.forEach((item) => { %>
              <% if (item.key === 'group_switch') { %>
                <button
                  type="button"
                  class="finance-quick-fab-item"
                  data-finance-quick-key="<%= item.key %>"
                  data-finance-quick-action="group-switch"
                  title="<%= item.displayLabel %>"
                >
                  <i class="fa-solid <%= item.icon %>"></i>
                  <span><%= item.displayLabel %></span>
                </button>
              <% } else { %>
                <a
                  href="<%= item.href %>"
                  class="finance-quick-fab-item"
                  data-finance-quick-key="<%= item.key %>"
                  title="<%= item.displayLabel %>"
                >
                  <i class="fa-solid <%= item.icon %>"></i>
                  <span><%= item.displayLabel %></span>
                </a>
              <% } %>
            <% }) %>
          </div>
        </div>
      </div>
    <% } %>
    <% if (fabActiveSvc === 'finance' && fabSvc.finance && fabHasGroup && (financeClose?.show || financeClose?.yearShow)) { %>
      <div class="finance-close-stack" id="finance-close-stack">
        <% if (financeClose?.show) { %>
          <form
            action="/finance/month-close/complete"
            method="POST"
            class="finance-close-fab"
            id="finance-close-fab"
            onsubmit="return confirm('本当に完了しましたか？');"
          >
            <input type="hidden" name="redirectTo" value="<%= currentPath || '/finance/top' %>">
            <button type="submit" class="finance-close-button" title="<%= financeClose.monthLabel %>の入力完了">
              <span class="finance-close-handle" aria-hidden="true">
                <i class="fa-solid fa-up-down-left-right"></i>
              </span>
              <span class="finance-close-label"><%= financeClose.monthLabel %>の入力完了</span>
            </button>
          </form>
        <% } %>
        <% if (financeClose?.yearShow) { %>
          <form
            action="/finance/year-close/complete"
            method="POST"
            class="finance-close-fab finance-close-fab-year"
            id="finance-close-year-fab"
            onsubmit="return confirm('本当に完了しましたか？');"
          >
            <input type="hidden" name="redirectTo" value="<%= currentPath || '/finance/top' %>">
            <button type="submit" class="finance-close-button finance-close-year-button" title="<%= financeClose.yearLabel %>の入力完了">
              <span class="finance-close-handle" aria-hidden="true">
                <i class="fa-solid fa-up-down-left-right"></i>
              </span>
              <span class="finance-close-label"><%= financeClose.yearLabel %>の入力完了</span>
            </button>
          </form>
        <% } %>
      </div>
    <% } %>
    <%- include('../partials/footer') %>
    <!-- Bootstrap 5.1 Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous"></script>
    <script src="/js/formHandler.js"></script>
    <script src="/js/form.js"></script>
    <% if (typeof page !== 'undefined' && !['wantolist', 'eventcal', 'eventcal_events', 'eventcal_batch'].includes(page)) { %>
        <script src="/js/app.js"></script>
    <% } %>

</body>
</html>
