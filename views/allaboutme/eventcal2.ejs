<% layout('layouts/boilerplate') -%>
<% page = 'eventcal2' %>

<div class="nav-guide-row d-flex justify-content-between align-items-center gap-2 flex-wrap">
  <%- include('../partials/allaboutme_tabs_nav') %>
</div>

<div class="container mt-3">
  <div class="diary-layout">
    <div class="diary-calendar-card">
      <div class="diary-calendar-header">
        <button type="button" class="diary-nav-btn" data-nav="-1" aria-label="前の月">&#x2039;</button>
        <div class="diary-month" id="diaryMonthLabel"></div>
        <button type="button" class="diary-nav-btn" data-nav="1" aria-label="次の月">&#x203A;</button>
      </div>
      <div class="diary-weekdays">
        <span>月</span>
        <span>火</span>
        <span>水</span>
        <span>木</span>
        <span>金</span>
        <span>土</span>
        <span>日</span>
      </div>
      <div id="diaryGrid" class="diary-grid"></div>
      <% if (monthlyTagSummary && monthlyTagSummary.length > 0) { %>
        <div class="diary-month-tags">
          <div class="diary-month-tags-title">今月のキーワード</div>
          <div class="diary-tags">
            <% monthlyTagSummary.forEach((tag, idx) => { %>
              <% if (idx < 10) { %>
                <button type="button" class="diary-tag diary-tag-month-top diary-month-tag-btn" data-tag="<%= tag.name %>">
                  <span><%= tag.name %></span>
                  <span class="diary-tag-count">(<%= tag.count %>)</span>
                  <span class="diary-tag-remove" role="button" tabindex="0" aria-label="除外ワードに追加" data-tag="<%= tag.name %>">×</span>
                </button>
              <% } else { %>
                <button type="button" class="diary-tag diary-tag-month-sub diary-month-tag-btn" data-tag="<%= tag.name %>">
                  <span><%= tag.name %></span>
                  <span class="diary-tag-count">(<%= tag.count %>)</span>
                  <span class="diary-tag-remove" role="button" tabindex="0" aria-label="除外ワードに追加" data-tag="<%= tag.name %>">×</span>
                </button>
              <% } %>
            <% }) %>
          </div>
        </div>
        <div class="mt-3 p-3 rounded border diary-keyword-link-box">
          <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
            <div class="fw-bold">My Diaryランキング</div>
            <a href="/allaboutme/diary-keywords" class="btn btn-sm btn-outline-primary">年間ランキング/マッピング</a>
          </div>
        </div>
        <div class="mt-3 p-3 rounded border diary-keyword-link-box">
          <div class="fw-bold mb-2">My Diary書出し</div>
          <a href="/allaboutme/export-diary" class="btn btn-sm btn-outline-primary">書出しページへ</a>
        </div>
        <div class="mt-3 p-3 rounded border diary-keyword-link-box">
          <div class="fw-bold mb-2">My Diary設定</div>
          <div class="d-flex flex-wrap gap-2">
            <a href="/allaboutme/diary-settings?tab=exclude" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-gear me-1"></i>タグ化しない除外ワード設定</a>
            <a href="/allaboutme/diary-settings?tab=event" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-gear me-1"></i>イベント項目の登録/編集</a>
          </div>
        </div>
      <% } %>
    </div>

    <div class="diary-list-card">
      <div class="diary-selected-date" id="diarySelectedDate" data-date="<%= selectedDate %>"></div>

      <div class="diary-section">
        <div class="diary-section-title">Finance</div>
        <% if (!financeGroups || financeGroups.length === 0) { %>
          <div class="diary-empty">この日のFinanceデータはありません。</div>
        <% } else { %>
          <% financeGroups.forEach(group => { %>
            <% if (group.entries && group.entries.length > 0) { %>
              <div class="diary-group">
                <div class="diary-group-title">
                  <span class="diary-tag diary-tag-group"><%= group.groupName %></span>
                </div>
                <% group.entries.forEach(entry => { %>
                  <div class="diary-entry">
                    <div class="diary-tags">
                      <% const cfClass = entry.cf === '収入'
                        ? 'is-income'
                        : entry.cf === '貯蓄'
                          ? 'is-saving'
                          : entry.cf === '控除'
                            ? 'is-deduction'
                            : entry.cf === '支出'
                              ? 'is-expense'
                              : ''; %>
                      <span class="diary-tag diary-tag-cf <%= cfClass %>"><%= entry.cf %></span>
                      <% if (entry.category) { %>
                        <span class="diary-tag diary-tag-category"><%= entry.category %></span>
                      <% } %>
                    </div>
                    <div class="diary-entry-body">
                      <div class="diary-entry-content"><%= entry.content || '（内容なし）' %></div>
                      <div class="diary-entry-meta">金額: <%= entry.amountFormatted %> / 支払い種別: <%= entry.payment_type || '未設定' %></div>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>
          <% }) %>
        <% } %>
      </div>

      <div class="diary-section">
        <div class="diary-section-title">My Meal</div>
        <% if (!mealGroups || mealGroups.length === 0) { %>
          <div class="diary-empty">この日のMy Mealはありません。</div>
        <% } else { %>
          <% const mealOrder = [
            { key: 'breakfast', label: '朝食' },
            { key: 'lunch', label: '昼食' },
            { key: 'dinner', label: '夕食' }
          ]; %>

          <% mealGroups.forEach(mealGroup => { %>
            <% const meals = mealGroup.meals || {}; %>
            <div class="diary-group">
              <div class="diary-group-title">
                <span class="diary-tag diary-tag-group"><%= mealGroup.groupName %></span>
              </div>
              <% mealOrder.forEach(group => { %>
                <% const items = meals[group.key] || []; %>
                <div class="diary-meal-group">
                  <div class="diary-meal-group-title"><%= group.label %></div>
                  <% if (!items || items.length === 0) { %>
                    <div class="diary-empty">この日の<%= group.label %>はありません。</div>
                  <% } else { %>
                    <div class="diary-meal-grid">
                      <% items.forEach(entry => { %>
                        <div class="diary-entry diary-meal-card">
                          <div class="diary-meal-top-tags">
                            <% if (entry.junle) { %>
                              <span class="diary-tag diary-tag-genre"><%= entry.junle %></span>
                            <% } %>
                            <% if (entry.kind) { %>
                              <span class="diary-tag diary-tag-kind"><%= entry.kind %></span>
                            <% } %>
                          </div>
                          <div class="diary-meal-row">
                            <% if (entry.menuType === 'set') { %>
                              <% if (entry.setImages && entry.setImages.length > 0) { %>
                                <div class="diary-meal-set-grid">
                                  <% entry.setImages.forEach(img => { %>
                                    <img class="diary-meal-thumb diary-meal-thumb-set" src="<%= img.url %>" alt="<%= img.name %>">
                                  <% }) %>
                                </div>
                              <% } else { %>
                                <div class="diary-meal-thumb diary-meal-thumb-empty diary-meal-thumb-set">画像なし</div>
                              <% } %>
                            <% } else { %>
                              <% if (entry.imageUrl) { %>
                                <img class="diary-meal-thumb" src="<%= entry.imageUrl %>" alt="<%= entry.name %>">
                              <% } else { %>
                                <div class="diary-meal-thumb diary-meal-thumb-empty">画像なし</div>
                              <% } %>
                            <% } %>
                            <div class="diary-meal-name"><%= entry.name || '（メニュー名なし）' %></div>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                  <% } %>
                  <% if (group.key === 'dinner') { %>
                    <div class="diary-meal-comment" data-group-id="<%= mealGroup.groupId %>" data-date="<%= selectedDate %>" data-comment="<%= mealGroup.dinnerComment || '' %>">
                      <div class="diary-meal-comment-header">
                        <div class="diary-meal-comment-title">この日の食事コメント</div>
                        <button type="button" class="btn btn-sm btn-outline-secondary diary-meal-comment-edit" data-bs-toggle="modal" data-bs-target="#mealCommentModal">編集</button>
                      </div>
                      <div class="diary-meal-comment-body <%= mealGroup.dinnerComment ? '' : 'is-empty' %>"><%= mealGroup.dinnerComment || '（コメントなし）' %></div>
                    </div>
                  <% } %>
                </div>
              <% }) %>
            </div>
          <% }) %>
        <% } %>
      </div>

      <div class="diary-section">
      <div class="diary-section-title">My Diary</div>
      <% if (diaryTagSummary && diaryTagSummary.length > 0) { %>
        <div class="diary-tags" style="margin-bottom: 10px;">
          <% diaryTagSummary.forEach(tag => { %>
            <span class="diary-tag diary-tag-category"><%= tag.name %> <span class="text-muted small">(<%= tag.score %>)</span></span>
          <% }) %>
        </div>
      <% } %>
      <% if (!diaryGroups || diaryGroups.length === 0) { %>
        <div class="diary-empty">この日のMy Diaryはありません。</div>
        <% } else { %>
          <% diaryGroups.forEach(group => { %>
            <% if (group.entries && group.entries.length > 0) { %>
              <div class="diary-group">
                <div class="diary-group-title">
                  <span class="diary-tag diary-tag-group"><%= group.groupName %></span>
                </div>
                <% group.entries.forEach(entry => { %>
                  <div class="diary-entry">
                    <% const rawContent = entry.content || '（内容なし）'; %>
                    <% const displayContent = rawContent.replace(/^\s+/, '').replace(/\r/g, ''); %>
                    <div class="diary-line-first">
                      <div class="diary-tags">
                        <span class="diary-tag diary-tag-event"><%= entry.event %></span>
                      </div>
                      <div class="diary-rate">
                        <% for (let i = 0; i < 5; i++) { %>
                          <span class="diary-star <%= i < entry.rate ? 'is-filled' : '' %>">&#9733;</span>
                        <% } %>
                      </div>
                    </div>
                    <div class="diary-entry-body">
                      <div class="diary-entry-title"><%= entry.title || '（タイトルなし）' %></div>
                      <div class="diary-entry-content diary-content-preview diary-content-text" role="button" tabindex="0" data-full="<%- displayContent.replace(/"/g, '&quot;') %>"><%= displayContent %></div>
                      <div class="diary-entry-actions">
                        <button type="button" class="btn btn-sm btn-outline-secondary diary-edit-btn" data-id="<%= entry.id %>">編集</button>
                        <form method="POST" action="/allaboutme/eventcal/delete/<%= entry.id %>" class="d-inline" onsubmit="return confirm('削除しますか？');">
                          <input type="hidden" name="redirectTo" value="/allaboutme/eventcal2?date=<%= selectedDate %>">
                          <button type="submit" class="btn btn-sm btn-outline-danger">削除</button>
                        </form>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>
</div>

<button type="button" class="diary-fab" id="diaryFab" aria-label="My日記を追加">+</button>

<div class="modal fade diary-modal" id="diaryEntryModal" tabindex="-1" aria-labelledby="diaryEntryModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" enctype="multipart/form-data" action="/allaboutme/eventcal">
        <input type="hidden" name="redirectTo" value="/allaboutme/eventcal2?date=<%= selectedDate %>">
        <div class="modal-header">
          <h5 class="modal-title" id="diaryEntryModalLabel">My日記登録</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" name="existingId" value="">
          <div class="mb-2">
            <label for="diaryDate" class="form-label">年⽉⽇</label>
            <input type="date" class="form-control" id="diaryDate" name="date" value="<%= selectedDate %>" required>
          </div>
          <div class="mb-2 position-relative">
            <label for="diaryItem" class="form-label">項目</label>
            <input class="form-control" id="diaryItem" name="item" list="diaryItemList" placeholder="選択または入力してください" required>
            <datalist id="diaryItemList">
              <%
                const defaultDiaryItems = ['今日の気分・体調・睡眠', '今日のお食事', '生活サイクル', '日記'];
                const itemOptionSet = new Set(defaultDiaryItems);
                (events || []).forEach((ev) => {
                  const itemName = String(ev.item || '').trim();
                  if (itemName) itemOptionSet.add(itemName);
                });
                (diaryEntries || []).forEach((entry) => {
                  const itemName = String(entry.item || '').trim();
                  if (itemName) itemOptionSet.add(itemName);
                });
                const itemOptions = Array.from(itemOptionSet);
              %>
              <% itemOptions.forEach((itemName) => { %>
                <option value="<%= itemName %>"><%= itemName %></option>
              <% }) %>
            </datalist>
          </div>
          <div class="mb-2 position-relative">
            <label for="diaryEvent" class="form-label">日記</label>
            <input class="form-control" id="diaryEvent" name="event" list="diaryEventList" placeholder="選択または入力してください" required>
            <datalist id="diaryEventList"></datalist>
          </div>
          <div class="mb-2">
            <label class="form-label">満足度<i class="fa-regular fa-face-smile"></i>（選択してください）</label>
            <select class="form-select" name="rate" required>
              <% const rateOptions = ['最悪', '悪い', '普通', '良い', '最高']; %>
              <% for (let i = 5; i >= 1; i--) { %>
                <option value="<%= i %>" <%= i === 3 ? 'selected' : '' %>><%= rateOptions[i - 1] %></option>
              <% } %>
            </select>
          </div>
          <div class="mb-2">
            <label for="diaryTitle" class="form-label">タイトル</label>
            <textarea class="form-control" id="diaryTitle" name="title" rows="1"></textarea>
          </div>
          <div class="mb-2">
            <label for="diaryContent" class="form-label">内容</label>
            <textarea class="form-control" id="diaryContent" name="content" rows="5"></textarea>
          </div>
          <div class="mb-2">
            <label for="diarySummary" class="form-label d-flex align-items-center gap-2">
              <span>サマリー</span>
              <button type="button" id="diarySummarizeBtn" class="btn btn-sm btn-outline-success">AIで要約</button>
            </label>
            <textarea class="form-control" id="diarySummary" name="summary" rows="3"></textarea>
          </div>
          <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" name="share" id="diaryShare" checked>
            <label class="form-check-label" for="diaryShare">共有する</label>
          </div>
          <div class="mb-3">
            <label for="diaryPhotos" class="form-label">写真を追加</label>
            <input type="file" class="form-control" name="photos" id="diaryPhotos" multiple accept="image/*">
          </div>
          <div class="mb-3">
            <label class="form-label">Googleフォトから選択</label><br>
            <button type="button" class="btn btn-outline-primary btn-sm" onclick="openGooglePhotoPopup()">Googleフォトから選択</button>
          </div>
          <div id="googlePhotoPreview" class="d-flex flex-wrap mt-2"></div>
        </div>
        <div class="modal-footer d-flex gap-2">
          <button type="submit" name="saveAction" value="draft" class="btn btn-outline-success" style="width: 40%;">一時保存</button>
          <button type="submit" name="saveAction" value="publish" class="btn btn-outline-primary" style="width: 40%;">登録</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade diary-modal" id="diaryContentModal" tabindex="-1" aria-labelledby="diaryContentModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="diaryContentModalLabel">My Diary 内容</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
      </div>
      <div class="modal-body" id="diaryContentModalBody" style="white-space: pre-wrap;"></div>
    </div>
  </div>
</div>

<div class="modal fade diary-modal" id="diaryTagModal" tabindex="-1" aria-labelledby="diaryTagModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="diaryTagModalLabel">タグ検索</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
      </div>
      <div class="modal-body" id="diaryTagModalBody"></div>
    </div>
  </div>
</div>

<div class="modal fade diary-modal" id="mealCommentModal" tabindex="-1" aria-labelledby="mealCommentModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="mealCommentModalLabel">この日の食事コメント</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
      </div>
      <div class="modal-body">
        <textarea class="form-control" id="mealCommentInput" rows="6" placeholder="コメントを入力"></textarea>
      </div>
      <div class="modal-footer d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">キャンセル</button>
        <button type="button" class="btn btn-primary" id="mealCommentSaveBtn">保存</button>
      </div>
    </div>
  </div>
</div>

<script>
  (() => {
    const selectedDateEl = document.getElementById('diarySelectedDate');
    const selectedDateStr = selectedDateEl?.dataset?.date;
    const selectedDate = selectedDateStr ? new Date(`${selectedDateStr}T00:00:00`) : new Date();
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    const monthLabel = document.getElementById('diaryMonthLabel');
    const grid = document.getElementById('diaryGrid');
    const weekdayLabels = ['月', '火', '水', '木', '金', '土', '日'];

    let currentMonth = new Date(selectedDate.getFullYear(), selectedDate.getMonth(), 1);

    const pad = (num) => String(num).padStart(2, '0');
    const toYmd = (date) => `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;

    const isSameDay = (a, b) => (
      a.getFullYear() === b.getFullYear() &&
      a.getMonth() === b.getMonth() &&
      a.getDate() === b.getDate()
    );

    const renderSelectedDate = () => {
      if (!selectedDateEl) return;
      const formatter = new Intl.DateTimeFormat('ja-JP', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        weekday: 'short'
      });
      selectedDateEl.textContent = formatter.format(selectedDate);
    };

    const renderCalendar = () => {
      if (!grid || !monthLabel) return;
      grid.innerHTML = '';

      const year = currentMonth.getFullYear();
      const month = currentMonth.getMonth();
      const firstDay = new Date(year, month, 1);
      const lastDay = new Date(year, month + 1, 0);
      const daysInMonth = lastDay.getDate();
      const startOffset = (firstDay.getDay() + 6) % 7; // Monday start

      const monthFormatter = new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: 'long' });
      monthLabel.textContent = monthFormatter.format(currentMonth);

      for (let i = 0; i < startOffset; i++) {
        const emptyCell = document.createElement('div');
        emptyCell.className = 'diary-empty-cell';
        grid.appendChild(emptyCell);
      }

      for (let day = 1; day <= daysInMonth; day++) {
        const cellDate = new Date(year, month, day);
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'diary-day';
        button.textContent = day;

        if (isSameDay(cellDate, today)) {
          button.classList.add('is-today');
        }
        if (isSameDay(cellDate, selectedDate)) {
          button.classList.add('is-selected');
        }

        button.addEventListener('click', () => {
          window.location.href = `/allaboutme/eventcal2?date=${toYmd(cellDate)}`;
        });

        grid.appendChild(button);
      }
    };

    document.querySelectorAll('.diary-nav-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const delta = Number(btn.dataset.nav || 0);
        currentMonth = new Date(currentMonth.getFullYear(), currentMonth.getMonth() + delta, 1);
        renderCalendar();
      });
    });

    renderSelectedDate();
    renderCalendar();
  })();
</script>

<script>
  (() => {
    const fab = document.getElementById('diaryFab');
    if (!fab) return;

    fab.addEventListener('click', () => {
      const modalEl = document.getElementById('diaryEntryModal');
      if (!modalEl) return;
      if (window.bootstrap && window.bootstrap.Modal) {
        const form = modalEl.querySelector('form');
        const modalTitle = document.getElementById('diaryEntryModalLabel');
        if (form) {
          form.action = '/allaboutme/eventcal';
          const dateInput = document.getElementById('diaryDate');
          if (dateInput) dateInput.value = '<%= selectedDate %>';
          const itemInput = document.getElementById('diaryItem');
          if (itemInput) itemInput.value = '';
          if (itemInput) itemInput.dispatchEvent(new Event('input'));
          const eventInput = document.getElementById('diaryEvent');
          if (eventInput) eventInput.value = '';
          const rateSelect = form.querySelector('select[name=\"rate\"]');
          if (rateSelect) rateSelect.value = '3';
          const titleInput = document.getElementById('diaryTitle');
          if (titleInput) titleInput.value = '';
          const contentInput = document.getElementById('diaryContent');
          if (contentInput) contentInput.value = '';
          const summaryInput = document.getElementById('diarySummary');
          if (summaryInput) summaryInput.value = '';
          const shareCheckbox = document.getElementById('diaryShare');
          if (shareCheckbox) shareCheckbox.checked = true;
          const photoPreview = document.getElementById('googlePhotoPreview');
          if (photoPreview) photoPreview.innerHTML = '';
        }
        if (modalTitle) modalTitle.textContent = 'My日記登録';
        const modal = window.bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();
      }
    });

    const storageKey = 'diaryFabPosition';
    const saved = localStorage.getItem(storageKey);
    if (saved) {
      try {
        const { left, top } = JSON.parse(saved);
        if (typeof left === 'number' && typeof top === 'number') {
          const maxLeft = window.innerWidth - 56;
          const maxTop = window.innerHeight - 56;
          const clampedLeft = Math.max(8, Math.min(maxLeft, left));
          const clampedTop = Math.max(8, Math.min(maxTop, top));
          fab.style.left = `${clampedLeft}px`;
          fab.style.top = `${clampedTop}px`;
          fab.style.right = 'auto';
          fab.style.bottom = 'auto';
        }
      } catch (_) {}
    }

    let dragging = false;
    let offsetX = 0;
    let offsetY = 0;

    const onMove = (event) => {
      if (!dragging) return;
      const clientX = event.touches ? event.touches[0].clientX : event.clientX;
      const clientY = event.touches ? event.touches[0].clientY : event.clientY;
      const nextLeft = Math.max(8, Math.min(window.innerWidth - 56, clientX - offsetX));
      const nextTop = Math.max(8, Math.min(window.innerHeight - 56, clientY - offsetY));
      fab.style.left = `${nextLeft}px`;
      fab.style.top = `${nextTop}px`;
      fab.style.right = 'auto';
      fab.style.bottom = 'auto';
    };

    const onEnd = () => {
      if (!dragging) return;
      dragging = false;
      const rect = fab.getBoundingClientRect();
      localStorage.setItem(storageKey, JSON.stringify({ left: rect.left, top: rect.top }));
      document.removeEventListener('mousemove', onMove);
      document.removeEventListener('mouseup', onEnd);
      document.removeEventListener('touchmove', onMove);
      document.removeEventListener('touchend', onEnd);
    };

    fab.addEventListener('mousedown', (event) => {
      dragging = true;
      offsetX = event.clientX - fab.getBoundingClientRect().left;
      offsetY = event.clientY - fab.getBoundingClientRect().top;
      document.addEventListener('mousemove', onMove);
      document.addEventListener('mouseup', onEnd);
    });

    fab.addEventListener('touchstart', (event) => {
      dragging = true;
      const touch = event.touches[0];
      offsetX = touch.clientX - fab.getBoundingClientRect().left;
      offsetY = touch.clientY - fab.getBoundingClientRect().top;
      document.addEventListener('touchmove', onMove, { passive: false });
      document.addEventListener('touchend', onEnd);
    });
  })();

  (() => {
    const itemInput = document.getElementById('diaryItem');
    const eventInput = document.getElementById('diaryEvent');
    const eventList = document.getElementById('diaryEventList');
    if (!itemInput || !eventInput || !eventList) return;

    const supportsDatalist = (() => {
      const testInput = document.createElement('input');
      return Boolean(window.HTMLDataListElement) && ('list' in testInput);
    })();
    const ua = navigator.userAgent || '';
    const isSafariLike = /safari/i.test(ua) && !/chrome|chromium|crios|fxios|edgios|opr\//i.test(ua);
    const useCustomSuggestions = !supportsDatalist || isSafariLike;

    const events = <%- JSON.stringify((events || []).map(ev => ({ item: ev.item, event: ev.event }))) %>;
    window.diaryEntriesData = <%- JSON.stringify(diaryEntries || []) %>;
    window.monthlyDiaryEntriesData = <%- JSON.stringify(monthlyDiaryEntries || []) %>;
    const defaultDiaryItems = ['今日の気分・体調・睡眠', '今日のお食事', '生活サイクル', '日記'];
    const itemSeeds = Array.from(new Set(
      defaultDiaryItems
        .concat(events.map(ev => String(ev?.item || '').trim()))
        .concat((window.diaryEntriesData || []).map(entry => String(entry?.item || '').trim()))
    )).filter(Boolean);
    const entryEventSeeds = (window.diaryEntriesData || []).map((entry) => ({
      item: String(entry?.item || '').trim(),
      event: String(entry?.event || '').trim()
    }));
    const eventSeeds = events
      .map((ev) => ({
        item: String(ev?.item || '').trim(),
        event: String(ev?.event || '').trim()
      }))
      .concat(entryEventSeeds)
      .filter((ev) => ev.event);

    const getEventCandidateNames = (itemValue, selectedEvent = '') => {
      const normalizedItem = String(itemValue || '').trim();
      const normalizedLower = normalizedItem.toLowerCase();
      let filtered = normalizedItem
        ? eventSeeds.filter((ev) => String(ev.item || '').toLowerCase().includes(normalizedLower))
        : eventSeeds;
      if (filtered.length === 0) filtered = eventSeeds;
      const seen = new Set();
      filtered.forEach((ev) => {
        const eventName = String(ev.event || '').trim();
        if (!eventName || seen.has(eventName)) return;
        seen.add(eventName);
      });
      if (selectedEvent && !seen.has(selectedEvent)) {
        seen.add(selectedEvent);
      }
      return Array.from(seen);
    };

    const renderEventOptions = (itemValue, selectedEvent = '') => {
      const names = getEventCandidateNames(itemValue, selectedEvent);
      eventList.innerHTML = '';
      names.forEach((name) => {
        const option = document.createElement('option');
        option.value = name;
        option.label = name;
        option.textContent = name;
        eventList.appendChild(option);
      });
      return names;
    };

    const createSuggestionBox = (inputEl) => {
      const box = document.createElement('div');
      box.className = 'list-group position-absolute w-100 d-none';
      box.style.zIndex = '1065';
      box.style.maxHeight = '180px';
      box.style.overflowY = 'auto';
      box.style.top = '100%';
      box.style.left = '0';
      box.style.marginTop = '4px';
      inputEl.parentElement.appendChild(box);
      return box;
    };

    const hideSuggestionBox = (box) => {
      if (!box) return;
      box.classList.add('d-none');
      box.innerHTML = '';
    };

    const renderSuggestionBox = (box, names, onPick) => {
      if (!box) return;
      box.innerHTML = '';
      const list = names.slice(0, 30);
      if (list.length === 0) {
        hideSuggestionBox(box);
        return;
      }
      list.forEach((name) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'list-group-item list-group-item-action py-2';
        btn.textContent = name;
        btn.addEventListener('click', (event) => {
          event.preventDefault();
          onPick(name);
        });
        box.appendChild(btn);
      });
      box.classList.remove('d-none');
    };

    renderEventOptions(itemInput.value);

    if (useCustomSuggestions) {
      itemInput.removeAttribute('list');
      eventInput.removeAttribute('list');
      const itemSuggestBox = createSuggestionBox(itemInput);
      const eventSuggestBox = createSuggestionBox(eventInput);

      const showItemSuggestions = () => {
        const query = String(itemInput.value || '').trim().toLowerCase();
        const names = itemSeeds.filter((name) => !query || name.toLowerCase().includes(query));
        renderSuggestionBox(itemSuggestBox, names, (picked) => {
          itemInput.value = picked;
          eventInput.value = '';
          renderEventOptions(itemInput.value);
          hideSuggestionBox(itemSuggestBox);
        });
      };

      const showEventSuggestions = () => {
        const query = String(eventInput.value || '').trim().toLowerCase();
        const names = getEventCandidateNames(itemInput.value, eventInput.value)
          .filter((name) => !query || name.toLowerCase().includes(query));
        renderSuggestionBox(eventSuggestBox, names, (picked) => {
          eventInput.value = picked;
          hideSuggestionBox(eventSuggestBox);
        });
      };

      itemInput.addEventListener('focus', showItemSuggestions);
      itemInput.addEventListener('input', () => {
        showItemSuggestions();
        renderEventOptions(itemInput.value);
        eventInput.value = '';
      });
      itemInput.addEventListener('change', () => {
        renderEventOptions(itemInput.value);
        eventInput.value = '';
      });
      itemInput.addEventListener('blur', () => {
        setTimeout(() => hideSuggestionBox(itemSuggestBox), 120);
      });

      eventInput.addEventListener('focus', showEventSuggestions);
      eventInput.addEventListener('input', showEventSuggestions);
      eventInput.addEventListener('blur', () => {
        setTimeout(() => hideSuggestionBox(eventSuggestBox), 120);
      });
    } else {
      itemInput.addEventListener('input', () => {
        renderEventOptions(itemInput.value);
        eventInput.value = '';
      });
      itemInput.addEventListener('change', () => {
        renderEventOptions(itemInput.value);
        eventInput.value = '';
      });
      eventInput.addEventListener('focus', () => {
        renderEventOptions(itemInput.value, eventInput.value);
      });
    }

    const form = document.querySelector('#diaryEntryModal form');
    const modalTitle = document.getElementById('diaryEntryModalLabel');
    const dateInput = document.getElementById('diaryDate');
    const rateSelect = form?.querySelector('select[name=\"rate\"]');
    const titleInput = document.getElementById('diaryTitle');
    const contentInput = document.getElementById('diaryContent');
    const summaryInput = document.getElementById('diarySummary');
    const shareCheckbox = document.getElementById('diaryShare');
    const photoPreview = document.getElementById('googlePhotoPreview');

    const fillFormForEdit = (entry) => {
      if (!form || !entry) return;
      form.action = `/allaboutme/eventcal/edit/${entry.id}`;
      if (modalTitle) modalTitle.textContent = 'My日記編集';
      if (dateInput) dateInput.value = entry.date || '<%= selectedDate %>';
      if (itemInput) itemInput.value = entry.item || '';
      renderEventOptions(itemInput ? itemInput.value : '', entry.event || '');
      if (eventInput) eventInput.value = entry.event || '';
      if (rateSelect) rateSelect.value = String(entry.rate || 3);
      if (titleInput) titleInput.value = entry.title || '';
      if (contentInput) contentInput.value = entry.content || '';
      if (summaryInput) summaryInput.value = entry.summary || '';
      if (shareCheckbox) shareCheckbox.checked = Boolean(entry.share);
      if (photoPreview) photoPreview.innerHTML = '';
    };

    document.querySelectorAll('.diary-edit-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const entryId = btn.dataset.id;
        const entry = (window.diaryEntriesData || []).find(e => e.id === entryId);
        fillFormForEdit(entry);
        const modalEl = document.getElementById('diaryEntryModal');
        if (modalEl && window.bootstrap && window.bootstrap.Modal) {
          const modal = window.bootstrap.Modal.getOrCreateInstance(modalEl);
          modal.show();
        }
      });
    });
  })();

  (() => {
    const containers = document.querySelectorAll('.diary-meal-comment');
    if (!containers.length) return;

    const modalEl = document.getElementById('mealCommentModal');
    const inputEl = document.getElementById('mealCommentInput');
    const saveBtn = document.getElementById('mealCommentSaveBtn');
    let activeContainer = null;

    const setView = (container, comment) => {
      const body = container.querySelector('.diary-meal-comment-body');
      if (!body) return;
      const trimmed = (comment || '').trim();
      body.textContent = trimmed || '（コメントなし）';
      body.classList.toggle('is-empty', !trimmed);
      container.dataset.comment = comment || '';
    };

    containers.forEach((container) => {
      const editBtn = container.querySelector('.diary-meal-comment-edit');
      setView(container, container.dataset.comment || '');

      if (editBtn) {
        editBtn.addEventListener('click', () => {
          activeContainer = container;
          if (inputEl) inputEl.value = container.dataset.comment || '';
        });
      }
    });

    if (saveBtn) {
      saveBtn.addEventListener('click', async () => {
        if (!activeContainer || !inputEl) return;
        const groupId = activeContainer.dataset.groupId;
        const date = activeContainer.dataset.date;
        if (!groupId || !date) return;
        const payload = {
          groupId,
          date,
          comment: inputEl.value
        };
        saveBtn.disabled = true;
        try {
          const resp = await fetch('/allaboutme/eventcal2/meal-comment', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          if (!resp.ok) {
            const msg = await resp.text().catch(() => '');
            throw new Error(msg || 'コメントの更新に失敗しました');
          }
          const data = await resp.json();
          setView(activeContainer, data?.comment || '');
          if (modalEl && window.bootstrap?.Modal) {
            const modal = window.bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.hide();
          }
        } catch (err) {
          console.error(err);
          alert('コメントの更新に失敗しました');
        } finally {
          saveBtn.disabled = false;
        }
      });
    }

    if (modalEl) {
      modalEl.addEventListener('hidden.bs.modal', () => {
        activeContainer = null;
        if (inputEl) inputEl.value = '';
      });
    }
  })();

  (() => {
    const contentModalEl = document.getElementById('diaryContentModal');
    const modalBody = document.getElementById('diaryContentModalBody');
    if (!contentModalEl || !modalBody) return;

    const openDiaryContent = (target) => {
      if (!(target instanceof HTMLElement)) return;
      const btn = target.closest('.diary-content-preview');
      if (!btn) return;
      if (!window.bootstrap || !window.bootstrap.Modal) return;
      modalBody.textContent = btn.dataset.full || '';
      const modal = window.bootstrap.Modal.getOrCreateInstance(contentModalEl);
      modal.show();
    };

    document.addEventListener('click', (event) => {
      openDiaryContent(event.target);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      openDiaryContent(event.target);
    });
  })();

  (() => {
    const tagModalEl = document.getElementById('diaryTagModal');
    const tagModalBody = document.getElementById('diaryTagModalBody');
    if (!tagModalEl || !tagModalBody) return;

    const escapeHtml = (text) => {
      if (!text) return '';
      return String(text)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    };

    const highlightTag = (text, tag) => {
      if (!text || !tag) return escapeHtml(text);
      const escapedTag = tag.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      const regex = new RegExp(escapedTag, 'gi');
      let result = '';
      let lastIndex = 0;
      const raw = String(text);
      for (const match of raw.matchAll(regex)) {
        const start = match.index ?? 0;
        const end = start + match[0].length;
        result += escapeHtml(raw.slice(lastIndex, start));
        result += `<mark class="diary-tag-highlight">${escapeHtml(match[0])}</mark>`;
        lastIndex = end;
      }
      result += escapeHtml(raw.slice(lastIndex));
      return result;
    };

    document.querySelectorAll('.diary-month-tag-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.dataset.ignore === 'true') return;
        const tag = btn.getAttribute('data-tag');
        const matches = (window.monthlyDiaryEntriesData || []).filter(e => (e.tags || []).includes(tag));
        const tagModalTitle = document.getElementById('diaryTagModalLabel');
        if (tagModalTitle) {
          tagModalTitle.innerHTML = tag
            ? `キーワード: <span class="diary-tag diary-tag-keyword">${escapeHtml(tag)}</span>`
            : 'キーワード検索';
        }
        const bodyHtml = matches.length === 0
          ? '<div class="text-muted">該当する日記はありません。</div>'
          : matches.map(entry => {
              const date = entry.date ? `<div class="diary-tag-modal-date">${escapeHtml(entry.date)}</div>` : '';
              const itemTag = entry.item ? `<span class="diary-tag diary-tag-item">${escapeHtml(entry.item)}</span>` : '';
              const eventTag = entry.event ? `<span class="diary-tag diary-tag-event">${escapeHtml(entry.event)}</span>` : '';
              const headerTags = (itemTag || eventTag) ? `<div class="diary-tag-modal-tags">${itemTag}${eventTag}</div>` : '';
              const title = entry.title ? `<div class="diary-tag-modal-title">${highlightTag(entry.title, tag)}</div>` : '';
              const summary = entry.summary ? `<div class="diary-tag-modal-summary">${highlightTag(entry.summary, tag)}</div>` : '';
              const content = entry.content ? `<div class="diary-tag-modal-content">${highlightTag(entry.content, tag)}</div>` : '';
              return `<div class="diary-tag-modal-entry">${date}${headerTags}${title}${summary}${content}</div>`;
            }).join('');
        tagModalBody.innerHTML = bodyHtml;
        if (window.bootstrap && window.bootstrap.Modal) {
          const tagModal = window.bootstrap.Modal.getOrCreateInstance(tagModalEl);
          tagModal.show();
        }
      });
    });
  })();

  (() => {
    const addExcludeWord = async (tag) => {
      if (!tag) return;
      try {
        const resp = await fetch('/allaboutme/eventcal_events/settings/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ excludeWord: tag })
        });
        if (resp.ok) {
          location.href = '/allaboutme/diary-settings?tab=exclude';
        } else {
          const msg = await resp.text().catch(() => '');
          alert(msg || '除外ワードの追加に失敗しました');
        }
      } catch (err) {
        console.error(err);
        alert('除外ワードの追加に失敗しました');
      }
    };

    document.querySelectorAll('.diary-tag-remove').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const tag = btn.getAttribute('data-tag');
        addExcludeWord(tag);
      });
      btn.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        e.preventDefault();
        e.stopPropagation();
        const tag = btn.getAttribute('data-tag');
        addExcludeWord(tag);
      });
    });
  })();

  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('#diarySummarizeBtn');
    if (!btn) return;
    const contentEl = document.getElementById('diaryContent');
    const summaryEl = document.getElementById('diarySummary');
    if (!contentEl || !summaryEl) return;

    const text = (contentEl.value || '').trim();
    if (!text) {
      alert('内容にテキストを入力してください。');
      return;
    }

    const original = btn.textContent;
    btn.disabled = true;
    btn.textContent = '要約中...';

    try {
      const resp = await fetch('/allaboutme/eventcal/summarize', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content: text, maxChars: 180, lang: 'ja' })
      });
      if (!resp.ok) {
        const msg = await resp.text().catch(()=>'');
        throw new Error(msg || '要約に失敗しました');
      }
      const data = await resp.json();
      if (data && data.summary) {
        summaryEl.value = data.summary;
      } else {
        alert('要約結果を取得できませんでした。');
      }
    } catch (err) {
      console.error(err);
      alert('要約に失敗しました');
    } finally {
      btn.disabled = false;
      btn.textContent = original;
    }
  });

  function openGooglePhotoPopup() {
    const isLinked = <%= currentUser.googleTokens ? 'true' : 'false' %>;
    const targetUrl = isLinked ? '/googlePhotos/select' : '/googlePhotos/auth';

    const width = 800;
    const height = 600;
    const left = (window.innerWidth - width) / 2 + window.screenX;
    const top = (window.innerHeight - height) / 2 + window.screenY;

    const popup = window.open(
      targetUrl,
      'GooglePhotosSelect',
      `width=${width},height=${height},left=${left},top=${top},resizable=yes,scrollbars=yes`
    );

    if (!popup || popup.closed || typeof popup.closed === 'undefined') {
      alert('ポップアップがブロックされました。ブラウザの設定を確認してください。');
      return;
    }

    popup.focus();
  }

  window.addEventListener('message', function(event) {
    if (event.origin !== location.origin) return;
    if (event.data.selectedPhotos) {
      const container = document.getElementById('googlePhotoPreview');
      if (!container) return;

      container.innerHTML = '';
      event.data.selectedPhotos.forEach(url => {
        const div = document.createElement('div');
        div.classList.add('me-2', 'mb-2');

        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'selectedGooglePhotos';
        input.value = url;
        div.appendChild(input);

        const img = document.createElement('img');
        img.src = url + (url.startsWith('http') ? '=w100-h100' : '');
        img.classList.add('img-fluid', 'border');
        div.appendChild(img);

        container.appendChild(div);
      });

      const modalEl = document.getElementById('diaryEntryModal');
      if (modalEl && window.bootstrap && window.bootstrap.Modal) {
        const modal = window.bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();
      }
    }
  }, false);
</script>
