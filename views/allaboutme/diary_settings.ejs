<% layout('layouts/boilerplate') -%>
<% page = 'diary_settings' %>
<div class="nav-guide-row d-flex justify-content-between align-items-center gap-2 flex-wrap">
  <%- include('../partials/allaboutme_tabs_nav') %>
  <a href="https://colts-wish-krs.craft.me/UJ4Y7muYdOwQlH/b/11A0D3D1-F656-42AF-8E71-FF1F0449A773/My%E6%97%A5%E8%A8%98%E3%80%80-%E3%80%80My%E6%97%A5%E8%A8%98%E8%A8%AD%E5%AE%9A"
     target="_blank" rel="noopener"
     class="badge bg-success text-white text-decoration-none p-2">
    ガイド
  </a>
</div>
<div class="container">
  <div class="d-flex flex-wrap gap-2 mb-3 mt-2">
    <a href="/allaboutme/eventcal2" class="btn btn-sm btn-outline-secondary">My Diaryトップ</a>
    <a href="/allaboutme/diary-keywords" class="btn btn-sm btn-outline-secondary">キーワードランキング/マッピング</a>
    <a href="/allaboutme/export-diary" class="btn btn-sm btn-outline-secondary">My Diary書出し</a>
    <a href="/allaboutme/diary-settings" class="btn btn-sm btn-outline-primary">My Diary設定</a>
  </div>
  <% const activeTab = typeof locals.activeTab !== 'undefined' ? locals.activeTab : 'exclude'; %>
  <ul class="nav nav-tabs diary-settings-tabs mt-3" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link <%= activeTab === 'exclude' ? 'active' : '' %>" id="exclude-tab" data-bs-toggle="tab" data-bs-target="#exclude-tabpane" type="button" role="tab" aria-controls="exclude-tabpane" aria-selected="<%= activeTab === 'exclude' ? 'true' : 'false' %>">
        <i class="fa-solid fa-gear me-1"></i>タグ化しない除外ワード設定
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link <%= activeTab === 'event' ? 'active' : '' %>" id="event-tab" data-bs-toggle="tab" data-bs-target="#event-tabpane" type="button" role="tab" aria-controls="event-tabpane" aria-selected="<%= activeTab === 'event' ? 'true' : 'false' %>">
        <i class="fa-solid fa-gear me-1"></i>イベント項目の登録／編集
      </button>
    </li>
  </ul>

  <div class="tab-content">
    <div class="tab-pane fade <%= activeTab === 'exclude' ? 'show active' : '' %>" id="exclude-tabpane" role="tabpanel" aria-labelledby="exclude-tab">
      <div class="card mb-2 mt-2">
        <div class="card-body text-white p-2 rounded" style="background-color: #44616D;">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="card-title mb-0"><i class="fa-solid fa-gear me-2"></i>タグ化しない除外ワード設定</h5>
          </div>
          <div class="bg-white p-3 rounded shadow-sm">
            <div class="mb-2">
              <a href="/allaboutme/diary-keywords" class="btn btn-sm btn-outline-secondary">今年度ランキングを見る</a>
            </div>
            <form action="/allaboutme/eventcal_events/settings/add" method="POST" class="mb-3">
              <div class="mb-2">
                <label class="form-label text-dark">除外ワード（1ワードずつ登録）</label>
                <div class="d-flex gap-2">
                  <input type="text" class="form-control" name="excludeWord" placeholder="例: 仕事">
                  <button type="submit" class="btn btn-success" style="min-width: 120px;">保存</button>
                </div>
                <div class="form-text text-muted">記号（= - / * + など）は自動的にタグ化されません。</div>
              </div>
            </form>

            <% if (excludeWords && excludeWords.length > 0) { %>
              <div class="d-flex flex-wrap gap-2">
                <% excludeWords.forEach(word => { %>
                  <div class="d-inline-flex align-items-center gap-1 px-2 py-1 rounded" style="background:#f0f2f6; color:#556377;">
                    <span><%= word %></span>
                    <form action="/allaboutme/eventcal_events/settings/delete" method="POST" class="m-0 p-0">
                      <input type="hidden" name="excludeWord" value="<%= word %>">
                      <button type="submit" class="btn btn-sm p-0" style="line-height:1; color:#9aa5b1;">×</button>
                    </form>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="text-muted small">登録済みの除外ワードはありません。</div>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <div class="tab-pane fade <%= activeTab === 'event' ? 'show active' : '' %>" id="event-tabpane" role="tabpanel" aria-labelledby="event-tab">
      <div class="card mb-2 mt-2">
          <div class="card-body text-white p-2 rounded" style="background-color: #44616D;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                  <h5 class="card-title mb-0"><i class="fa-solid fa-gear me-2"></i>イベント項目の登録／編集</h5>
            </div>
          <div class="bg-white p-3 rounded shadow-sm">
            <form id="eventForm" action="<%= editingEvent ? '/allaboutme/eventcal_events/' + editingEvent._id + '/edit' : '/allaboutme/eventcal_events' %>" method="POST" enctype="application/x-www-form-urlencoded">
              <div class="mb-2">
                <label class="form-label text-dark">表示順</label>
                <input type="number" class="form-control" name="display_order" value="<%= editingEvent ? editingEvent.display_order : '' %>" required>
              </div>
              <div class="mb-2">
                <label class="form-label text-dark">項目</label>
                <select class="form-select" name="item" required>
                  <% calevent_items.forEach(i => { %>
                  <option value="<%= i %>" <%= editingEvent && editingEvent.item === i ? 'selected' : '' %>><%= i %></option>
                  <% }) %>
                </select>
              </div>
              <div class="mb-2">
                <label class="form-label text-dark">イベント</label>
                <input type="text" class="form-control" name="event" id="eventInput" value="<%= editingEvent ? editingEvent.event : '' %>" required>
              </div>
              <div class="mb-2">
                <label class="form-label text-dark">タグ化設定</label>
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="excludeFromTags" id="excludeFromTags"
                         <%= editingEvent && editingEvent.excludeFromTags ? 'checked' : '' %>>
                  <label class="form-check-label text-dark" for="excludeFromTags">タグ化から除外する</label>
                </div>
              </div>
              <div class="mb-2">
                <label class="form-label text-dark">登録モーダル</label>
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="showInEntryDropdown" id="showInEntryDropdown"
                         <%= editingEvent ? (editingEvent.showInEntryDropdown !== false ? 'checked' : '') : 'checked' %>>
                  <label class="form-check-label text-dark" for="showInEntryDropdown">選択プルダウンに表示する</label>
                </div>
              </div>

              <% if (editingEvent) { %>
              <input type="hidden" name="_method" value="PUT">
              <div class="text-center">
                <button type="submit" class="btn btn-success" style="width: 60%;">更新</button>            <a href="/allaboutme/diary-settings" class="btn btn-secondary">キャンセル</a>
              </div>
              <% } else { %>
                <div class="text-center">
                  <button type="submit" class="btn btn-success" style="width: 60%;">登録</button>            </div>
              <% } %>
            </form>
          </div>
        </div>
      </div>
      <div class="mt-4">
        <table class="table table-bordered text-center">
            <thead>
                <tr style="background-color: #44616D; color: white;">
                <th>表示順</th>
                <th>項目</th>
                <th>イベント</th>
                <th>タグ化</th>
                <th>登録モーダル</th>
                <th>編集</th>
                </tr>
            </thead>
            <tbody>
                <% events.forEach(e => { %>
                <tr>
                    <td><%= e.display_order %></td>
                    <td><%= e.item %></td>
                    <td><%= e.event %></td>
                    <td><%= e.excludeFromTags ? '除外' : '対象' %></td>
                    <td><%= e.showInEntryDropdown === false ? '非表示' : '表示' %></td>
                    <td>
                    <form method="GET" action="/allaboutme/diary-settings" style="display:inline;">
                        <input type="hidden" name="edit" value="<%= e._id %>">
                        <input type="hidden" name="tab" value="event">
                        <button class="btn btn-sm"><i class="fas fa-pen"></i></button>
                    </form>
                    <form method="POST" action="/allaboutme/eventcal_events/<%= e._id %>/delete" style="display:inline;" onsubmit="return confirm('削除しますか？')">
                        <button type="submit" class="btn btn-sm text-danger"><i class="fas fa-trash-alt"></i></button>
                    </form>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  (() => {
    const params = new URLSearchParams(window.location.search);
    const forcedEvent = params.get('tab') === 'event' || params.has('edit') || "<%= activeTab %>" === 'event';
    if (!forcedEvent) return;
    const excludeBtn = document.getElementById('exclude-tab');
    const eventBtn = document.getElementById('event-tab');
    const excludePane = document.getElementById('exclude-tabpane');
    const eventPane = document.getElementById('event-tabpane');
    if (excludeBtn && eventBtn && excludePane && eventPane) {
      excludeBtn.classList.remove('active');
      excludeBtn.setAttribute('aria-selected', 'false');
      eventBtn.classList.add('active');
      eventBtn.setAttribute('aria-selected', 'true');
      excludePane.classList.remove('show', 'active');
      eventPane.classList.add('show', 'active');
    }
    const trigger = document.getElementById('event-tab');
    if (!trigger || !window.bootstrap || !window.bootstrap.Tab) return;
    const tab = window.bootstrap.Tab.getOrCreateInstance(trigger);
    tab.show();
  })();
</script>
