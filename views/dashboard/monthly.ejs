<% layout('layouts/boilerplate') %>
<%
  const monthlyReflectionMap = typeof monthlyReflections !== 'undefined' ? monthlyReflections : {};
  const monthlyReflectionAction = typeof reflectionAction !== 'undefined' ? reflectionAction : '';
  const reflectionEnabled = Boolean(monthlyReflectionAction);
%>


  <div class="card mb-3 mt-4">
    <div class="card-body text-white p-2 rounded" style="background-color: #44616D;">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="card-title mb-0"><%= titlePrefix %> 月間サマリー</h5>
        <div class="d-flex align-items-center flex-nowrap gap-2">
          <form method="GET" action="<%= formAction %>" class="d-flex mb-0">
            <div class="d-flex align-items-center flex-nowrap gap-2">
              <input type="month" name="ym" value="<%= year %>-<%= String(month).padStart(2, '0') %>" class="form-control form-control-sm me-2" style="height: 2.2rem; max-width: 120px;">
              <div class="form-check form-switch mb-0 text-nowrap">
                <input type="hidden" name="tagSummary" value="0">
                <input class="form-check-input" type="checkbox" id="tagSummarySwitch" name="tagSummary" value="1" <%= showTagSummary ? 'checked' : '' %>>
                <label class="form-check-label" for="tagSummarySwitch">タグ別</label>
              </div>
              <button type="submit" class="btn btn-primary btn-sm" style="width: 60px;">表示</button>
            </div>
          </form>
          <% if (typeof excelAction !== 'undefined' && excelAction) { %>
            <form method="GET" action="<%= excelAction %>" class="mb-0" onsubmit="this.querySelector('button').disabled = true; this.querySelector('button').textContent = '出力中...'; setTimeout(() => { this.querySelector('button').disabled = false; this.querySelector('button').textContent = 'Excel出力'; }, 3000);">
              <input type="hidden" name="ym" value="<%= year %>-<%= String(month).padStart(2, '0') %>">
              <input type="hidden" name="tagSummary" value="<%= showTagSummary ? '1' : '0' %>">
              <button type="submit" class="btn btn-sm btn-light">Excel出力</button>
            </form>
          <% } %>
        </div>
      </div>
      <%
        const fallbackSummaryRows = [
          { label: '収入', key: 'income', reflectionItem: 'summary:income', canReflect: true, actual: totalIncome, budget: 0, diff: totalIncome, cumulative: 0, cumulativeBudget: 0, cumulativeDiff: 0 },
          { label: '控除', key: 'deduction', reflectionItem: 'summary:deduction', canReflect: true, actual: totalDeduction, budget: 0, diff: -totalDeduction, cumulative: 0, cumulativeBudget: 0, cumulativeDiff: 0 },
          { label: '貯蓄', key: 'saving', reflectionItem: 'summary:saving', canReflect: true, actual: totalSaving, budget: 0, diff: totalSaving, cumulative: 0, cumulativeBudget: 0, cumulativeDiff: 0 },
          { label: '支出', key: 'expense', reflectionItem: 'summary:expense', canReflect: false, actual: totalExpense, budget: 0, diff: -totalExpense, cumulative: 0, cumulativeBudget: 0, cumulativeDiff: 0 },
          { label: '収支（収入 - 控除 - 貯蓄 - 支出）', key: 'balance', reflectionItem: 'summary:balance', canReflect: true, actual: balance, budget: 0, diff: balance, cumulative: 0, cumulativeBudget: 0, cumulativeDiff: 0 }
        ];
        const summaryRows = Array.isArray(monthlySummaryRows) && monthlySummaryRows.length ? monthlySummaryRows : fallbackSummaryRows;
        const formatSummaryAmount = (value) => Number(value || 0).toLocaleString();
        const summaryNumberClass = (value) => Number(value || 0) < 0 ? 'text-danger fw-bold' : '';
      %>
      <div class="table-responsive dashboard-summary-wrap">
        <table class="table table-sm dashboard-summary-table mb-0">
          <thead>
            <tr>
              <th class="dashboard-summary-label-head"></th>
              <th colspan="3" class="text-center">当月</th>
              <th colspan="3" class="text-center dashboard-summary-cumulative-head">累計（<%= cumulativeRangeLabel || `${fiscalStartMonth || 1}月〜${month}月` %>）</th>
              <% if (reflectionEnabled) { %>
                <th class="text-center" rowspan="2">振返り</th>
              <% } %>
            </tr>
            <tr>
              <th></th>
              <th class="text-end">実績</th>
              <th class="text-end">予算</th>
              <th class="text-end">予算差</th>
              <th class="text-end dashboard-summary-cumulative-cell">実績</th>
              <th class="text-end">予算</th>
              <th class="text-end">予算差</th>
            </tr>
          </thead>
          <tbody>
            <% summaryRows.forEach((row, index) => {
                const summaryReflectionItem = row.reflectionItem || (row.key ? `summary:${row.key}` : '');
                const canReflectSummary = reflectionEnabled && row.canReflect !== false && summaryReflectionItem;
                const summaryReflection = canReflectSummary ? (monthlyReflectionMap?.[summaryReflectionItem] || null) : null;
                const summaryReflectionCount = summaryReflection?.comments?.length || 0;
            %>
              <tr class="<%= index === summaryRows.length - 1 ? 'dashboard-summary-balance-row' : '' %>">
                <td class="dashboard-summary-label"><%= row.label %>：</td>
                <td class="text-end <%= summaryNumberClass(row.actual) %>"><%= formatSummaryAmount(row.actual) %></td>
                <td class="text-end <%= summaryNumberClass(row.budget) %>"><%= formatSummaryAmount(row.budget) %></td>
                <td class="text-end <%= summaryNumberClass(row.diff) %>"><%= formatSummaryAmount(row.diff) %></td>
                <td class="text-end dashboard-summary-cumulative-cell <%= summaryNumberClass(row.cumulative) %>"><%= formatSummaryAmount(row.cumulative) %></td>
                <td class="text-end <%= summaryNumberClass(row.cumulativeBudget) %>"><%= formatSummaryAmount(row.cumulativeBudget) %></td>
                <td class="text-end <%= summaryNumberClass(row.cumulativeDiff) %>"><%= formatSummaryAmount(row.cumulativeDiff) %></td>
                <% if (reflectionEnabled) { %>
                  <td class="text-center">
                    <% if (canReflectSummary) { %>
                      <button
                        type="button"
                        class="btn btn-sm <%= summaryReflectionCount > 0 ? 'btn-outline-primary' : 'btn-outline-warning' %> monthly-reflection-btn"
                        data-item="<%= summaryReflectionItem %>"
                        data-title="<%= row.label %>"
                        data-month-total="<%= Number(row.actual || 0) %>"
                        data-month-budget="<%= Number(row.budget || 0) %>"
                        data-month-diff="<%= Number(row.diff || 0) %>"
                        data-cum-total="<%= Number(row.cumulative || 0) %>"
                        data-cum-budget="<%= Number(row.cumulativeBudget || 0) %>"
                        data-cum-diff="<%= Number(row.cumulativeDiff || 0) %>"
                      >
                        <i class="fa-regular fa-comment-dots me-1"></i><%= summaryReflectionCount > 0 ? `${summaryReflectionCount}件` : '未記入' %>
                      </button>
                    <% } %>
                  </td>
                <% } %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

<% if (reflectionEnabled) { %>
<style>
  .monthly-reflection-summary-table thead th {
    --bs-table-bg: #44616D;
    --bs-table-color: #fff;
    background-color: #44616D !important;
    color: #fff !important;
  }
  .monthly-reflection-summary-table tbody th {
    --bs-table-bg: #d8e6ef;
    --bs-table-color: #17222a;
    background-color: #d8e6ef !important;
    color: #17222a !important;
  }
</style>
<div class="modal fade" id="monthlyReflectionModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">月次の振返り</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="reflectionItemInput" value="">
        <input type="hidden" id="reflectionIdInput" value="">
        <input type="hidden" id="reflectionCommentIdInput" value="">

        <div class="mb-3">
          <div class="fw-bold mb-2" id="reflectionItemTitle"></div>
          <div class="table-responsive">
            <table class="table table-sm table-bordered mb-0 monthly-reflection-summary-table">
              <thead class="text-center">
                <tr>
                  <th></th>
                  <th>実績</th>
                  <th>予算</th>
                  <th>予算差</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th class="text-start">当月</th>
                  <td class="text-end" id="reflectionMonthTotal"></td>
                  <td class="text-end" id="reflectionMonthBudget"></td>
                  <td class="text-end" id="reflectionMonthDiff"></td>
                </tr>
                <tr>
                  <th class="text-start">累計</th>
                  <td class="text-end" id="reflectionCumTotal"></td>
                  <td class="text-end" id="reflectionCumBudget"></td>
                  <td class="text-end" id="reflectionCumDiff"></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="mb-3">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="fw-bold">コメント</div>
            <span class="badge bg-warning text-dark d-none" id="reflectionEmptyBadge">未記入</span>
          </div>
          <div id="reflectionCommentList" class="d-grid gap-2"></div>
        </div>

        <div class="border-top pt-3">
          <label for="reflectionBodyInput" class="form-label fw-bold" id="reflectionFormLabel">コメントを追加</label>
          <textarea id="reflectionBodyInput" class="form-control" rows="4" placeholder="今月の実績や予算差について振返りを入力"></textarea>
        </div>
      </div>
      <div class="modal-footer d-flex justify-content-between">
        <button type="button" id="reflectionCancelEditBtn" class="btn btn-outline-secondary btn-sm d-none">編集をやめる</button>
        <div class="d-flex gap-2 ms-auto">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">閉じる</button>
          <button type="button" id="reflectionSaveBtn" class="btn btn-primary btn-sm">追加</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modalEl = document.getElementById('monthlyReflectionModal');
    if (!modalEl || typeof bootstrap === 'undefined') return;

    const reflections = <%- JSON.stringify(monthlyReflectionMap || {}).replace(/</g, '\\u003c') %>;
    const ymValue = '<%= year %>-<%= String(month).padStart(2, '0') %>';
    const reflectionAction = '<%= monthlyReflectionAction %>';
    const modal = new bootstrap.Modal(modalEl);
    let activeButton = null;

    const itemInput = document.getElementById('reflectionItemInput');
    const reflectionIdInput = document.getElementById('reflectionIdInput');
    const commentIdInput = document.getElementById('reflectionCommentIdInput');
    const bodyInput = document.getElementById('reflectionBodyInput');
    const saveBtn = document.getElementById('reflectionSaveBtn');
    const cancelEditBtn = document.getElementById('reflectionCancelEditBtn');
    const formLabel = document.getElementById('reflectionFormLabel');
    const emptyBadge = document.getElementById('reflectionEmptyBadge');
    const commentList = document.getElementById('reflectionCommentList');

    const formatNumber = (value) => Number(value || 0).toLocaleString();
    const setMetric = (id, value) => {
      const el = document.getElementById(id);
      el.textContent = formatNumber(value);
      el.classList.toggle('text-danger', Number(value || 0) < 0);
      el.classList.toggle('fw-bold', Number(value || 0) < 0);
    };
    const getReflection = (item) => reflections[item] || { id: '', item, comments: [] };

    const updateButton = (item) => {
      const reflection = getReflection(item);
      const count = reflection.comments.length;
      document.querySelectorAll('.monthly-reflection-btn').forEach((btn) => {
        if ((btn.dataset.item || '') !== item) return;
        btn.classList.toggle('btn-outline-primary', count > 0);
        btn.classList.toggle('btn-outline-warning', count === 0);
        btn.innerHTML = `<i class="fa-regular fa-comment-dots me-1"></i>${count > 0 ? `${count}件` : '未記入'}`;
      });
    };

    const resetForm = () => {
      commentIdInput.value = '';
      bodyInput.value = '';
      saveBtn.textContent = '追加';
      formLabel.textContent = 'コメントを追加';
      cancelEditBtn.classList.add('d-none');
    };

    const renderComments = (item) => {
      const reflection = getReflection(item);
      reflectionIdInput.value = reflection.id || '';
      const comments = reflection.comments || [];
      emptyBadge.classList.toggle('d-none', comments.length > 0);
      if (comments.length === 0) {
        commentList.innerHTML = '<div class="text-muted border rounded p-3 bg-light">この項目はまだ振返りコメントが未記入です。</div>';
        return;
      }

      commentList.innerHTML = comments.map((comment) => `
        <div class="border rounded p-3 bg-light" data-comment-id="${comment.id}">
          <div class="d-flex justify-content-between gap-2 mb-2">
            <div>
              <span class="fw-bold">${escapeHtml(comment.authorName || '未設定')}</span>
              <span class="text-muted small ms-2">${escapeHtml(comment.createdAt || '')}${comment.updatedAt ? ` / 更新: ${escapeHtml(comment.updatedAt)}` : ''}</span>
            </div>
            ${comment.canEdit ? `
              <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary btn-sm reflection-edit-btn" data-comment-id="${comment.id}">編集</button>
                <button type="button" class="btn btn-outline-danger btn-sm reflection-delete-btn" data-comment-id="${comment.id}">削除</button>
              </div>
            ` : ''}
          </div>
          <div style="white-space: pre-wrap;">${escapeHtml(comment.body || '')}</div>
        </div>
      `).join('');
    };

    const escapeHtml = (value) => String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');

    document.querySelectorAll('.monthly-reflection-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeButton = btn;
        const item = btn.dataset.item || '';
        itemInput.value = item;
        document.getElementById('reflectionItemTitle').textContent = btn.dataset.title || item;
        setMetric('reflectionMonthTotal', btn.dataset.monthTotal);
        setMetric('reflectionMonthBudget', btn.dataset.monthBudget);
        setMetric('reflectionMonthDiff', btn.dataset.monthDiff);
        setMetric('reflectionCumTotal', btn.dataset.cumTotal);
        setMetric('reflectionCumBudget', btn.dataset.cumBudget);
        setMetric('reflectionCumDiff', btn.dataset.cumDiff);
        resetForm();
        renderComments(item);
        modal.show();
      });
    });

    commentList.addEventListener('click', async (event) => {
      const editBtn = event.target.closest('.reflection-edit-btn');
      const deleteBtn = event.target.closest('.reflection-delete-btn');
      const item = itemInput.value;
      const reflection = getReflection(item);

      if (editBtn) {
        const comment = (reflection.comments || []).find((c) => c.id === editBtn.dataset.commentId);
        if (!comment) return;
        reflectionIdInput.value = reflection.id || '';
        commentIdInput.value = comment.id;
        bodyInput.value = comment.body || '';
        saveBtn.textContent = '更新';
        formLabel.textContent = 'コメントを編集';
        cancelEditBtn.classList.remove('d-none');
        bodyInput.focus();
      }

      if (deleteBtn) {
        if (!reflection.id || !deleteBtn.dataset.commentId) return;
        if (!window.confirm('このコメントを削除しますか？')) return;
        try {
          const res = await fetch(`${reflectionAction}/${reflection.id}/comments/${deleteBtn.dataset.commentId}`, {
            method: 'DELETE',
            headers: { 'Accept': 'application/json' }
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok || !data.ok) throw new Error(data.message || '削除に失敗しました');
          if (data.reflection) {
            reflections[item] = data.reflection;
          } else {
            delete reflections[item];
          }
          resetForm();
          renderComments(item);
          updateButton(item);
        } catch (err) {
          alert(err.message || '削除に失敗しました');
        }
      }
    });

    cancelEditBtn.addEventListener('click', resetForm);

    saveBtn.addEventListener('click', async () => {
      const item = itemInput.value;
      const body = bodyInput.value.trim();
      if (!item || !body) {
        alert('コメントを入力してください');
        return;
      }

      const reflectionId = reflectionIdInput.value;
      const commentId = commentIdInput.value;
      const isEdit = reflectionId && commentId;
      saveBtn.disabled = true;
      saveBtn.textContent = isEdit ? '更新中...' : '追加中...';
      try {
        const res = await fetch(isEdit ? `${reflectionAction}/${reflectionId}/comments/${commentId}` : reflectionAction, {
          method: isEdit ? 'PUT' : 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ ym: ymValue, item, body })
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error(data.message || '保存に失敗しました');
        reflections[item] = data.reflection;
        resetForm();
        renderComments(item);
        updateButton(item);
      } catch (err) {
        alert(err.message || '保存に失敗しました');
      } finally {
        saveBtn.disabled = false;
        if (commentIdInput.value) {
          saveBtn.textContent = '更新';
        } else {
          saveBtn.textContent = '追加';
        }
      }
    });
  });
</script>
<% } %>

  <div class="card mt-4">
    <div class="card-body text-white p-2 rounded" style="background-color: #44616D;">
      <h5 class="card-title">支出内訳（<%= month %>月 & 累計）</h5>
      <table class="table table-bordered mt-3 dashboard-monthly">
        <thead class="table-primary text-center">
          <tr>
            <th class="text-dark align-middle" rowspan="2">項目</th>
            <% if (showTagSummary) { %>
              <th class="text-dark align-middle" rowspan="2">タグ</th>
            <% } %>
            <th class="text-dark" colspan="3"><%= month %>月</th>
            <th class="text-dark th-period-highlight" colspan="4"><%= cumulativeRangeLabel || `${fiscalStartMonth || 1}月〜${month}月` %></th>
            <% if (reflectionEnabled) { %>
              <th class="text-dark align-middle" rowspan="2">振返り</th>
            <% } %>
          </tr>
          <tr>
            <th class="text-dark">合計</th>
            <th class="text-dark">予算</th>
            <th class="text-dark">予算差</th>
            <th class="text-dark th-cumulative-highlight">累計</th>
            <th class="text-dark th-cumulative-highlight">予算累計</th>
            <th class="text-dark th-cumulative-highlight">予算-累計</th>
            <th class="text-dark th-cumulative-highlight col-cumulative-diff-rate">累計（％）</th>
          </tr>
        </thead>
        <tbody>
          <% 
            let totalSum = 0, totalBudget = 0, totalDiff = 0;
            let cumTotalSum = 0, cumBudgetSum = 0, cumDiffSum = 0;
            const getBudgetRatePercentValue = (total, budget) => (
              budget ? ((total / budget) * 100) : null
            );
            const formatBudgetRatePercent = (total, budget) => {
              const value = getBudgetRatePercentValue(total, budget);
              return value === null ? '-' : `${value.toFixed(1)}%`;
            };
            const getBudgetDiffRateMeta = (total, budget) => {
              const value = getBudgetRatePercentValue(total, budget);
              if (value === null) return null;

              const absValue = Math.abs(value);
              let toneClass = 'tone-cyan';
              if (value < 0 || value >= 100) {
                toneClass = 'tone-red';
              } else if (value < 50) {
                toneClass = 'tone-green';
              } else if (value < 85) {
                toneClass = 'tone-cyan';
              } else {
                toneClass = 'tone-orange';
              }

              return {
                mainWidth: Math.min(absValue, 100),
                overflowWidth: Math.min(Math.max(absValue - 100, 0), 100),
                directionClass: value < 0 ? 'is-negative' : 'is-positive',
                toneClass,
                isOverflow: absValue > 100,
                isCapped: absValue > 200
              };
            };

            const combinedItems = expenseItems.map(monthItem => {
              const cumItem = cumulativeItems.find(c => c.item === monthItem.item) || { total: 0, budget: 0, diff: 0 };
              return {
                item: monthItem.item,
                month: monthItem,
                cumulative: cumItem
              };
            });

            combinedItems.forEach((data) => {
              const { item, month: monData, cumulative: cum } = data;

              totalSum += monData.total;
              totalBudget += monData.budget;
              totalDiff += monData.diff;

              cumTotalSum += cum.total;
              cumBudgetSum += cum.budget;
              cumDiffSum += cum.diff;
            });

            const totalRateMeta = getBudgetDiffRateMeta(cumTotalSum, cumBudgetSum);
          %>
          <tr class="dashboard-monthly-total-row fw-bold">
            <td class="text-start">合計</td>
            <% if (showTagSummary) { %><td></td><% } %>
            <td class="text-end"><%= totalSum.toLocaleString() %></td>
            <td class="text-end"><%= totalBudget.toLocaleString() %></td>
            <td class="text-end"><%= totalDiff.toLocaleString() %></td>
            <td class="text-end"><%= cumTotalSum.toLocaleString() %></td>
            <td class="text-end"><%= cumBudgetSum.toLocaleString() %></td>
            <td class="text-end"><%= cumDiffSum.toLocaleString() %></td>
            <td class="text-end col-cumulative-diff-rate <%= cumDiffSum < 0 ? 'text-danger' : '' %>">
              <div class="dashboard-monthly-rate-visual <%= totalRateMeta ? `${totalRateMeta.directionClass} ${totalRateMeta.toneClass}${totalRateMeta.isOverflow ? ' has-overflow' : ''}${totalRateMeta.isCapped ? ' is-capped' : ''}` : 'is-empty' %>">
                <% if (totalRateMeta) { %>
                  <div class="dashboard-monthly-rate-bar-wrap" aria-hidden="true">
                    <div class="dashboard-monthly-rate-main">
                      <span class="dashboard-monthly-rate-bar" style="width: <%= totalRateMeta.mainWidth %>%;"></span>
                    </div>
                    <div class="dashboard-monthly-rate-extra">
                      <% if (totalRateMeta.isOverflow) { %>
                        <span class="dashboard-monthly-rate-overflow" style="width: <%= totalRateMeta.overflowWidth %>%;"></span>
                      <% } %>
                    </div>
                  </div>
                <% } %>
                <span class="dashboard-monthly-rate-value"><%= formatBudgetRatePercent(cumTotalSum, cumBudgetSum) %></span>
              </div>
            </td>
            <% if (reflectionEnabled) { %><td></td><% } %>
          </tr>
          <% for (let data of combinedItems) {
              const { item, month: monData, cumulative: cum } = data;
              const cumRateMeta = getBudgetDiffRateMeta(cum.total, cum.budget);
              const reflection = monthlyReflectionMap?.[item] || null;
              const reflectionCount = reflection?.comments?.length || 0;
              const rawTagSet = new Set([
                ...Object.keys(expenseTagSummary?.[item] || {}),
                ...Object.keys(cumulativeTagSummary?.[item] || {})
              ]);
              const hasNamedTag = Array.from(rawTagSet).some(tag => tag !== '他');
              const tagSet = hasNamedTag ? rawTagSet : new Set();
              const tagList = Array.from(tagSet).sort((a, b) => {
                if (a === '他') return 1;
                if (b === '他') return -1;
                return a.localeCompare(b, 'ja');
              });
          %>
            <tr>
              <td class="text-start"><%= item %></td>
              <% if (showTagSummary) { %><td></td><% } %>
              <td class="text-end">
                <a href="/export/dashboard/monthly-detail?scope=<%= viewType === 'user' ? 'user' : 'group' %>&year=<%= year %>&month=<%= String(month) %>&item=<%= encodeURIComponent(item) %>&fy=<%= fiscalYear %>" class="text-decoration-none">
                  <%= monData.total.toLocaleString() %>
                </a>
              </td>
              <td class="text-end"><%= monData.budget.toLocaleString() %></td>
              <td class="text-end <%= monData.diff < 0 ? 'text-danger fw-bold' : '' %>" style="<%= monData.diff < 0 ? 'background-color: #f8d7da;' : '' %>"><%= monData.diff.toLocaleString() %></td>
              <td class="text-end">
                <a href="/export/dashboard/monthly-detail?scope=<%= viewType === 'user' ? 'user' : 'group' %>&year=<%= year %>&month=<%= String(month) %>&item=<%= encodeURIComponent(item) %>&cumulative=1&fy=<%= fiscalYear %>" class="text-decoration-none">
                  <%= cum.total.toLocaleString() %>
                </a>
              </td>
              <td class="text-end"><%= cum.budget.toLocaleString() %></td>
              <td class="text-end <%= cum.diff < 0 ? 'text-danger fw-bold' : '' %>" style="<%= cum.diff < 0 ? 'background-color: #f8d7da;' : '' %>"><%= cum.diff.toLocaleString() %></td>
              <td class="text-end col-cumulative-diff-rate <%= cum.diff < 0 ? 'text-danger fw-bold' : '' %>" style="<%= cum.diff < 0 ? 'background-color: #f8d7da;' : '' %>">
                <div class="dashboard-monthly-rate-visual <%= cumRateMeta ? `${cumRateMeta.directionClass} ${cumRateMeta.toneClass}${cumRateMeta.isOverflow ? ' has-overflow' : ''}${cumRateMeta.isCapped ? ' is-capped' : ''}` : 'is-empty' %>">
                  <% if (cumRateMeta) { %>
                    <div class="dashboard-monthly-rate-bar-wrap" aria-hidden="true">
                      <div class="dashboard-monthly-rate-main">
                        <span class="dashboard-monthly-rate-bar" style="width: <%= cumRateMeta.mainWidth %>%;"></span>
                      </div>
                      <div class="dashboard-monthly-rate-extra">
                        <% if (cumRateMeta.isOverflow) { %>
                          <span class="dashboard-monthly-rate-overflow" style="width: <%= cumRateMeta.overflowWidth %>%;"></span>
                        <% } %>
                      </div>
                    </div>
                  <% } %>
                  <span class="dashboard-monthly-rate-value"><%= formatBudgetRatePercent(cum.total, cum.budget) %></span>
                </div>
              </td>
              <% if (reflectionEnabled) { %>
                <td class="text-center">
                  <button
                    type="button"
                    class="btn btn-sm <%= reflectionCount > 0 ? 'btn-outline-primary' : 'btn-outline-warning' %> monthly-reflection-btn"
                    data-item="<%= item %>"
                    data-title="<%= item %>"
                    data-month-total="<%= Number(monData.total || 0) %>"
                    data-month-budget="<%= Number(monData.budget || 0) %>"
                    data-month-diff="<%= Number(monData.diff || 0) %>"
                    data-cum-total="<%= Number(cum.total || 0) %>"
                    data-cum-budget="<%= Number(cum.budget || 0) %>"
                    data-cum-diff="<%= Number(cum.diff || 0) %>"
                  >
                    <i class="fa-regular fa-comment-dots me-1"></i><%= reflectionCount > 0 ? `${reflectionCount}件` : '未記入' %>
                  </button>
                </td>
              <% } %>
            </tr>
            <% if (showTagSummary) { %>
              <% tagList.forEach((tag) => {
                const monthTagTotal = expenseTagSummary?.[item]?.[tag] || 0;
                const cumulativeTagTotal = cumulativeTagSummary?.[item]?.[tag] || 0;
                const tagQuery = tag === '他' ? '__none__' : tag;
              %>
                <tr>
                  <td></td>
                  <td class="text-start ps-3"><%= tag %></td>
                  <td class="text-end">
                    <a href="/export/dashboard/monthly-detail?scope=<%= viewType === 'user' ? 'user' : 'group' %>&year=<%= year %>&month=<%= String(month) %>&item=<%= encodeURIComponent(item) %>&sub_tag=<%= encodeURIComponent(tagQuery) %>&fy=<%= fiscalYear %>" class="text-decoration-none">
                      <%= monthTagTotal.toLocaleString() %>
                    </a>
                  </td>
                  <td></td>
                  <td></td>
                  <td class="text-end">
                    <a href="/export/dashboard/monthly-detail?scope=<%= viewType === 'user' ? 'user' : 'group' %>&year=<%= year %>&month=<%= String(month) %>&item=<%= encodeURIComponent(item) %>&sub_tag=<%= encodeURIComponent(tagQuery) %>&cumulative=1&fy=<%= fiscalYear %>" class="text-decoration-none">
                      <%= cumulativeTagTotal.toLocaleString() %>
                    </a>
                  </td>
                  <td></td>
                  <td></td>
                  <td></td>
                  <% if (reflectionEnabled) { %><td></td><% } %>
                </tr>
              <% }) %>
            <% } %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
