<% layout('layouts/boilerplate') %>
<% var month = typeof month !== 'undefined' ? month : new Date().getMonth() + 1; %>

<!-- Year Selector Card -->
  <div class="card mb-3 mt-4 rounded">
    <div class="card-body text-white p-2 d-flex justify-content-between align-items-center" style="background-color: #44616D;">
      
      <!-- 年セレクタ部分 -->
      <form method="GET" action="<%= formAction %>" class="d-flex align-items-center gap-2 mb-0">
        <select id="year-select" name="year" onchange="this.form.submit()" class="form-select form-select-sm w-auto">
          <% (availableYears || []).forEach(y => { %>
            <option value="<%= y %>" <%= year === y ? 'selected' : '' %>><%= y %></option>
          <% }) %>
        </select>
        <div class="form-check form-switch mb-0">
          <input class="form-check-input" type="checkbox" id="tagSummarySwitch" name="tagSummary" value="1" <%= showTagSummary ? 'checked' : '' %> onchange="this.form.submit()">
          <label class="form-check-label" for="tagSummarySwitch">タグ別</label>
        </div>
        <span>年度 <%= titlePrefix %>の年間サマリー</span>
      </form>

      <!-- Excel出力ボタン -->
      <form method="GET" action="<%= viewType === 'user' ? '/export/dashboard/yearly-m-exls' : '/export/dashboard/yearly-g-exls' %>" class="mb-0" onsubmit="this.querySelector('button').disabled = true; this.querySelector('button').textContent = '出力中...'; setTimeout(() => { this.querySelector('button').disabled = false; this.querySelector('button').textContent = 'Excel出力'; }, 3000);">
        <input type="hidden" name="year" value="<%= year %>">
        <button type="submit" class="btn btn-sm btn-light">Excel出力</button>
      </form>
    </div>
  </div>

  <!-- Table Card -->
  <div class="card mb-3 rounded">
    <div class="card-body p-2" style="background-color: #44616D;">
      <div class="dashboard-yearly-wrap">
        <table class="table table-bordered table-sm text-end dashboard-yearly" style="table-layout: auto;">
          <!-- <table class="table table-bordered table-sm text-end align-middle" style="width: 80%; margin: auto; table-layout: auto;"> -->
          <thead>
            <tr>
              <th class="sticky-top sticky-col header-fixed" style="border-left: none; border-right: none;">項目</th>
              <% if (showTagSummary) { %>
                <th class="sticky-top header-fixed" style="background-color: #44616D; color: white; border-left: none; border-right: none;">タグ</th>
              <% } %>
              <th class="sticky-top <%= showTagSummary ? '' : 'sticky-col2' %> header-fixed" style="border-left: none; border-right: none;">予算</th>
              <% (fiscalMonths || []).forEach((m) => { %>
              <th class="sticky-top" style="background-color: #44616D; color: white; border-left: none; border-right: none;"><%= m %>月</th>
              <% }) %>
              <th class="sticky-top" style="background-color: #44616D; color: white; border-left: none; border-right: none;">累計</th>
              <th class="sticky-top" style="background-color: #44616D; color: white;">累計差</th>
            </tr>
          </thead>
          <tbody>
            <% const cfList = ['収入', '貯蓄', '控除', '支出']; %>
            <% cfList.forEach((cf, index) => { %>
              <tr class="<%= index % 2 === 0 ? 'table-light' : 'table-info' %>">
                <td class="sticky-col fw-bold text-center"><%= cf %></td>
                <% if (showTagSummary) { %><td></td><% } %>
                <td class="<%= showTagSummary ? '' : 'sticky-col2' %>"><%= totalBudgets[cf]?.toLocaleString() || '0' %></td>
                <% (fiscalMonths || []).forEach((m, idx) => { const mIndex = idx + 1; %>
                  <td>
                    <a
                      href="/export/dashboard/yearly-detail?scope=<%= viewType === 'user' ? 'user' : 'group' %>&year=<%= year %>&month=<%= m %>&cf=<%= encodeURIComponent(cf) %>"
                      class="text-decoration-none">
                      <%= (monthlySummary[mIndex]?.[cf] || 0).toLocaleString() %>
                    </a>
                  </td>
                <% }) %>
                <td class="fw-bold"><%= Array.from({ length: 12 }, (_, i) => monthlySummary[i+1]?.[cf] || 0).reduce((a, b) => a + b, 0).toLocaleString() %></td>
                <%
                  const isIncome = cf === '収入';
                  const total = Array.from({ length: 12 }, (_, i) => monthlySummary[i+1]?.[cf] || 0).reduce((a, b) => a + b, 0);
                  const budget = (totalBudgets?.[cf] || budgetMap?.[cf] || 0) * (budgetMonthCount || 12);
                  const isSaving = cf === '貯蓄';
                  const diff = isIncome || isSaving ? total - budget : budget - total;
                %>
                <td class="fw-bold <%= diff < 0 ? 'text-danger' : '' %>" style="<%= diff < 0 ? 'background-color: #f8d7da;' : '' %>">
                  <%= diff.toLocaleString() %>
                </td>
              </tr>
            <% }) %>
        
            <!-- 収支計 -->
            <tr class="table-warning">
              <td class="sticky-col fw-bold text-center">収支</td>
              <% if (showTagSummary) { %><td></td><% } %>
              <td class="<%= showTagSummary ? '' : 'sticky-col2' %>"></td>
              <% for (let m = 1; m <= 12; m++) {
                const income = monthlySummary[m]?.['収入'] || 0;
                const save = monthlySummary[m]?.['貯蓄'] || 0;
                const dedu = monthlySummary[m]?.['控除'] || 0;
                const expe = monthlySummary[m]?.['支出'] || 0;
                const balance = income - save - dedu - expe;
              %>
                <td><%= balance.toLocaleString() %></td>
              <% } %>
              <td class="fw-bold"><%= Array.from({ length: 12 }, (_, i) => {
                const m = i + 1;
                return (monthlySummary[m]?.['収入'] || 0)
                    - (monthlySummary[m]?.['貯蓄'] || 0)
                    - (monthlySummary[m]?.['控除'] || 0)
                    - (monthlySummary[m]?.['支出'] || 0);
              }).reduce((a, b) => a + b, 0).toLocaleString() %></td>
              <td></td>
            </tr>
        
            <!-- 空行 -->
            <tr><td colspan="<%= showTagSummary ? 17 : 16 %>" style="height: 10px; border: none;"></td></tr>
        
            <!-- 支出内訳 -->
            <% ex_cfs.forEach((item, index) => { %>
              <!-- <tr class="<%= index % 2 === 0 ? 'table-light' : 'table-info' %>"> -->
                <tr class="<%= index % 2 === 0 ? 'table-light' : 'table-info' %>">
                <td class="sticky-col text-start"><%= item %></td>
                <% if (showTagSummary) { %><td></td><% } %>
                <td class="<%= showTagSummary ? '' : 'sticky-col2' %>"><%= budgetMap[item]?.toLocaleString() || '0' %></td>
                <% (fiscalMonths || []).forEach((m, idx) => { const mIndex = idx + 1; %>
                  <td>
                    <a
                      href="/export/dashboard/yearly-detail?scope=<%= viewType === 'user' ? 'user' : 'group' %>&year=<%= year %>&month=<%= m %>&item=<%= encodeURIComponent(item) %>"
                      class="text-decoration-none">
                      <%= (monthlyExpensesDetail[mIndex]?.[item] || 0).toLocaleString() %>
                    </a>
                  </td>
                <% }) %>
                <td class="fw-bold">
                  <a
                    href="/export/dashboard/yearly-detail?scope=<%= viewType === 'user' ? 'user' : 'group' %>&year=<%= year %>&item=<%= encodeURIComponent(item) %>"
                    class="text-decoration-none">
                    <%= Array.from({ length: 12 }, (_, i) => monthlyExpensesDetail[i+1]?.[item] || 0).reduce((a, b) => a + b, 0).toLocaleString() %>
                  </a>
                </td>
                <%
                  const diff = (budgetMap?.[item] || 0) * 12 -
                               Array.from({ length: 12 }, (_, i) => monthlyExpensesDetail[i+1]?.[item] || 0).reduce((a, b) => a + b, 0);
                %>
                <td class="fw-bold <%= diff < 0 ? 'text-danger' : '' %>" style="<%= diff < 0 ? 'background-color: #f8d7da;' : '' %>">
                  <%= diff.toLocaleString() %>
                </td>
              </tr>
              <% if (showTagSummary) { %>
                <%
                  const tagSet = new Set();
                  Array.from({ length: 12 }, (_, i) => i + 1).forEach((monthNo) => {
                    const tagMap = (monthlyExpenseTagDetail?.[monthNo]?.[item]) || {};
                    Object.keys(tagMap).forEach(tag => tagSet.add(tag));
                  });
                  const hasNamedTag = Array.from(tagSet).some(tag => tag !== '他');
                  const tagList = hasNamedTag ? Array.from(tagSet).sort((a, b) => {
                    if (a === '他') return 1;
                    if (b === '他') return -1;
                    return a.localeCompare(b, 'ja');
                  }) : [];
                %>
                <% tagList.forEach((tag) => {
                  const tagQuery = tag === '他' ? '__none__' : tag;
                %>
                  <tr class="<%= index % 2 === 0 ? 'table-light' : 'table-info' %>">
                    <td class="sticky-col"></td>
                    <td class="text-start ps-3"><%= tag %></td>
                    <td></td>
                    <% (fiscalMonths || []).forEach((m, idx) => { const mIndex = idx + 1; const tagAmount = monthlyExpenseTagDetail?.[mIndex]?.[item]?.[tag] || 0; %>
                      <td>
                        <a
                          href="/export/dashboard/yearly-detail?scope=<%= viewType === 'user' ? 'user' : 'group' %>&year=<%= year %>&month=<%= m %>&item=<%= encodeURIComponent(item) %>&sub_tag=<%= encodeURIComponent(tagQuery) %>"
                          class="text-decoration-none">
                          <%= tagAmount.toLocaleString() %>
                        </a>
                      </td>
                    <% }) %>
                    <td class="fw-bold">
                      <a
                        href="/export/dashboard/yearly-detail?scope=<%= viewType === 'user' ? 'user' : 'group' %>&year=<%= year %>&item=<%= encodeURIComponent(item) %>&sub_tag=<%= encodeURIComponent(tagQuery) %>"
                        class="text-decoration-none">
                        <%= Array.from({ length: 12 }, (_, i) => monthlyExpenseTagDetail?.[i+1]?.[item]?.[tag] || 0).reduce((a, b) => a + b, 0).toLocaleString() %>
                      </a>
                    </td>
                    <td></td>
                  </tr>
                <% }) %>
              <% } %>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
