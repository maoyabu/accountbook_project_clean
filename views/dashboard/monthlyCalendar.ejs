<% layout('layouts/boilerplate') %>
<% const walletManaged = walletManagementEnabled === true; %>
<%
  const escapeCalendarHtml = (value) => String(value || '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
  const renderCalendarContent = (bucket) => {
    const links = bucket && Array.isArray(bucket.contentLinks) ? bucket.contentLinks : [];
    if (links.length > 0) {
      return links.map(link => (
        `<a href="${escapeCalendarHtml(link.href)}" class="calendar-detail-link">${escapeCalendarHtml(link.label)}</a>`
      )).join('<span class="calendar-link-separator">, </span>');
    }
    return escapeCalendarHtml(bucket?.contentText || '');
  };
%>

<div class="card mb-3 rounded">
  <div class="card-body text-white p-2 d-flex justify-content-between align-items-center gap-2 dashboard-calendar-toolbar" style="background-color: #44616D;">
    <form method="POST" action="<%= carryCashAction %>" class="d-flex align-items-center gap-2 mb-0 dashboard-calendar-control-form">
      <input
        type="month"
        name="ym"
        value="<%= ymValue %>"
        class="form-control form-control-sm"
        style="max-width: 140px;"
      >
      <button type="submit" formmethod="GET" formaction="<%= formAction %>" class="btn btn-sm btn-light dashboard-calendar-show-btn">表示</button>
      <% if (walletManaged) { %>
        <label for="carryCashInput" class="dashboard-carry-label">繰越現金</label>
        <input
          id="carryCashInput"
          type="number"
          name="carryCash"
          value="<%= Number(carryCash || 0) %>"
          class="form-control form-control-sm dashboard-carry-input"
          step="1"
        >
        <button type="submit" class="btn btn-sm btn-light dashboard-carry-save-btn">保存</button>
      <% } %>
      <span class="dashboard-calendar-title"><%= titlePrefix %> 月次カレンダー集計</span>
    </form>
    <div class="dashboard-calendar-created-wrap">
      <div class="small dashboard-calendar-created">作成日: <%= todayJst %></div>
      <a href="<%= excelAction %>?ym=<%= encodeURIComponent(ymValue) %>" class="btn btn-sm btn-light dashboard-calendar-show-btn">
        Excel
      </a>
    </div>
  </div>
</div>

<div class="card mb-3 rounded">
  <div class="card-body p-2" style="background-color: #44616D;">
    <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
      <div class="text-white fw-bold"><%= year %>年 <%= month %>月</div>
    </div>
    <div class="dashboard-calendar-wrap">
      <table class="table table-sm dashboard-calendar-table mb-0">
        <thead>
          <tr>
            <th rowspan="2">日</th>
            <th rowspan="2">曜</th>
            <th rowspan="2" class="memo-head">メモ</th>
            <th colspan="2" class="finance-main-head">収入</th>
            <th colspan="2" class="finance-main-head">控除</th>
            <% (calendarCategoryGroups || []).forEach((group) => { %>
              <th colspan="2" class="expense-breakdown-head"><%= group.name %></th>
            <% }) %>
            <th colspan="2" class="expense-breakdown-head">それ以外</th>
            <th rowspan="2" class="balance-head">収支</th>
            <th colspan="2" class="payment-group-head">支払種別計</th>
            <% if (walletManaged) { %>
              <th rowspan="2" class="cash-balance-head">現金残</th>
            <% } %>
          </tr>
          <tr>
            <th class="content-head finance-main-head">内容</th>
            <th class="finance-main-head">金額</th>
            <th class="content-head finance-main-head">内容</th>
            <th class="finance-main-head">金額</th>
            <% (calendarCategoryGroups || []).forEach(() => { %>
              <th class="content-head expense-breakdown-head">内容</th>
              <th class="expense-breakdown-head">金額</th>
            <% }) %>
            <th class="content-head expense-breakdown-head">内容</th>
            <th class="expense-breakdown-head">金額</th>
            <th class="payment-head">現金</th>
            <th class="payment-head">現金以外</th>
          </tr>
        </thead>
        <tbody>
          <% dayRows.forEach((row) => { %>
            <tr class="<%= todayDay === row.day ? 'today-row' : '' %>">
              <td class="day-col <%= row.dayToneClass %>"><%= row.day %></td>
              <td class="weekday-col <%= row.dayToneClass %>"><%= row.weekday %></td>
              <td class="memo-col <%= row.dayToneClass %>">
                <button
                  type="button"
                  class="memo-cell-btn"
                  data-day="<%= row.day %>"
                  data-ym="<%= ymValue %>"
                  data-plan-note="<%= row.plannedNote || '' %>"
                  data-cash-topup="<%= Number(row.cashTopupAmount || 0) %>"
                  data-has-plan="<%= (row.plannedNote || (walletManaged && row.cashTopupAmount)) ? '1' : '0' %>"
                >
                  <div class="memo-text <%= row.memoText ? '' : 'is-empty' %>"><%= row.memoText || '' %></div>
                </button>
              </td>
              <td class="content-col <%= row.dayToneClass %>"><div class="content-text"><%- renderCalendarContent(row.income) %></div></td>
              <td class="amount-col <%= row.dayToneClass %>"><%= row.income.amount ? row.income.amount.toLocaleString() : '' %></td>
              <td class="content-col <%= row.dayToneClass %>"><div class="content-text"><%- renderCalendarContent(row.deduction) %></div></td>
              <td class="amount-col <%= row.dayToneClass %>"><%= row.deduction.amount ? row.deduction.amount.toLocaleString() : '' %></td>
              <% (row.categoryGroupBuckets || []).forEach((groupBucket) => { %>
                <td class="content-col <%= row.dayToneClass %>"><div class="content-text"><%- renderCalendarContent(groupBucket.bucket) %></div></td>
                <td class="amount-col <%= row.dayToneClass %>"><%= groupBucket.bucket.amount ? groupBucket.bucket.amount.toLocaleString() : '' %></td>
              <% }) %>
              <td class="content-col <%= row.dayToneClass %>"><div class="content-text"><%- renderCalendarContent(row.otherExpense) %></div></td>
              <td class="amount-col <%= row.dayToneClass %>"><%= row.otherExpense.amount ? row.otherExpense.amount.toLocaleString() : '' %></td>
              <td class="balance-col <%= row.dayToneClass %>"></td>
              <td class="payment-amount-col"><%= row.cashAmount ? row.cashAmount.toLocaleString() : '' %></td>
              <td class="payment-amount-col"><%= row.nonCashAmount ? row.nonCashAmount.toLocaleString() : '' %></td>
              <% if (walletManaged) { %>
                <td class="cash-balance-col"><%= row.cashBalance.toLocaleString() %></td>
              <% } %>
            </tr>
            <% if (row.day === 15) { %>
              <tr class="mid-total-row fw-bold">
                <td class="summary-label" colspan="3">小計（1〜15日）</td>
                <td></td>
                <td class="amount-col"><%= subtotal.incomeAmount.toLocaleString() %></td>
                <td></td>
                <td class="amount-col"><%= subtotal.deductionAmount.toLocaleString() %></td>
                <% (calendarCategoryGroups || []).forEach((group, index) => { %>
                  <td></td>
                  <td class="amount-col"><%= Number(subtotal.categoryGroupAmounts?.[index] || 0).toLocaleString() %></td>
                <% }) %>
                <td></td>
                <td class="amount-col"><%= subtotal.otherExpenseAmount.toLocaleString() %></td>
                <td class="balance-col"><%= subtotal.balance.toLocaleString() %></td>
                <td class="payment-amount-col"><%= subtotal.cashAmount.toLocaleString() %></td>
                <td class="payment-amount-col"><%= subtotal.nonCashAmount.toLocaleString() %></td>
                <% if (walletManaged) { %>
                  <td class="cash-balance-col"><%= subtotal.cashBalance.toLocaleString() %></td>
                <% } %>
              </tr>
            <% } %>
          <% }) %>
          <tr class="mid-total-row fw-bold">
            <td class="summary-label" colspan="3">小計（16〜31日）</td>
            <td></td>
            <td class="amount-col"><%= latterSubtotal.incomeAmount.toLocaleString() %></td>
            <td></td>
            <td class="amount-col"><%= latterSubtotal.deductionAmount.toLocaleString() %></td>
            <% (calendarCategoryGroups || []).forEach((group, index) => { %>
              <td></td>
              <td class="amount-col"><%= Number(latterSubtotal.categoryGroupAmounts?.[index] || 0).toLocaleString() %></td>
            <% }) %>
            <td></td>
            <td class="amount-col"><%= latterSubtotal.otherExpenseAmount.toLocaleString() %></td>
            <td class="balance-col"><%= latterSubtotal.balance.toLocaleString() %></td>
            <td class="payment-amount-col"><%= latterSubtotal.cashAmount.toLocaleString() %></td>
            <td class="payment-amount-col"><%= latterSubtotal.nonCashAmount.toLocaleString() %></td>
            <% if (walletManaged) { %>
              <td class="cash-balance-col"><%= latterSubtotal.cashBalance.toLocaleString() %></td>
            <% } %>
          </tr>
          <tr class="month-total-row fw-bold">
            <td class="summary-label" colspan="3">合計</td>
            <td></td>
            <td class="amount-col"><%= total.incomeAmount.toLocaleString() %></td>
            <td></td>
            <td class="amount-col"><%= total.deductionAmount.toLocaleString() %></td>
            <% (calendarCategoryGroups || []).forEach((group, index) => { %>
              <td></td>
              <td class="amount-col"><%= Number(total.categoryGroupAmounts?.[index] || 0).toLocaleString() %></td>
            <% }) %>
            <td></td>
            <td class="amount-col"><%= total.otherExpenseAmount.toLocaleString() %></td>
            <td class="balance-col"><%= total.balance.toLocaleString() %></td>
            <td class="payment-amount-col"><%= total.cashAmount.toLocaleString() %></td>
            <td class="payment-amount-col"><%= total.nonCashAmount.toLocaleString() %></td>
            <% if (walletManaged) { %>
              <td class="cash-balance-col"><%= total.cashBalance.toLocaleString() %></td>
            <% } %>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="modal fade" id="calendarMemoModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">メモ登録・編集</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="calendarMemoYm" value="<%= ymValue %>">
        <input type="hidden" id="calendarMemoDay" value="">
        <div class="mb-2">
          <label class="form-label mb-1">対象日</label>
          <input type="text" id="calendarMemoDayLabel" class="form-control form-control-sm" readonly>
        </div>
        <div class="mb-2">
          <label for="calendarMemoNote" class="form-label mb-1">メモ</label>
          <textarea id="calendarMemoNote" class="form-control" rows="3" placeholder="予定やメモを入力"></textarea>
        </div>
        <% if (walletManaged) { %>
          <div class="mb-1">
            <label for="calendarMemoCashTopup" class="form-label mb-1">現金追加</label>
            <input
              type="number"
              id="calendarMemoCashTopup"
              class="form-control form-control-sm"
              min="0"
              step="1"
              value="0"
            >
            <div class="form-text">通帳からお財布へ追加した現金を入力</div>
          </div>
        <% } %>
      </div>
      <div class="modal-footer d-flex justify-content-between">
        <button type="button" id="calendarMemoDeleteBtn" class="btn btn-outline-danger btn-sm">削除</button>
        <div class="d-flex gap-2">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">閉じる</button>
          <button type="button" id="calendarMemoSaveBtn" class="btn btn-primary btn-sm">保存</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const memoCells = document.querySelectorAll('.memo-cell-btn');
    const modalEl = document.getElementById('calendarMemoModal');
    if (!memoCells.length || !modalEl) return;
    if (typeof bootstrap === 'undefined') return;
    const walletManagementEnabled = <%- walletManaged ? 'true' : 'false' %>;

    const modal = new bootstrap.Modal(modalEl);
    const ymInput = document.getElementById('calendarMemoYm');
    const dayInput = document.getElementById('calendarMemoDay');
    const dayLabel = document.getElementById('calendarMemoDayLabel');
    const noteInput = document.getElementById('calendarMemoNote');
    const cashTopupInput = document.getElementById('calendarMemoCashTopup');
    const saveBtn = document.getElementById('calendarMemoSaveBtn');
    const deleteBtn = document.getElementById('calendarMemoDeleteBtn');
    const saveUrl = '<%= memoSaveAction %>';
    const deleteUrl = '<%= memoDeleteAction %>';

    const setLoading = (loading) => {
      saveBtn.disabled = loading;
      deleteBtn.disabled = loading;
      saveBtn.textContent = loading ? '保存中...' : '保存';
    };

    memoCells.forEach((cell) => {
      cell.addEventListener('click', () => {
        const day = Number(cell.dataset.day || 0);
        const ym = cell.dataset.ym || ymInput.value;
        const planNote = cell.dataset.planNote || '';
        const cashTopup = Number(cell.dataset.cashTopup || 0);
        const hasPlan = cell.dataset.hasPlan === '1';

        ymInput.value = ym;
        dayInput.value = String(day);
        dayLabel.value = `${ym} / ${day}日`;
        noteInput.value = planNote;
        if (walletManagementEnabled && cashTopupInput) {
          cashTopupInput.value = Number.isFinite(cashTopup) ? String(cashTopup) : '0';
        }
        deleteBtn.classList.toggle('d-none', !hasPlan);

        modal.show();
      });
    });

    saveBtn.addEventListener('click', async () => {
      const payload = {
        ym: ymInput.value,
        day: Number(dayInput.value || 0),
        note: noteInput.value || '',
        cashTopup: walletManagementEnabled && cashTopupInput ? Number(cashTopupInput.value || 0) : 0
      };
      if (!payload.day) return;

      setLoading(true);
      try {
        const res = await fetch(saveUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(payload)
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) {
          throw new Error(data.message || '保存に失敗しました');
        }
        window.location.reload();
      } catch (err) {
        alert(err.message || '保存に失敗しました');
      } finally {
        setLoading(false);
      }
    });

    deleteBtn.addEventListener('click', async () => {
      const day = Number(dayInput.value || 0);
      if (!day) return;
      const deleteMessage = walletManagementEnabled
        ? 'この日のメモと現金追加を削除しますか？'
        : 'この日のメモを削除しますか？';
      if (!window.confirm(deleteMessage)) return;

      setLoading(true);
      try {
        const res = await fetch(deleteUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            ym: ymInput.value,
            day
          })
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) {
          throw new Error(data.message || '削除に失敗しました');
        }
        window.location.reload();
      } catch (err) {
        alert(err.message || '削除に失敗しました');
      } finally {
        setLoading(false);
      }
    });
  });
</script>
