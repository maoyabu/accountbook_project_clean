<% layout('layouts/boilerplate') %>
<link rel="stylesheet" href="/css/finance-notice-board.css">

  <div class="sr-frame w-100 finance-notice-board">
  <div class="notice-heading">
    <div class="page-title-guide-row"><h5 class="mb-0">検索結果: <%= count %> 件</h5><a href="https://colts-wish-krs.craft.me/UJ4Y7muYdOwQlH/b/1B0724C9-975D-46F3-95CF-1D44AAC5CF48/My-Relation"
      target="_blank" rel="noopener"
      class="page-guide-link">
      ガイド
    </a></div>
  </div>
  <div class="sr-body">
  <% if ((typeof enableFilterBar !== 'undefined' && enableFilterBar) || page === 'search') { %>
  <div class="finance-list-filters mb-2">
  <% if (page === 'search') { %>
    <% const resultLimit = typeof displayLimit !== 'undefined' ? displayLimit : 20; const resultSort = typeof sortOrder !== 'undefined' ? sortOrder : 'update_date'; %>
    <div class="finance-list-count d-flex align-items-center gap-2">
      <label for="searchLimitSelect" class="form-label mb-0">表示件数</label>
      <select name="limit" id="searchLimitSelect" form="financeSearchFilterForm" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
        <% [20,50,100].forEach(limit => { %><option value="<%= limit %>" <%= resultLimit === limit ? 'selected' : '' %>><%= limit %>件</option><% }) %>
      </select>
      <div class="d-flex align-items-center gap-2">
        <label for="searchSortOrder" class="form-label mb-0">並び順</label>
        <select name="sortOrder" id="searchSortOrder" form="financeSearchFilterForm" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
          <option value="date" <%= resultSort === 'date' ? 'selected' : '' %>>使用日順</option>
          <option value="update_date" <%= resultSort === 'update_date' ? 'selected' : '' %>>更新日順</option>
        </select>
      </div>
    </div>
  <% } %>
  <details>
    <summary class="notice-filter-toggle">絞り込み</summary>
  <form id="financeSearchFilterForm" method="GET" action="<%= page === 'search' ? '/finance/search/results' : (page === 'monthly-detail' ? '/export/dashboard/monthly-detail' : '/export/dashboard/yearly-detail') %>" class="filter-bar d-flex flex-wrap align-items-end gap-2 mt-2 mb-2 w-100">
    <!-- 基本条件を維持する隠しフィールド -->
    <% if (page !== 'search') { %>
      <!-- finance/search 用: 元の検索条件を維持 -->
      <input type="hidden" name="scope" value="<%= filters?.scope || '' %>">
      <input type="hidden" name="year" value="<%= filters?.year || '' %>">
      <% if (filters?.month) { %>
        <input type="hidden" name="month" value="<%= filters.month %>">
      <% } %>
      <input type="hidden" name="cf" value="<%= filters?.cf || '' %>">
      <input type="hidden" name="item" value="<%= filters?.item || '' %>">
    <% } %>

    <div>
      <label class="form-label mb-1">期間（From）</label>
      <input type="date" name="from" class="form-control form-control-sm" value="<%= filters?.from || '' %>">
    </div>
    <div>
      <label class="form-label mb-1">期間（To）</label>
      <input type="date" name="to" class="form-control form-control-sm" value="<%= filters?.to || '' %>">
    </div>
    <% if (page === 'search') { %>
    <div>
      <label class="form-label mb-1">内容</label>
      <input type="text" name="keyword" class="form-control form-control-sm" value="<%= filters?.keyword || '' %>" placeholder="フリーワード">
    </div>
    <div>
      <label class="form-label mb-1">収支区分</label>
      <select name="cf" class="form-select form-select-sm">
        <option value="">すべて</option>
        <% (la_cfs || []).filter(v=>v!=='Please Choice').forEach(v => { %>
          <option value="<%= v %>" <%= (filters?.cf || '') === v ? 'selected' : '' %>><%= v %></option>
        <% }) %>
      </select>
    </div>
    <div id="block-expense" style="display: none;">
      <div>
        <label class="form-label mb-1">支出項目</label>
        <select name="expense_item" class="form-select form-select-sm">
          <option value="">すべて</option>
          <% (ex_cfs || []).forEach(v => { %>
            <option value="<%= v %>" <%= (filters?.expense_item || '') === v ? 'selected' : '' %>><%= v %></option>
          <% }) %>
        </select>
      </div>
    </div>
    <div id="block-income" style="display: none;">
      <div>
        <label class="form-label mb-1">収入項目</label>
        <select name="income_item" class="form-select form-select-sm">
          <option value="">すべて</option>
          <% (in_items || []).forEach(v => { %>
            <option value="<%= v %>" <%= (filters?.income_item || '') === v ? 'selected' : '' %>><%= v %></option>
          <% }) %>
        </select>
      </div>
    </div>
    <div id="block-dedu" style="display: none;">
      <div>
        <label class="form-label mb-1">控除項目</label>
        <select name="dedu_item" class="form-select form-select-sm">
          <option value="">すべて</option>
          <% (dedu_cfs || []).forEach(v => { %>
            <option value="<%= v %>" <%= (filters?.dedu_item || '') === v ? 'selected' : '' %>><%= v %></option>
          <% }) %>
        </select>
      </div>
    </div>
    <div id="block-saving" style="display: none;">
      <div>
        <label class="form-label mb-1">貯蓄項目</label>
        <select name="saving_item" class="form-select form-select-sm">
          <option value="">すべて</option>
          <% (saving_cfs || []).forEach(v => { %>
            <option value="<%= v %>" <%= (filters?.saving_item || '') === v ? 'selected' : '' %>><%= v %></option>
          <% }) %>
        </select>
      </div>
    </div>
    <% } %>
    <div>
      <label class="form-label mb-1">種別</label>
      <select name="payment_type" class="form-select form-select-sm">
        <option value="Please Choice">すべて</option>
        <% let selectedPaymentAssigned = false; %>
        <% (typeof paymentSearchOptions !== 'undefined' ? paymentSearchOptions : (pay_cfs || []).map(value => ({ value, label: value }))).filter(option => option.value !== 'Please Choice').forEach(option => {
          const selected = !selectedPaymentAssigned && (filters?.payment_type || '') === option.value;
          if (selected) selectedPaymentAssigned = true;
        %>
          <option value="<%= option.value %>" <%= selected ? 'selected' : '' %>><%= option.label %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label class="form-label mb-1">タグ</label>
      <select name="sub_tag" class="form-select form-select-sm">
        <option value="">すべて</option>
        <% (typeof sub_tag_options !== 'undefined' ? sub_tag_options : []).forEach(tag => { %>
          <option value="<%= tag %>" <%= (filters?.sub_tag || '') === tag ? 'selected' : '' %>><%= tag %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label class="form-label mb-1">使用</label>
      <select name="user" class="form-select form-select-sm">
        <option value="">すべて</option>
        <% (whos || []).forEach(w => { %>
          <option value="<%= w._id %>" <%= (filters?.user || '') === (w._id?.toString()) ? 'selected' : '' %>><%= w.displayname %></option>
        <% }) %>
      </select>
    </div>
    <div class="ms-auto d-flex gap-2">
      <button type="submit" class="btn btn-sm btn-primary">絞り込み</button>
      <% if (page === 'search') { %>
        <a class="btn btn-sm btn-outline-secondary" href="/finance/search/results">リセット</a>
      <% } else { %>
        <a class="btn btn-sm btn-outline-secondary" href="<%= page === 'monthly-detail' ? '/export/dashboard/monthly-detail' : '/export/dashboard/yearly-detail' %>?scope=<%= filters?.scope %>&year=<%= filters?.year %><%= filters?.month ? ('&month=' + filters.month) : '' %><%= filters?.cf ? ('&cf=' + encodeURIComponent(filters.cf)) : '' %>&item=<%= encodeURIComponent(filters?.item || '') %>">リセット</a>
      <% } %>
    </div>
  </form>
  </details>
  </div>
  <% } %>

  <% if (page === 'search') { %>
  <script>
    (function(){
      const cfSel = document.querySelector('form select[name="cf"]');
      const show = (id, flag) => { const el = document.getElementById(id); if (el) el.style.display = flag ? '' : 'none'; };
      function toggleBlocks() {
        const v = cfSel ? cfSel.value : '';
        show('block-expense', v === '支出');
        show('block-income',  v === '収入');
        show('block-dedu',    v === '控除');
        show('block-saving',  v === '貯蓄');
        show('block-hint',    !v);
      }
      if (cfSel) {
        cfSel.addEventListener('change', toggleBlocks);
      }
      // 初期反映
      toggleBlocks();
    })();
  </script>
  <% } %>



  <%- include('../partials/financeNoticeList') %>
  </div> <!-- /.sr-body -->
  </div> <!-- /.sr-frame -->

<%- include('../partials/financeEditModal') %>
