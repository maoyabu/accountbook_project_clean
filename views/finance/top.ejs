<% layout('layouts/boilerplate') %>

<div class="row g-3">
  <div class="col-12">
    <div class="card finance-top-card">
      <div class="card-header text-white d-flex justify-content-between align-items-center" style="background-color: #4A6A7A;">
        <span>家計簿</span>
        <a class="btn btn-outline-light btn-sm finance-btn-rounded" href="/finance/budget"><i class="fa-solid fa-gear me-2"></i>家計簿設定</a>
      </div>
      <div class="card-body">
        <div class="mb-4">
          <div class="fw-bold mb-2">予算の到達状況（今月）</div>
          <% if (budgetSummary && budgetSummary.totalBudget > 0) { %>
            <div class="budget-summary-card">
              <div class="budget-summary-header">
                <div class="budget-summary-title">支出予算の到達率</div>
                <div class="budget-summary-rate <%= budgetSummary.totalRate > budgetSummary.dayRate ? 'is-over' : '' %>">
                  <span class="budget-summary-tag <%= budgetSummary.totalRate > budgetSummary.dayRate ? 'is-over' : '' %>"><%= budgetSummary.totalRate %>% / <%= budgetSummary.dayRate %>%</span>
                </div>
              </div>
              <div class="budget-summary-subtitle">支出項目別の予算到達率 / 日数到達率</div>
              <% const overItems = (budgetSummary.items || []).filter(i => i.over); %>
              <% const normalItems = (budgetSummary.items || []).filter(i => !i.over); %>

              <% if (overItems.length > 0) { %>
                <div class="budget-section-title">超過</div>
                <div class="budget-cards budget-cards-over">
                  <% overItems.forEach(item => { %>
                    <div class="budget-item-card is-over">
                      <div class="budget-item-name"><%= item.name %></div>
                      <div class="budget-item-rate is-over">
                        予算到達率 / 日数到達率　<%= item.rate %>% / <%= budgetSummary.dayRate %>%
                      </div>
                      <div class="budget-item-amount">
                        実績 / 予算　<%= Number(item.actual || 0).toLocaleString() %> / <%= Number(item.budget || 0).toLocaleString() %>
                      </div>
                    </div>
                  <% }) %>
                </div>
              <% } %>

              <% if (normalItems.length > 0) { %>
                <div class="budget-section-title">未超過</div>
                <div class="budget-cards budget-cards-normal">
                  <% normalItems.forEach(item => { %>
                    <div class="budget-item-card is-normal">
                      <div class="budget-item-name"><%= item.name %></div>
                      <div class="budget-item-rate">
                        予算到達率 / 日数到達率　<%= item.rate %>% / <%= budgetSummary.dayRate %>%
                      </div>
                      <div class="budget-item-amount">
                        実績 / 予算　<%= Number(item.actual || 0).toLocaleString() %> / <%= Number(item.budget || 0).toLocaleString() %>
                      </div>
                    </div>
                  <% }) %>
                </div>
              <% } %>
            </div>
          <% } else { %>
            <div class="text-muted">予算が設定されていません。</div>
          <% } %>
        </div>

        <div class="mb-3 recent-finance-card">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="fw-bold">直近の入力（5件）</div>
            <div class="d-flex gap-2">
              <a class="btn btn-sm finance-btn-rounded finance-recent-btn" href="/finance/list">
                <svg class="recent-input-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <rect class="recent-input-icon-frame" x="2" y="2" width="20" height="20" rx="4" />
                  <circle cx="7" cy="8" r="1.2" fill="currentColor" />
                  <rect x="9.5" y="7.2" width="9" height="1.6" rx="0.8" fill="currentColor" />
                  <circle cx="7" cy="12" r="1.2" fill="currentColor" />
                  <rect x="9.5" y="11.2" width="9" height="1.6" rx="0.8" fill="currentColor" />
                  <circle cx="7" cy="16" r="1.2" fill="currentColor" />
                  <rect x="9.5" y="15.2" width="9" height="1.6" rx="0.8" fill="currentColor" />
                </svg>
                直近の入力
              </a>
              <a class="btn btn-sm finance-btn-rounded finance-search-btn" href="/finance/search"><i class="fa-solid fa-magnifying-glass me-2"></i>検索</a>
            </div>
          </div>
          <% if (recentFinances.length > 0) { %>
            <ul class="list-group small recent-finance-list">
              <% recentFinances.forEach(finance => { %>
                <li class="list-group-item recent-finance-row d-flex align-items-center">
                  <div class="recent-finance-main">
                    <strong><%= finance.date ? finance.date.toISOString().split('T')[0] : '' %></strong>
                    <span class="ms-2"><%= finance.content || '内容未入力' %></span>
                  </div>
                  <div class="recent-finance-amount">
                    <span class="text-muted me-2"><%= finance.cf || '' %></span>
                    <strong>¥<%= Number(finance.amount || 0).toLocaleString() %></strong>
                  </div>
                  <div class="recent-finance-actions d-flex gap-2 align-items-center">
                    <a class="btn btn-outline-secondary btn-sm" href="/finance/<%= finance._id %>/edit" data-bs-toggle="tooltip" data-bs-placement="top" title="編集">
                      <i class="fa-solid fa-pen-to-square"></i>
                    </a>
                    <form action="/finance/<%= finance._id %>/duplicate" method="POST">
                      <button class="btn btn-outline-secondary btn-sm" type="submit" data-bs-toggle="tooltip" data-bs-placement="top" title="複製">
                        <i class="fa-regular fa-copy"></i>
                      </button>
                    </form>
                    <form action="/finance/<%= finance._id %>?_method=DELETE" method="POST" onsubmit="return confirm('削除しますか？')">
                      <button class="btn btn-outline-danger btn-sm" type="submit" data-bs-toggle="tooltip" data-bs-placement="top" title="削除">
                        <i class="fa-solid fa-trash"></i>
                      </button>
                    </form>
                  </div>
                </li>
              <% }) %>
            </ul>
          <% } else { %>
            <div class="text-muted">直近の入力はありません。</div>
          <% } %>

          <div class="finance-close-status mt-3">
            <div class="fw-bold mb-2"><%= closeYearStatus?.yearLabel %>の入力完了状況（前年度分）</div>
            <% if (closeYearStatus?.members && closeYearStatus.members.length > 0) { %>
              <div class="finance-close-tags">
                <% closeYearStatus.members.forEach(member => { %>
                  <% if (member.completed && member.isSelf) { %>
                    <form action="/finance/year-close/undo" method="POST" class="d-inline" onsubmit="return confirm('未完了に戻しますか？');">
                      <input type="hidden" name="redirectTo" value="/finance/top">
                      <button type="submit" class="finance-close-tag is-done is-clickable" title="クリックで未完了に戻す">
                        <%= member.name %> 完了
                      </button>
                    </form>
                  <% } else { %>
                    <span class="finance-close-tag <%= member.completed ? 'is-done' : 'is-pending' %>">
                      <%= member.name %> <%= member.completed ? '完了' : '未完了' %>
                    </span>
                  <% } %>
                <% }) %>
              </div>
            <% } else { %>
              <div class="text-muted">対象メンバーがいません。</div>
            <% } %>
          </div>

          <div class="finance-close-status mt-3">
            <div class="fw-bold mb-2"><%= closeStatus?.monthLabel %>の入力完了状況（前月分）</div>
            <% if (closeStatus?.members && closeStatus.members.length > 0) { %>
              <div class="finance-close-tags">
                <% closeStatus.members.forEach(member => { %>
                  <% if (member.completed && member.isSelf) { %>
                    <form action="/finance/month-close/undo" method="POST" class="d-inline" onsubmit="return confirm('未完了に戻しますか？');">
                      <input type="hidden" name="redirectTo" value="/finance/top">
                      <button type="submit" class="finance-close-tag is-done is-clickable" title="クリックで未完了に戻す">
                        <%= member.name %> 完了
                      </button>
                    </form>
                  <% } else { %>
                    <span class="finance-close-tag <%= member.completed ? 'is-done' : 'is-pending' %>">
                      <%= member.name %> <%= member.completed ? '完了' : '未完了' %>
                    </span>
                  <% } %>
                <% }) %>
              </div>
            <% } else { %>
              <div class="text-muted">対象メンバーがいません。</div>
            <% } %>
          </div>
        </div>
        <div class="finance-action-group">
          <a class="btn btn-sm finance-btn-rounded finance-action-btn" href="/finance/entry">
            <span class="finance-action-icon"><i class="fa-solid fa-plus"></i></span>
            <span class="finance-action-text">新規登録</span>
          </a>
          <a class="btn btn-sm finance-btn-rounded finance-action-btn" href="/finance/receipt/new">
            <span class="finance-action-icon"><i class="fa-solid fa-receipt"></i></span>
            <span class="finance-action-text">レシートから登録</span>
          </a>
          <a class="btn btn-sm finance-btn-rounded finance-action-btn" href="/matomete/regular-entry/push">
            <span class="finance-action-icon"><i class="fa-solid fa-layer-group"></i></span>
            <span class="finance-action-text">まとめて入力</span>
          </a>
          <a class="btn btn-sm finance-btn-rounded finance-action-btn finance-action-excel" href="/export/view">
            <span class="finance-action-icon"><i class="fa-solid fa-file-excel"></i></span>
            <span class="finance-action-text">EXCEL書出し</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12">
    <div class="row g-3">
      <div class="col-12 col-lg-6">
        <div class="card h-100 finance-tone-card">
          <div class="card-header text-white finance-tone-header">
            Dashboard
          </div>
          <div class="card-body dashboard-body">
            <div class="row g-3 dashboard-grid">
              <div class="col-6">
                <a class="btn btn-sm w-100 btn-group-blue dashboard-button" href="/export/dashboard/monthly-g">
                  <span class="dashboard-icon"><i class="fa-solid fa-table"></i></span>
                  <span class="dashboard-title">月次集計</span>
                  <span class="dashboard-suffix">（グループ）</span>
                </a>
              </div>
              <div class="col-6">
                <a class="btn btn-outline-primary btn-sm w-100 dashboard-button" href="/export/dashboard/monthly-m">
                  <span class="dashboard-icon"><i class="fa-solid fa-table"></i></span>
                  <span class="dashboard-title">月次集計</span>
                  <span class="dashboard-suffix">（個人）</span>
                </a>
              </div>
              <div class="col-6">
                <a class="btn btn-sm w-100 btn-group-blue dashboard-button" href="/export/dashboard/yearly-g">
                  <span class="dashboard-icon"><i class="fa-solid fa-table"></i></span>
                  <span class="dashboard-title">年次集計</span>
                  <span class="dashboard-suffix">（グループ）</span>
                </a>
              </div>
              <div class="col-6">
                <a class="btn btn-outline-primary btn-sm w-100 dashboard-button" href="/export/dashboard/yearly-m">
                  <span class="dashboard-icon"><i class="fa-solid fa-table"></i></span>
                  <span class="dashboard-title">年次集計</span>
                  <span class="dashboard-suffix">（個人）</span>
                </a>
              </div>
              <div class="col-6">
                <a class="btn btn-sm w-100 btn-group-light dashboard-button" href="/export/yearly-stacked">
                  <span class="dashboard-icon"><i class="fa-solid fa-chart-line"></i></span>
                  <span class="dashboard-title">年グラフ</span>
                  <span class="dashboard-suffix">（グループ）</span>
                </a>
              </div>
              <div class="col-6">
                <a class="btn btn-sm w-100 btn-group-light dashboard-button" href="/export/monthly-stacked">
                  <span class="dashboard-icon"><i class="fa-solid fa-chart-line"></i></span>
                  <span class="dashboard-title">月グラフ</span>
                  <span class="dashboard-suffix">（グループ）</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-12 col-lg-6">
        <div class="card h-100 finance-tone-card">
          <div class="card-header text-white d-flex justify-content-between align-items-center finance-tone-header">
            <span>資産管理</span>
            <a class="btn btn-outline-light btn-sm" href="/asset/display">資産管理トップへ</a>
          </div>
          <div class="card-body">
            <div class="fw-bold mb-2">⚫︎<%= inventoryLabel %>時点の資産状況</div>
            <% const totalValue = Number(totalYen || 0); %>
            <% const totalClass = totalValue >= 0 ? 'asset-total-positive' : 'asset-total-negative'; %>
            <div class="row g-2">
              <div class="col-12">
                <ul class="list-group">
                  <li class="list-group-item d-flex justify-content-between">
                    <span>金融資産</span>
                    <span>¥<%= Number(totalByCf['金融資産'] || 0).toLocaleString() %></span>
                  </li>
                  <li class="list-group-item d-flex justify-content-between">
                    <span>実物資産</span>
                    <span>¥<%= Number(totalByCf['実物資産'] || 0).toLocaleString() %></span>
                  </li>
                  <li class="list-group-item d-flex justify-content-between">
                    <span>無形資産</span>
                    <span>¥<%= Number(totalByCf['無形資産'] || 0).toLocaleString() %></span>
                  </li>
                  <li class="list-group-item d-flex justify-content-between">
                    <span>負債</span>
                    <span>¥<%= Number(totalByCf['負債'] || 0).toLocaleString() %></span>
                  </li>
                  <li class="list-group-item d-flex justify-content-between <%= totalClass %>">
                    <span>資産合計</span>
                    <strong>¥<%= totalValue.toLocaleString() %></strong>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach((el) => {
    new bootstrap.Tooltip(el);
  });
</script>
