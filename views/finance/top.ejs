<% layout('layouts/boilerplate') %>

<div class="row g-3">
  <div class="col-12 col-lg-6">
    <div class="card">
      <div class="card-header text-white d-flex justify-content-between align-items-center" style="background-color: #3a7ca5;">
        <span>【家計簿サービス】</span>
        <a class="btn btn-outline-light btn-sm" href="/finance/budget">家計簿設定</a>
      </div>
      <div class="card-body">
        <div class="mb-3">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="fw-bold">直近の入力（5件）</div>
            <div class="d-flex gap-2">
              <a class="btn btn-outline-primary btn-sm" href="/finance/list">直近の入力</a>
              <a class="btn btn-outline-primary btn-sm" href="/finance/search">検索</a>
            </div>
          </div>
          <% if (recentFinances.length > 0) { %>
            <ul class="list-group small">
              <% recentFinances.forEach(finance => { %>
                <li class="list-group-item d-flex justify-content-between align-items-center flex-nowrap">
                  <div class="text-truncate" style="max-width: 55%; min-width: 0;">
                    <strong><%= finance.date ? finance.date.toISOString().split('T')[0] : '' %></strong>
                    <span class="ms-2"><%= finance.content || '内容未入力' %></span>
                  </div>
                  <div class="text-end">
                    <span class="text-muted me-2"><%= finance.cf || '' %></span>
                    <strong>¥<%= Number(finance.amount || 0).toLocaleString() %></strong>
                  </div>
                  <div class="d-flex gap-2 align-items-center">
                    <a class="btn btn-outline-secondary btn-sm" href="/finance/<%= finance._id %>/edit" data-bs-toggle="tooltip" data-bs-placement="top" title="編集">
                      <i class="fa-solid fa-pen-to-square"></i>
                    </a>
                    <form action="/finance/<%= finance._id %>/duplicate" method="POST">
                      <button class="btn btn-outline-secondary btn-sm" type="submit" data-bs-toggle="tooltip" data-bs-placement="top" title="複製">
                        <i class="fa-regular fa-copy"></i>
                      </button>
                    </form>
                    <form action="/finance/<%= finance._id %>?_method=DELETE" method="POST" onsubmit="return confirm('削除しますか？')">
                      <button class="btn btn-outline-danger btn-sm" type="submit" data-bs-toggle="tooltip" data-bs-placement="top" title="削除">
                        <i class="fa-solid fa-trash"></i>
                      </button>
                    </form>
                  </div>
                </li>
              <% }) %>
            </ul>
          <% } else { %>
            <div class="text-muted">直近の入力はありません。</div>
          <% } %>
        </div>
        <div class="d-flex flex-nowrap gap-2 overflow-auto">
          <a class="btn btn-outline-primary btn-sm" href="/finance/entry">新規登録</a>
          <a class="btn btn-outline-primary btn-sm" href="/finance/receipt/new">レシートから登録</a>
          <a class="btn btn-outline-primary btn-sm" href="/matomete/regular-entry/push">まとめて入力</a>
          <a class="btn btn-outline-primary btn-sm" href="/export/view">EXCEL書出し</a>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12 col-lg-6">
    <div class="card">
      <div class="card-header text-white" style="background-color: #3a7ca5;">
        【Dashboard】
      </div>
      <div class="card-body">
        <div class="row g-2">
          <div class="col-6">
            <a class="btn btn-sm w-100 btn-group-blue" href="/export/dashboard/monthly-g">月次集計（グループ）</a>
          </div>
          <div class="col-6">
            <a class="btn btn-outline-primary btn-sm w-100" href="/export/dashboard/monthly-m">月次集計（個人）</a>
          </div>
          <div class="col-6">
            <a class="btn btn-sm w-100 btn-group-blue" href="/export/dashboard/yearly-g">年次集計（グループ）</a>
          </div>
          <div class="col-6">
            <a class="btn btn-outline-primary btn-sm w-100" href="/export/dashboard/yearly-m">年次集計（個人）</a>
          </div>
          <div class="col-6">
            <a class="btn btn-sm w-100 btn-group-light" href="/export/yearly-stacked">年グラフ（グループ）</a>
          </div>
          <div class="col-6">
            <a class="btn btn-sm w-100 btn-group-light" href="/export/monthly-stacked">月グラフ（グループ）</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12">
    <div class="card">
      <div class="card-header text-white d-flex justify-content-between align-items-center" style="background-color: #3a7ca5;">
        <span>【資産管理】</span>
        <a class="btn btn-outline-light btn-sm" href="/asset/display">資産管理トップへ</a>
      </div>
      <div class="card-body">
        <div class="fw-bold mb-2">⚫︎<%= inventoryLabel %>時点の資産状況</div>
        <div class="row g-2">
          <div class="col-12 col-md-6">
            <ul class="list-group">
              <li class="list-group-item d-flex justify-content-between">
                <span>資産合計</span>
                <strong>¥<%= Number(totalYen || 0).toLocaleString() %></strong>
              </li>
              <li class="list-group-item d-flex justify-content-between">
                <span>金融資産</span>
                <span>¥<%= Number(totalByCf['金融資産'] || 0).toLocaleString() %></span>
              </li>
              <li class="list-group-item d-flex justify-content-between">
                <span>実物資産</span>
                <span>¥<%= Number(totalByCf['実物資産'] || 0).toLocaleString() %></span>
              </li>
              <li class="list-group-item d-flex justify-content-between">
                <span>無形資産</span>
                <span>¥<%= Number(totalByCf['無形資産'] || 0).toLocaleString() %></span>
              </li>
              <li class="list-group-item d-flex justify-content-between">
                <span>負債</span>
                <span>¥<%= Number(totalByCf['負債'] || 0).toLocaleString() %></span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach((el) => {
    new bootstrap.Tooltip(el);
  });
</script>
