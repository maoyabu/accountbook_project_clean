<% layout('layouts/boilerplate') %>

<div class="text-end mb-2">
  <a href="https://colts-wish-krs.craft.me/UJ4Y7muYdOwQlH/b/1E4B2174-E5D2-44AD-A003-E17BAC4C2917/%E5%AE%B6%E8%A8%88%E7%B0%BF%E3%81%AE%E5%88%9D%E6%9C%9F%E8%A8%AD%E5%AE%9A"
     target="_blank" rel="noopener"
     class="badge bg-success text-white text-decoration-none p-2">
    ガイド
  </a>
</div>
<h5 class="mb-2"><i class="fa-regular fa-money-bill-1"></i> 年度毎の予算設定</h5>
<div class="p-3 border rounded bg-light mb-4">
  <form action="/finance/budget" method="GET" class="mb-3 d-flex align-items-center gap-2 flex-wrap">
    <label for="budgetYear" class="form-label mb-0">年度</label>
    <input type="text" id="budgetYear" name="year" placeholder="例: 2026" value="<%= selectedYear %>" required class="form-control form-control-sm" style="max-width: 8rem;">
    <button type="submit" class="btn btn-primary btn-sm">表示</button>
    <a href="/finance/budget/group-summary?year=<%= encodeURIComponent(selectedYear) %>" class="btn btn-outline-secondary btn-sm">グループ予算を確認</a>
  </form>

  <div class="mb-2 fw-bold"><%= groupName %> メンバー個人予算設定</div>
  <div class="d-flex flex-wrap gap-2 mb-3">
    <% (members || []).forEach((member) => { %>
      <form action="/finance/budget/setup" method="POST" class="d-inline">
        <input type="hidden" name="groupId" value="<%= activeGroupId %>">
        <input type="hidden" name="year" value="<%= selectedYear %>">
        <input type="hidden" name="userId" value="<%= member.id %>">
        <button type="submit" class="btn btn-outline-primary btn-sm"><%= member.name %> の予算設定</button>
      </form>
    <% }) %>
    <% if (!members || members.length === 0) { %>
      <div class="text-muted small">予算設定対象のメンバーがいません。</div>
    <% } %>
  </div>

  <form action="/finance/budget/fiscal-start-month" method="POST" class="d-flex align-items-center gap-2">
    <label for="fiscalStartMonth" class="form-label mb-0">年度の開始月</label>
    <select id="fiscalStartMonth" name="fiscal_start_month" class="form-select form-select-sm" style="max-width: 7rem;">
      <% for (let m = 1; m <= 12; m++) { %>
        <option value="<%= m %>" <%= (fiscalStartMonth || 1) === m ? 'selected' : '' %>><%= m %>月</option>
      <% } %>
    </select>
    <button type="submit" class="btn btn-outline-primary btn-sm">保存</button>
  </form>
</div>
<h5 class="mb-2"><i class="fa-solid fa-layer-group"></i> 上位カテゴリー設定</h5>
<div class="p-3 border rounded bg-light mb-4">
  <form action="/finance/budget/category-groups" method="POST" id="categoryGroupForm">
    <input type="hidden" name="year" value="<%= selectedYear %>">
    <div class="table-responsive">
      <table class="table table-sm align-middle mb-2">
        <thead>
          <tr>
            <th style="width: 8rem;">対象区分</th>
            <th style="width: 12rem;">上位カテゴリー</th>
            <th>含める区分</th>
            <th style="width: 8rem;">月次表示</th>
            <th style="width: 4rem;">操作</th>
          </tr>
        </thead>
        <tbody id="categoryGroupTableBody">
          <% (categoryGroups || []).forEach((group, idx) => { %>
            <tr>
              <td>
                <select name="categoryGroups[<%= idx %>][target_type]" class="form-select form-select-sm category-group-type">
                  <% (categoryGroupTypes || []).forEach((type) => { %>
                    <option value="<%= type %>" <%= group.target_type === type ? 'selected' : '' %>><%= type.replace('項目', '区分') %></option>
                  <% }) %>
                </select>
              </td>
              <td>
                <input
                  type="text"
                  name="categoryGroups[<%= idx %>][name]"
                  class="form-control form-control-sm"
                  value="<%= group.name || '' %>"
                  placeholder="例: 食費"
                >
              </td>
              <td>
                <select name="categoryGroups[<%= idx %>][item_names]" class="form-select form-select-sm category-group-items" multiple size="4">
                  <% const options = (categoryGroupItemOptions && categoryGroupItemOptions[group.target_type]) ? categoryGroupItemOptions[group.target_type] : []; %>
                  <% options.forEach((itemName) => { %>
                    <option value="<%= itemName %>" <%= (group.item_names || []).includes(itemName) ? 'selected' : '' %>><%= itemName %></option>
                  <% }) %>
                </select>
              </td>
              <td>
                <div class="form-check">
                  <input
                    class="form-check-input"
                    type="checkbox"
                    name="categoryGroups[<%= idx %>][show_in_monthly_calendar]"
                    <%= group.show_in_monthly_calendar ? 'checked' : '' %>
                  >
                </div>
              </td>
              <td>
                <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeCategoryGroupRow(this)"><i class="fas fa-trash-alt"></i></button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <div class="text-muted small mb-2">※ 複数選択は Ctrl / Command キーを押しながら選択できます。月次表示にチェックした上位カテゴリーは月次カレンダー集計の控除の右に表示します。</div>
    <div class="d-flex gap-2">
      <button type="button" class="btn btn-secondary btn-sm" onclick="addCategoryGroupRow()">＋上位カテゴリー追加</button>
      <button type="submit" class="btn btn-outline-primary btn-sm">保存</button>
    </div>
  </form>
</div>
<h5 class="mb-2" id="financeQuickMenuSettings"><i class="fa-solid fa-thumbtack"></i> よく使う項目</h5>
<div class="p-3 border rounded bg-light mb-4">
  <form action="/finance/budget/quick-menu-settings" method="POST">
    <label class="finance-quick-toggle finance-quick-settings-toggle mb-3">
      <span>よく使う項目を表示する</span>
      <input type="checkbox" name="quickMenuEnabled" value="true" <%= quickMenuEnabled === false ? '' : 'checked' %>>
      <input type="hidden" name="quickMenuEnabled" value="false">
      <span class="finance-quick-toggle-track" aria-hidden="true"></span>
    </label>
    <div class="table-responsive">
      <table class="table table-sm align-middle mb-2">
        <thead>
          <tr>
            <th style="width: 4rem;">表示順</th>
            <th>項目</th>
            <th>表示名</th>
          </tr>
        </thead>
        <tbody>
          <% for (let i = 0; i < 5; i++) { %>
            <% const row = (quickMenuSettings && quickMenuSettings[i]) ? quickMenuSettings[i] : {}; %>
            <tr>
              <td><%= i + 1 %></td>
              <td>
                <select name="quickMenu[<%= i %>][key]" class="form-select form-select-sm finance-quick-menu-select">
                  <option value="">選択しない</option>
                  <% (quickMenuOptions || []).forEach((option) => { %>
                    <option value="<%= option.key %>" <%= row.key === option.key ? 'selected' : '' %>><%= option.label %></option>
                  <% }) %>
                </select>
              </td>
              <td>
                <input
                  type="text"
                  name="quickMenu[<%= i %>][label]"
                  class="form-control form-control-sm"
                  maxlength="24"
                  value="<%= row.customLabel || '' %>"
                  placeholder="未入力なら元のメニュー名"
                >
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <div class="text-muted small mb-2">※ 画面右上のフローティングメニューに表示します。同じ項目が複数ある場合は先に選んだものだけ保存します。</div>
    <button type="submit" class="btn btn-outline-primary btn-sm">保存</button>
  </form>
</div>
<h5 class="mb-2"><i class="fa-solid fa-wallet"></i> お財布管理</h5>
<div class="p-3 border rounded bg-light mb-4">
    <form action="/finance/budget/wallet-settings" method="POST" class="mb-2">
        <div class="form-check">
            <input
                class="form-check-input"
                type="radio"
                name="wallet_management"
                id="walletManagementEnabled"
                value="enabled"
                <%= noticeSettings?.walletManagementEnabled ? 'checked' : '' %>
            >
            <label class="form-check-label" for="walletManagementEnabled">管理する</label>
        </div>
        <div class="form-check">
            <input
                class="form-check-input"
                type="radio"
                name="wallet_management"
                id="walletManagementDisabled"
                value="disabled"
                <%= noticeSettings?.walletManagementEnabled ? '' : 'checked' %>
            >
            <label class="form-check-label" for="walletManagementDisabled">管理しない</label>
        </div>
        <button type="submit" class="btn btn-outline-primary btn-sm mt-2">保存</button>
    </form>
    <div class="text-muted small">※ 管理しない場合、月次カレンダーの繰越現金・現金追加・現金残を非表示にします。</div>
</div>
<h5 class="mb-2"><i class="fa-regular fa-bell"></i> 予算到達メール通知</h5>
<div class="p-3 border rounded bg-light mb-4">
    <form action="/finance/budget/notice-settings" method="POST" class="mb-2">
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="noticeEnabled" name="notice_enabled" <%= noticeSettings?.enabled ? 'checked' : '' %>>
            <label class="form-check-label" for="noticeEnabled">通知を受け取る</label>
        </div>
        <div class="row g-1 align-items-end">
            <div class="col-12 col-md-2">
                <label class="form-label">到達率1（%）</label>
                <input type="number" class="form-control" name="notice_threshold1" min="0" max="100" value="<%= noticeSettings?.thresholds?.[0] ?? 50 %>" style="max-width: 6rem;">
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label">到達率2（%）</label>
                <input type="number" class="form-control" name="notice_threshold2" min="0" max="100" value="<%= noticeSettings?.thresholds?.[1] ?? 80 %>" style="max-width: 6rem;">
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label">到達率3（%）</label>
                <input type="number" class="form-control" name="notice_threshold3" min="0" max="100" value="<%= noticeSettings?.thresholds?.[2] ?? 90 %>" style="max-width: 6rem;">
            </div>
            <div class="col-12 col-md-auto">
                <button type="submit" class="btn btn-outline-primary btn-sm">保存</button>
            </div>
        </div>
        <div class="text-muted small mt-2">※ 100%は設定しなくても通知されます。</div>
    </form>
    <form action="/finance/budget/notice-time" method="POST" class="mt-3 d-flex align-items-center gap-2">
        <label class="form-label mb-0">送信時間（0〜23時）</label>
        <input type="number" class="form-control" name="budget_notice_hour" min="0" max="23" value="<%= noticeSettings?.budgetNoticeHour ?? 8 %>" style="max-width: 6rem;">
        <button type="submit" class="btn btn-outline-primary btn-sm">保存</button>
    </form>
    <% if (process.env.NODE_ENV !== 'production') { %>
      <form action="/finance/budget/notice-test" method="POST" class="mt-2">
          <div class="text-muted small">※ テスト送信はActiveグループのメンバーへ送信します。</div>
          <button type="submit" class="btn btn-outline-secondary btn-sm mt-2">テスト送信</button>
      </form>
    <% } %>
</div>
<h5 class="mb-2"><i class="fa-regular fa-envelope"></i> まとめて入力の催促</h5>
<div class="p-3 border rounded bg-light mb-4">
    <form action="/finance/budget/matomete-settings" method="POST" class="mb-2">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label">催促メール送信までの日数</label>
                <input type="number" class="form-control" name="matomete_reminder_days" min="1" max="31" value="<%= noticeSettings?.matometeReminderDays ?? 7 %>" style="max-width: 9rem;">
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label">送信時間（0〜23時）</label>
                <input type="number" class="form-control" name="matomete_reminder_hour" min="0" max="23" value="<%= noticeSettings?.matometeReminderHour ?? 8 %>" style="max-width: 9rem;">
            </div>
        </div>
        <div class="text-muted small mt-2">※ 毎月1日に前月分の案内を送信後、指定日数が経過しても完了していない場合に催促メールを送信します。</div>
        <button type="submit" class="btn btn-outline-primary btn-sm mt-3">保存</button>
    </form>
</div>
<div class="p-3 border rounded bg-light mb-4">
    <h5><i class="fa-regular fa-credit-card"></i> <a href="/finance/payment-items">支払い方法の設定</a></h5>
</div>

<script>
  const categoryGroupTypes = <%- JSON.stringify(categoryGroupTypes || []) %>;
  const categoryGroupItemOptions = <%- JSON.stringify(categoryGroupItemOptions || {}) %>;

  function escapeHtml(value) {
    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function categoryGroupTypeLabel(type) {
    return String(type || '').replace('項目', '区分');
  }

  function buildCategoryGroupTypeOptions(selectedType) {
    return categoryGroupTypes.map((type) => (
      `<option value="${escapeHtml(type)}" ${type === selectedType ? 'selected' : ''}>${escapeHtml(categoryGroupTypeLabel(type))}</option>`
    )).join('');
  }

  function buildCategoryGroupItemOptions(type, selectedItems = []) {
    const selectedSet = new Set(selectedItems);
    return (categoryGroupItemOptions[type] || []).map((itemName) => (
      `<option value="${escapeHtml(itemName)}" ${selectedSet.has(itemName) ? 'selected' : ''}>${escapeHtml(itemName)}</option>`
    )).join('');
  }

  function refreshCategoryGroupItemOptions(row) {
    const typeSelect = row.querySelector('.category-group-type');
    const itemsSelect = row.querySelector('.category-group-items');
    if (!typeSelect || !itemsSelect) return;
    itemsSelect.innerHTML = buildCategoryGroupItemOptions(typeSelect.value);
  }

  function addCategoryGroupRow() {
    const tbody = document.getElementById('categoryGroupTableBody');
    if (!tbody) return;
    const index = tbody.children.length;
    const defaultType = categoryGroupTypes[1] || categoryGroupTypes[0] || '';
    const row = document.createElement('tr');
    row.innerHTML = `
      <td>
        <select name="categoryGroups[${index}][target_type]" class="form-select form-select-sm category-group-type">
          ${buildCategoryGroupTypeOptions(defaultType)}
        </select>
      </td>
      <td>
        <input type="text" name="categoryGroups[${index}][name]" class="form-control form-control-sm" placeholder="例: 食費">
      </td>
      <td>
        <select name="categoryGroups[${index}][item_names]" class="form-select form-select-sm category-group-items" multiple size="4">
          ${buildCategoryGroupItemOptions(defaultType)}
        </select>
      </td>
      <td>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="categoryGroups[${index}][show_in_monthly_calendar]">
        </div>
      </td>
      <td>
        <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeCategoryGroupRow(this)"><i class="fas fa-trash-alt"></i></button>
      </td>
    `;
    tbody.appendChild(row);
    row.querySelector('.category-group-type')?.addEventListener('change', () => refreshCategoryGroupItemOptions(row));
  }

  function removeCategoryGroupRow(button) {
    button.closest('tr')?.remove();
  }

  document.querySelectorAll('#categoryGroupTableBody tr').forEach((row) => {
    row.querySelector('.category-group-type')?.addEventListener('change', () => refreshCategoryGroupItemOptions(row));
  });
</script>
