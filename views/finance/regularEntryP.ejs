<% layout('layouts/boilerplate') %>

<div class="text-end">
  <a href="https://colts-wish-krs.craft.me/UJ4Y7muYdOwQlH/b/F541BF02-F996-44F2-AC86-B27DACA13A46/%E5%AE%B6%E8%A8%88%E7%B0%BF-%E3%81%BE%E3%81%A8%E3%82%81%E3%81%A6%E5%85%A5%E5%8A%9B"
     target="_blank" rel="noopener"
     class="badge bg-success text-white text-decoration-none p-2">
    ガイド
  </a>
</div>
    <div class="card shadow-sm mt-2">
        <div class="card-header text-white mb-1 d-flex justify-content-between align-items-center" style="background-color: #44616D;">
            <h5 class="mb-0">【登録済】まとめて入力項目</h5>
            <button type="button" id="regularEntryAdd" class="btn btn-warning btn-sm">項目追加</button>
        </div>
        <% if (!regularEntries || regularEntries.length === 0) { %>
          <div class="alert alert-secondary m-3 mb-2">
            有効なまとめて入力項目がありません。項目追加ボタンから項目を追加するか、削除済み項目を復活してください。
          </div>
        <% } else { %>
          <form action="/matomete/regular-entry/update" method="POST" id="regularEntryExecuteForm" class="no-js-submit">
              <table class="table table-bordered">
              <thead class="table-primary">
                  <tr>
                  <th style="background-color: #44616D;">区分</th>
                  <th style="background-color: #44616D;">項目</th>
                  <th style="background-color: #44616D;">内容</th>
                  <th style="width:80px; background-color:#3a7ca5;">金額</th>
                  <th style="background-color: #44616D;">支払種別</th>
                  <th style="background-color: #44616D;">操作</th>
                  </tr>
              </thead>
              <tbody>
                  <% regularEntries.forEach((entry, idx) => { %>
                  <tr data-regular-id="<%= entry._id %>" tabindex="0" aria-haspopup="menu" aria-label="右クリックまたは長押しで編集・削除">
                      <td><%= entry.cf %></td>
                      <td>
                      <%= entry.cf === '収入' ? entry.income_item :
                          entry.cf === '支出' ? entry.expense_item :
                          entry.cf === '控除' ? entry.dedu_item : entry.saving_item %>
                      </td>
                      <td><%= entry.content %></td>
                      <td>
                          <input type="number" name="items[<%= idx %>][amount]" value="<%= entry.amount %>" class="form-control form-control-sm text-end regular-entry-amount" data-entry-id="<%= entry._id %>" required>
                          <input type="hidden" name="items[<%= idx %>][id]" value="<%= entry._id %>">
                      </td>
                      <td><%= entry.payment_type %></td>
                      <td class="text-center">
                          <input type="checkbox" name="items[<%= idx %>][skip]" value="1">
                      <br><small>除外</small>
                      </td>
                  </tr>
                  <% }) %>
              </tbody>
              </table>
              <p class="small text-muted px-3">金額の変更は自動保存され、次回にも反映されます。</p>
              <p id="regularAmountStatus" class="small px-3" role="status" aria-live="polite"></p>
              <!-- 年月の選択（カレンダー形式） -->
              <div class="mb-3">
                  <div class="form-group mb-4 d-flex justify-content-center">
                      <div style="width: 50%;">
                          <label for="targetMonth" class="form-label fw-bold text-center w-100">登録対象の年月:</label>
                          <input type="month" id="targetMonth" name="targetMonth" class="form-control text-center" value="<%= defaultYearMonth %>" required>
                      </div>
                  </div>
              </div>
              <div class="text-center mt-3">
                  <p>この内容で指定した年月の収支データを一括で登録します</p>
                  <button type="submit" class="btn btn-danger mb-4" style="width: 80%;">まとめて入力実行</button>
              </div>
          </form>
        <% } %>
    </div>


<script>
  const targetMonthInput = document.getElementById('targetMonth');
  if (targetMonthInput) {
    targetMonthInput.addEventListener('change', function () {
      const [year, month] = this.value.split('-');
      const selectedMonthEl = document.getElementById('selectedMonth');
      if (selectedMonthEl) {
        selectedMonthEl.textContent = `${year}年${parseInt(month, 10)}月`;
      }
    });
  }
</script>

<%- include('../partials/regularEntryBackups') %>
<div class="modal fade" id="regularEntryModal" tabindex="-1" aria-labelledby="regularEntryModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 id="regularEntryModalTitle" class="modal-title">項目追加</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
      </div>
      <div class="modal-body"><%- include('../partials/regularEntryForm', { entryToEdit: null }) %></div>
    </div>
  </div>
</div>
<div id="regularEntryMenu" class="dropdown-menu shadow" role="menu" style="position: fixed; z-index: 1060;">
  <button type="button" id="regularEntryEdit" class="dropdown-item" role="menuitem">編集</button>
  <form id="regularEntryDelete" method="POST" class="no-js-submit m-0">
    <button class="dropdown-item text-danger" type="submit" role="menuitem">削除</button>
  </form>
</div>
<style>[data-regular-id] { -webkit-touch-callout: none; cursor: pointer; }</style>
<script type="application/json" id="regularEntryData"><%- JSON.stringify({ entries: regularEntries, editId: entryToEdit ? String(entryToEdit._id) : null }).replace(/</g, '\\u003c') %></script>
<script src="/js/regularEntries.js"></script>
