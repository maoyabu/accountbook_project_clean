<% layout('layouts/boilerplate') %>
<link rel="stylesheet" href="/css/finance-notice-board.css">
<div class="text-end">
  <a href="https://colts-wish-krs.craft.me/UJ4Y7muYdOwQlH/b/33EAF36C-74B4-4157-BADD-9B777DF0BD2E/%E5%AE%B6%E8%A8%88%E7%B0%BF-%E6%9C%80%E8%BF%91%E3%81%AE%E5%85%A5%E5%8A%9B-%E6%A4%9C%E7%B4%A2-EXCEL%E6%9B%B8%E5%87%BA%E3%81%97"
     target="_blank" rel="noopener"
     class="badge bg-success text-white text-decoration-none p-2">
    ガイド
  </a>
</div>
<div class="list-frame finance-notice-board">
  <div class="notice-heading">
    <h5 class="mb-0">直近の入力 - <%= Math.min(count, displayLimit) %> 件 / <%= count %>件</h5>
  </div>
  <div class="finance-list-filters mb-2">
    <div class="finance-list-count d-flex align-items-center gap-2">
      <label for="limitSelect" class="form-label mb-0">表示件数</label>
      <select name="limit" id="limitSelect" form="financeListFilterForm" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
        <option value="20" <%= displayLimit === 20 ? 'selected' : '' %>>20件</option>
        <option value="50" <%= displayLimit === 50 ? 'selected' : '' %>>50件</option>
        <option value="100" <%= displayLimit === 100 ? 'selected' : '' %>>100件</option>
      </select>
      <div class="d-flex align-items-center gap-2">
        <label for="sortOrder" class="form-label mb-0">並び順</label>
        <select name="sortOrder" id="sortOrder" form="financeListFilterForm" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
          <option value="date" <%= sortOrder === 'date' ? 'selected' : '' %>>使用日順</option>
          <option value="update_date" <%= sortOrder === 'update_date' ? 'selected' : '' %>>更新日順</option>
        </select>
      </div>
    </div>
    <details>
      <summary class="finance-list-filter-toggle">絞り込み</summary>
  <div class="filter-bar notice-filter-panel">
    <form id="financeListFilterForm" method="GET" action="/finance/list" class="d-flex flex-wrap align-items-end gap-3 mb-0">
      <input type="hidden" name="scope" value="<%= selectedFilters?.scope || 'user' %>">

      <div class="d-flex flex-column">
        <label for="cfFilter" class="form-label mb-1">区分</label>
        <select name="cf" id="cfFilter" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
          <option value="">全て</option>
          <% (filterOptions?.cfs || []).forEach(cf => { %>
            <option value="<%= cf %>" <%= selectedFilters?.cf === cf ? 'selected' : '' %>><%= cf %></option>
          <% }) %>
        </select>
      </div>
      <div class="d-flex flex-column">
        <label for="categoryFilter" class="form-label mb-1">小区分</label>
        <select name="category" id="categoryFilter" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
          <option value="">全て</option>
          <% (filterOptions?.categories || []).forEach(cat => { %>
            <option value="<%= cat %>" <%= selectedFilters?.category === cat ? 'selected' : '' %>><%= cat %></option>
          <% }) %>
        </select>
      </div>
      <div class="d-flex flex-column">
        <label for="paymentFilter" class="form-label mb-1">種別</label>
        <select name="payment_type" id="paymentFilter" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
          <option value="">全て</option>
          <% (filterOptions?.payments || []).forEach(pay => { %>
            <option value="<%= pay %>" <%= selectedFilters?.payment === pay ? 'selected' : '' %>><%= pay %></option>
          <% }) %>
        </select>
      </div>
      <div class="d-flex flex-column">
        <label for="subTagFilter" class="form-label mb-1">タグ</label>
        <select name="sub_tag" id="subTagFilter" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
          <option value="">全て</option>
          <% (filterOptions?.sub_tags || []).forEach(tag => { %>
            <option value="<%= tag %>" <%= selectedFilters?.sub_tag === tag ? 'selected' : '' %>><%= tag %></option>
          <% }) %>
        </select>
      </div>
      <div class="d-flex flex-column">
        <label for="keywordFilter" class="form-label mb-1">内容</label>
        <input type="text" name="keyword" id="keywordFilter" class="form-control form-control-sm w-auto" value="<%= selectedFilters?.keyword || '' %>" placeholder="フリーワード">
      </div>
      <div class="d-flex flex-column">
        <label for="dateFrom" class="form-label mb-1">開始日</label>
        <input type="date" name="date_from" id="dateFrom" class="form-control form-control-sm w-auto" value="<%= selectedFilters?.date_from || '' %>">
      </div>
      <div class="d-flex flex-column">
        <label for="dateTo" class="form-label mb-1">終了日</label>
        <input type="date" name="date_to" id="dateTo" class="form-control form-control-sm w-auto" value="<%= selectedFilters?.date_to || '' %>">
      </div>
      <div class="ms-auto d-flex gap-2 align-items-end">
        <button type="submit" class="btn btn-sm btn-primary">適用</button>
        <a class="btn btn-sm btn-outline-secondary" href="/finance/list">リセット</a>
      </div>
    </form>
  </div>
    </details>
  </div>


<div class="list-body">
  <%- include('../partials/financeNoticeList') %>
</div>
</div>

<%- include('../partials/financeEditModal') %>
