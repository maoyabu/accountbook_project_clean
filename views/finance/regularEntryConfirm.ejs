<% layout('layouts/boilerplate') %>
<link rel="stylesheet" href="/css/finance-notice-board.css">
<div class="container finance-notice-board notice-form-page notice-regular-page">

<div class="card mt-4">
  <div class="notice-heading">
    <h5 class="mb-0">重複確認</h5>
    <p>以下の項目はすでに同じ月に登録されています。内容を上書きして進めます。</p>
  </div>
  <div class="card-body">
    <form action="/matomete/regular-entry/update/confirm" method="POST">
      <input type="hidden" name="year" value="<%= year %>">
      <input type="hidden" name="month" value="<%= month %>">

      <table class="table table-bordered">
        <thead class="table-light">
          <tr>
            <th>区分</th>
            <th>内容</th>
            <th class="text-end">金額</th>
          </tr>
        </thead>
        <tbody>
          <% duplicates.forEach(d => { %>
            <tr>
              <td><%= d.cf %></td>
              <td><%= d.content %></td>
              <td class="text-end">¥<%= d.amount.toLocaleString() %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <% entries.forEach((entry, idx) => { %>
          <input type="hidden" name="entries[<%= idx %>][id]" value="<%= entry.id %>">
          <input type="hidden" name="entries[<%= idx %>][cf]" value="<%= entry.cf %>">
          <input type="hidden" name="entries[<%= idx %>][content]" value="<%= entry.content %>">
          <input type="hidden" name="entries[<%= idx %>][amount]" value="<%= entry.amount %>">
          <input type="hidden" name="entries[<%= idx %>][payment_type]" value="<%= entry.payment_type %>">
          <input type="hidden" name="entries[<%= idx %>][skip]" value="<%= entry.skip ? 1 : '' %>">
      <% }) %>
      <input type="hidden" name="force" value="1">

      <div class="d-flex justify-content-between mt-4">
        <a href="/matomete/regular-entry/push" class="btn btn-outline-secondary">戻って修正</a>
        <button type="submit" class="btn btn-primary">重複分は上書きして登録</button>
      </div>
    </form>
  </div>
</div>

</div>
