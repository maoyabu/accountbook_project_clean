<% const currentPage = (typeof page !== 'undefined') ? page : ''; %>
<% const pageAlias = { relationsearch: 'relation', relationdetail: 'relation', historyEntry: 'history', historyEdit: 'history', category: 'historyCategory', categoryEdit: 'historyCategory', sharedCategories: 'historyCategory', eventcal_batch: 'eventcal_events' }; %>
<% const activePage = pageAlias[currentPage] || currentPage; %>
<div class="myself-nav-wrap">
  <select id="myselfMenuSelect" class="form-select myself-nav-select" onchange="if (this.value) { window.location.href = this.value; }">
    <option value="/allaboutme/wantolist" data-match="/allaboutme/wantolist" <%= activePage === 'wantolist' ? 'selected' : '' %>>Myリスト</option>
    <option value="/allaboutme/eventcal2" data-match="/allaboutme/eventcal2" <%= activePage === 'eventcal2' ? 'selected' : '' %>>MyDialy</option>
    <option value="/history/list" data-match="/history" <%= activePage === 'history' ? 'selected' : '' %>>My History</option>
    <option value="/relation" data-match="/relation" <%= activePage === 'relation' ? 'selected' : '' %>>My Relation</option>
    <option value="/resume/myresume" data-match="/resume" <%= activePage === 'myresume' ? 'selected' : '' %>>My 履歴書</option>
    <option value="/allaboutme/report/mylist" data-match="/allaboutme/report" <%= activePage === 'report' ? 'selected' : '' %>>レポート</option>
    <option value="/allaboutme/export-diary" data-match="/allaboutme/export-diary" <%= activePage === 'export-diary' ? 'selected' : '' %>>MyDialy書出し</option>
    <option value="/allaboutme/eventcal_events" data-match="/allaboutme/eventcal_events" <%= activePage === 'eventcal_events' ? 'selected' : '' %>>MyDialy設定</option>
    <option value="/history/categories" data-match="/history/categories" <%= activePage === 'historyCategory' ? 'selected' : '' %>>My History設定</option>
  </select>
</div>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const select = document.getElementById('myselfMenuSelect');
    if (!select) return;
    const currentPath = window.location.pathname;
    const options = Array.from(select.options);
    const matched = options
      .filter(option => option.dataset.match && currentPath.startsWith(option.dataset.match))
      .sort((a, b) => b.dataset.match.length - a.dataset.match.length)[0];
    if (matched) {
      select.value = matched.value;
    }
  });
</script>
