<% const currentPage = (typeof page !== 'undefined') ? page : ''; %>
<div class="resume-nav-wrap">
  <select id="resumeMenuSelect" class="form-select resume-nav-select" onchange="if (this.value) { window.location.href = this.value; }">
    <option value="/resume/myresume" data-match="/resume/myresume" <%= currentPage === 'myresume' ? 'selected' : '' %>>My 履歴書</option>
    <option value="/resume/mycv" data-match="/resume/mycv" <%= currentPage === 'mycv' ? 'selected' : '' %>>My 職務履歴書</option>
    <% if (currentUser?.hasPlannerCategory) { %>
      <option value="/planner/planner" data-match="/planner/planner" <%= currentPage === 'planner' ? 'selected' : '' %>>Planner 職務履歴書</option>
    <% } %>
    <% if (resume) { %>
      <option value="/resume/edit/<%= resume._id %>" data-match="/resume/edit" <%= currentPage === 'resume' ? 'selected' : '' %>>履歴書設定</option>
    <% } else { %>
      <option value="/resume/create" data-match="/resume/create">履歴書を設定する</option>
    <% } %>
  </select>
</div>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const select = document.getElementById('resumeMenuSelect');
    if (!select) return;
    const currentPath = window.location.pathname;
    const options = Array.from(select.options);
    const matched = options.find(option => option.dataset.match && currentPath.startsWith(option.dataset.match));
    if (matched) {
      select.value = matched.value;
    }
  });
</script>
