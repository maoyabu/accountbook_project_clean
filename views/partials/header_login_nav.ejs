<% const cu = (typeof currentUser !== 'undefined') ? currentUser : null; %>
<% const agid = (typeof activeGroupId !== 'undefined') ? activeGroupId : null; %>
<% const svc = (typeof services !== 'undefined' && services)
  ? Object.assign({ allaboutme: true, finance: true, assets: true, message: true }, services)
  : { allaboutme: true, finance: true, assets: true, message: true }; %>
<% const activeSvc = (typeof activeService !== 'undefined' && activeService) ? activeService : 'finance'; %>
<% const activeGroupStr = agid ? agid.toString() : null; %>
<% const pathNow = (typeof currentPath !== 'undefined') ? currentPath : ''; %>
<% const isActive = (path) => pathNow.startsWith(path); %>
<% const activeThemeClass = activeSvc === 'finance' ? 'is-finance' : (activeSvc === 'message' ? 'is-message' : 'is-myself'); %>
<% const hasGroup = cu && Array.isArray(cu.groups) && cu.groups.length > 0 && activeGroupStr && cu.groups.some(group => group && group._id && group._id.toString() === activeGroupStr); %>
<% const serviceTop = activeSvc === 'myself' ? '/myself/top' : (activeSvc === 'message' ? '/message/top' : '/finance/top'); %>
<% const serviceLabel = activeSvc === 'myself' ? 'Myself' : (activeSvc === 'message' ? 'Message' : 'Finance'); %>
<% const serviceIcon = activeSvc === 'myself' ? 'fa-user' : (activeSvc === 'message' ? 'fa-envelope' : 'fa-wallet'); %>
<% const quickMenuEnabled = typeof financeQuickMenuEnabled === 'undefined' ? true : financeQuickMenuEnabled !== false; %>
<% const activeGroupName = (cu && Array.isArray(cu.groups) && activeGroupStr)
  ? (cu.groups.find(group => group && group._id && group._id.toString() === activeGroupStr)?.group_name || '')
  : ''; %>
<% const menuAvatar = (cu && typeof cu.avatar === 'string' && (cu.avatar.startsWith('http') || cu.avatar.startsWith('/') || cu.avatar.startsWith('data:')))
  ? cu.avatar
  : '/images/def_user_icon.png'; %>

<header id="top-nav" class="theme-<%= activeSvc %>">
  <nav class="navbar top-nav-bar">
    <div class="container-fluid top-nav-inner">
      <div class="top-nav-left">
        <button class="navbar-toggler menu-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasMenu" aria-controls="offcanvasMenu">
          <i class="fas fa-bars"></i>
        </button>
        <div class="top-nav-service">
          <a class="top-nav-service-label" href="<%= serviceTop %>">
            <i class="fa-solid <%= serviceIcon %>"></i>
            <span class="top-nav-service-text"><%= serviceLabel %></span>
            <% if (activeGroupName) { %>
              <span class="top-nav-group-name"><i class="fa-solid fa-users"></i> <%= activeGroupName %></span>
            <% } %>
          </a>
        </div>
      </div>

      <div class="top-nav-center">
        <a class="navbar-brand top-nav-brand" href="<%= serviceTop %>">
          <img class="top-nav-brand-icon" src="/images/App_icon.png" alt="App Icon">
          <span class="brand-title">All About me</span>
          <% if (activeGroupName) { %>
            <span class="brand-group"><%= activeGroupName %></span>
          <% } %>
        </a>
      </div>

      <div class="top-nav-right">
        <a class="top-nav-icon" href="/logout" title="ログアウト">
          <i class="fas fa-sign-out-alt"></i>
        </a>
      </div>
    </div>
  </nav>

  <div class="offcanvas offcanvas-start offcanvas-menu-custom" tabindex="-1" id="offcanvasMenu" aria-labelledby="offcanvasMenuLabel" style="width: 320px;">
    <div class="offcanvas-header menu-header">
      <h5 class="offcanvas-title" id="offcanvasMenuLabel">All About me</h5>
      <div class="menu-header-actions">
        <a class="menu-guide-link" href="/guide">
          <i class="fa-solid fa-book-open"></i> ガイド
        </a>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
      </div>
    </div>
    <div class="offcanvas-body">
      <% if (activeSvc === 'finance' && hasGroup && svc.finance) { %>
        <div class="menu-section menu-quick-toggle-section">
          <label class="finance-quick-toggle menu-quick-toggle" title="よく使う項目の表示切替">
            <span><i class="fa-solid fa-thumbtack"></i> よく使う項目</span>
            <input type="checkbox" data-finance-quick-toggle <%= quickMenuEnabled ? 'checked' : '' %>>
            <span class="finance-quick-toggle-track" aria-hidden="true"></span>
          </label>
        </div>
      <% } %>

      <div class="menu-section menu-user-section">
        <% if (cu) { %>
          <div class="menu-user d-flex align-items-center gap-2">
            <img src="<%= menuAvatar %>" alt="" class="menu-avatar">
            <div>
              <div class="menu-user-name">
                <%= cu.displayname ? cu.displayname : cu.username %>
                <% if (cu.isAdmin) { %>
                  <span class="menu-badge">管理者</span>
                <% } %>
              </div>
              <div class="menu-muted"><%= cu.email %></div>
            </div>
          </div>
        <% } %>
      </div>

      <div class="menu-section">
        <div class="menu-title"><i class="fa-solid fa-users"></i> グループ</div>
        <form action="/group/select" method="POST">
          <select name="groupId" class="form-select form-select-sm" onchange="this.form.submit()" <%= cu && cu.groups && cu.groups.length > 1 ? '' : 'disabled' %>>
            <% if (cu && cu.groups && cu.groups.length > 0) { %>
              <% cu.groups.forEach(group => { %>
                <option value="<%= group._id %>" <%= (String(group._id) === String(agid)) ? 'selected' : '' %>><%= group.group_name %></option>
              <% }) %>
            <% } else { %>
              <option value="">グループ未登録</option>
            <% } %>
          </select>
        </form>
      </div>

      <div class="menu-section">
        <div class="menu-title"><i class="fa-solid fa-rotate"></i> サービス切替</div>
        <div class="menu-pills">
          <form action="/service/select" method="POST">
            <input type="hidden" name="service" value="finance">
            <button type="submit" class="menu-pill <%= activeSvc === 'finance' ? 'is-active is-finance' : '' %>" <%= svc.finance ? '' : 'disabled' %>>
              <span class="menu-pill-main"><i class="fa-solid fa-wallet"></i><span>Finance</span></span>
            </button>
          </form>
          <form action="/service/select" method="POST">
            <input type="hidden" name="service" value="myself">
            <button type="submit" class="menu-pill <%= activeSvc === 'myself' ? 'is-active is-myself' : '' %>" <%= svc.allaboutme ? '' : 'disabled' %>>
              <span class="menu-pill-main"><i class="fa-solid fa-user"></i><span>Myself</span></span>
            </button>
          </form>
          <form action="/service/select" method="POST">
            <input type="hidden" name="service" value="message">
            <button type="submit" class="menu-pill <%= activeSvc === 'message' ? 'is-active is-message' : '' %>" <%= svc.message ? '' : 'disabled' %>>
              <span class="menu-pill-main"><i class="fa-regular fa-envelope"></i><span>Message</span></span>
            </button>
          </form>
        </div>
      </div>

      <div class="menu-section">
        <div class="menu-title"><i class="fa-solid fa-layer-group"></i> 機能</div>
        <% if (activeSvc === 'finance') { %>
          <div class="menu-subtitle">家計簿</div>
          <ul class="nav flex-column menu-list">
            <li class="nav-item"><a class="nav-link menu-item <%= isActive('/finance/list') ? 'is-active is-finance' : '' %> <%= hasGroup && svc.finance ? '' : 'disabled' %>" href="<%= hasGroup && svc.finance ? '/finance/list' : '#' %>"><i class="fa-solid fa-rectangle-list"></i> 直近の入力</a></li>
            <li class="nav-item"><a class="nav-link menu-item <%= isActive('/finance/entry') ? 'is-active is-finance' : '' %> <%= hasGroup && svc.finance ? '' : 'disabled' %>" href="<%= hasGroup && svc.finance ? '/finance/entry' : '#' %>"><i class="fa-solid fa-pen-to-square"></i> 新規登録</a></li>
            <li class="nav-item"><a class="nav-link menu-item <%= isActive('/finance/receipt') ? 'is-active is-finance' : '' %> <%= hasGroup && svc.finance ? '' : 'disabled' %>" href="<%= hasGroup && svc.finance ? '/finance/receipt/new' : '#' %>"><i class="fa-solid fa-receipt"></i> レシートから登録</a></li>
            <li class="nav-item"><a class="nav-link menu-item <%= isActive('/matomete/regular-entry/push') ? 'is-active is-finance' : '' %> <%= hasGroup && svc.finance ? '' : 'disabled' %>" href="<%= hasGroup && svc.finance ? '/matomete/regular-entry/push' : '#' %>"><i class="fa-solid fa-layer-group"></i> まとめて入力</a></li>
            <li class="nav-item"><a class="nav-link menu-item <%= isActive('/finance/search') ? 'is-active is-finance' : '' %> <%= hasGroup && svc.finance ? '' : 'disabled' %>" href="<%= hasGroup && svc.finance ? '/finance/search' : '#' %>"><i class="fa-solid fa-magnifying-glass"></i> 検索</a></li>
            <li class="nav-item"><a class="nav-link menu-item <%= isActive('/export/view') ? 'is-active is-finance' : '' %> <%= hasGroup && svc.finance ? '' : 'disabled' %>" href="<%= hasGroup && svc.finance ? '/export/view' : '#' %>"><i class="fa-solid fa-file-export"></i> EXCEL書出し</a></li>
            <li class="nav-item"><a class="nav-link menu-item <%= isActive('/export/payment-check') ? 'is-active is-finance' : '' %> <%= hasGroup && svc.finance ? '' : 'disabled' %>" href="<%= hasGroup && svc.finance ? '/export/payment-check' : '#' %>"><i class="fa-solid fa-list-check"></i> 月次支払種別チェック</a></li>
            <li class="nav-item"><a class="nav-link menu-item <%= isActive('/export/payment-summary-yearly') ? 'is-active is-finance' : '' %> <%= hasGroup && svc.finance ? '' : 'disabled' %>" href="<%= hasGroup && svc.finance ? '/export/payment-summary-yearly' : '#' %>"><i class="fa-solid fa-table-columns"></i> 年次支払種別集計</a></li>
            <li class="nav-item"><a class="nav-link menu-item <%= isActive('/finance/budget') ? 'is-active is-finance' : '' %> <%= hasGroup && svc.finance ? '' : 'disabled' %>" href="<%= hasGroup && svc.finance ? '/finance/budget' : '#' %>"><i class="fa-solid fa-gear"></i> 家計簿設定</a></li>
          </ul>

          <div class="menu-subtitle">Dashboard</div>
          <ul class="nav flex-column menu-list">
            <li class="nav-item"><a class="nav-link menu-item <%= isActive('/export/dashboard/monthly-g') ? 'is-active is-finance' : '' %> <%= hasGroup && svc.finance ? '' : 'disabled' %>" href="<%= hasGroup && svc.finance ? '/export/dashboard/monthly-g' : '#' %>"><i class="fa-solid fa-chart-line"></i> 月次集計（グループ）</a></li>
            <li class="nav-item"><a class="nav-link menu-item <%= isActive('/export/dashboard/monthly-m') ? 'is-active is-finance' : '' %> <%= hasGroup && svc.finance ? '' : 'disabled' %>" href="<%= hasGroup && svc.finance ? '/export/dashboard/monthly-m' : '#' %>"><i class="fa-solid fa-user"></i> 月次集計（個人）</a></li>
            <li class="nav-item"><a class="nav-link menu-item <%= isActive('/export/dashboard/yearly-g') ? 'is-active is-finance' : '' %> <%= hasGroup && svc.finance ? '' : 'disabled' %>" href="<%= hasGroup && svc.finance ? '/export/dashboard/yearly-g' : '#' %>"><i class="fa-solid fa-chart-line"></i> 年次集計（グループ）</a></li>
            <li class="nav-item"><a class="nav-link menu-item <%= isActive('/export/dashboard/yearly-m') ? 'is-active is-finance' : '' %> <%= hasGroup && svc.finance ? '' : 'disabled' %>" href="<%= hasGroup && svc.finance ? '/export/dashboard/yearly-m' : '#' %>"><i class="fa-solid fa-user"></i> 年次集計（個人）</a></li>
            <li class="nav-item"><a class="nav-link menu-item <%= isActive('/export/dashboard/monthly-calendar-m') ? 'is-active is-finance' : '' %> <%= hasGroup && svc.finance ? '' : 'disabled' %>" href="<%= hasGroup && svc.finance ? '/export/dashboard/monthly-calendar-m' : '#' %>"><i class="fa-solid fa-calendar-days"></i> 月次カレンダー集計</a></li>
            <li class="nav-item"><a class="nav-link menu-item <%= isActive('/export/yearly-stacked') ? 'is-active is-finance' : '' %> <%= hasGroup && svc.finance ? '' : 'disabled' %>" href="<%= hasGroup && svc.finance ? '/export/yearly-stacked' : '#' %>"><i class="fa-solid fa-chart-column"></i> 年グラフ（グループ）</a></li>
            <li class="nav-item"><a class="nav-link menu-item <%= isActive('/export/monthly-stacked') ? 'is-active is-finance' : '' %> <%= hasGroup && svc.finance ? '' : 'disabled' %>" href="<%= hasGroup && svc.finance ? '/export/monthly-stacked' : '#' %>"><i class="fa-solid fa-chart-column"></i> 月グラフ（グループ）</a></li>
          </ul>

          <ul class="nav flex-column menu-list">
            <li class="nav-item"><a class="nav-link menu-item <%= isActive('/asset/display') ? 'is-active is-finance' : '' %> <%= svc.assets ? '' : 'disabled' %>" href="<%= svc.assets ? '/asset/display' : '#' %>"><i class="fa-regular fa-money-bill-1 icon-asset"></i> 資産管理</a></li>
          </ul>
        <% } else if (activeSvc === 'message') { %>
          <ul class="nav flex-column menu-list">
            <li class="nav-item"><a class="nav-link menu-item <%= isActive('/message/top') ? 'is-active is-message' : '' %> <%= hasGroup && svc.message ? '' : 'disabled' %>" href="<%= hasGroup && svc.message ? '/message/top' : '#' %>"><i class="fa-regular fa-envelope"></i> メッセージ一覧</a></li>
            <li class="nav-item"><a class="nav-link menu-item <%= isActive('/message/settings') ? 'is-active is-message' : '' %> <%= hasGroup && svc.message ? '' : 'disabled' %>" href="<%= hasGroup && svc.message ? '/message/settings' : '#' %>"><i class="fa-solid fa-gear"></i> Message設定</a></li>
          </ul>
        <% } else { %>
          <ul class="nav flex-column menu-list">
            <li class="nav-item"><a class="nav-link menu-item <%= isActive('/allaboutme/wantolist') ? 'is-active is-myself' : '' %> <%= hasGroup && svc.allaboutme ? '' : 'disabled' %>" href="<%= hasGroup && svc.allaboutme ? '/allaboutme/wantolist' : '#' %>"><i class="fa-solid fa-list-check"></i> マイリスト</a></li>
            <li class="nav-item"><a class="nav-link menu-item <%= isActive('/allaboutme/eventcal2') ? 'is-active is-myself' : '' %> <%= hasGroup && svc.allaboutme ? '' : 'disabled' %>" href="<%= hasGroup && svc.allaboutme ? '/allaboutme/eventcal2' : '#' %>"><i class="fa-solid fa-calendar-days"></i> My Diary</a></li>
            <li class="nav-item"><a class="nav-link menu-item <%= isActive('/history/list') ? 'is-active is-myself' : '' %>" href="/history/list"><i class="fa-solid fa-clock-rotate-left"></i> My History</a></li>
            <li class="nav-item"><a class="nav-link menu-item <%= isActive('/relation') ? 'is-active is-myself' : '' %>" href="/relation"><i class="fa-solid fa-people-group"></i> My Relation</a></li>
            <li class="nav-item"><a class="nav-link menu-item <%= isActive('/resume/myresume') ? 'is-active is-myself' : '' %>" href="/resume/myresume"><i class="fa-solid fa-book"></i> My 履歴書</a></li>
            <li class="nav-item"><a class="nav-link menu-item <%= isActive('/allaboutme/report/mylist') ? 'is-active is-myself' : '' %>" href="/allaboutme/report/mylist"><i class="fa-regular fa-clipboard"></i> レポート</a></li>
            <li class="nav-item"><a class="nav-link menu-item <%= isActive('/history/categories') ? 'is-active is-myself' : '' %>" href="/history/categories"><i class="fa-solid fa-folder-tree"></i> My History設定</a></li>
          </ul>
        <% } %>
      </div>

      <div class="menu-section">
        <div class="menu-title"><i class="fa-solid fa-share-nodes"></i> 横断</div>
        <ul class="nav flex-column menu-list">
          <li class="nav-item"><a class="nav-link menu-item <%= isActive('/gchat') ? `is-active ${activeThemeClass}` : '' %>" href="/gchat"><i class="fa-solid fa-comments"></i> Chat</a></li>
          <li class="nav-item"><a class="nav-link menu-item <%= isActive('/support') ? `is-active ${activeThemeClass}` : '' %>" href="/support"><i class="fa-solid fa-headset"></i> サポート</a></li>
          <li class="nav-item"><a class="nav-link menu-item <%= isActive('/setting') ? `is-active ${activeThemeClass}` : '' %>" href="/setting"><i class="fa-solid fa-gear"></i> 設定</a></li>
          <% if (cu && cu.isAdmin) { %>
            <li class="nav-item"><a class="nav-link menu-item <%= isActive('/admin') ? `is-active ${activeThemeClass}` : '' %>" href="/admin"><i class="fa-solid fa-shield-halved"></i> 管理画面</a></li>
          <% } %>
        </ul>
      </div>

      <div class="menu-section">
        <div class="menu-title"><i class="fa-solid fa-link"></i> 関連サービス</div>
        <div class="menu-pills">
          <a class="menu-pill related-pill related-blue" href="https://menu-service-app-0f01af8634e2.herokuapp.com/users/my-top" target="_blank" rel="noopener">
            <span class="menu-pill-main"><i class="fa-solid fa-calendar-days"></i><span class="menu-pill-label">7 DAYS PLAN</span></span>
            <span class="related-tag">外部</span>
          </a>
          <a class="menu-pill related-pill related-green" href="https://menu-service-app-0f01af8634e2.herokuapp.com/users/stock-top" target="_blank" rel="noopener">
            <span class="menu-pill-main"><i class="fa-solid fa-box"></i><span class="menu-pill-label">ストック管理</span></span>
            <span class="related-tag">外部</span>
          </a>
          <a class="menu-pill related-pill related-yellow" href="https://menu-service-app-0f01af8634e2.herokuapp.com/users/packing" target="_blank" rel="noopener">
            <span class="menu-pill-main"><i class="fa-solid fa-clipboard-list"></i><span class="menu-pill-label">パッキングプラン</span></span>
            <span class="related-tag">外部</span>
          </a>
        </div>
      </div>

      <div class="menu-logout">
        <a class="btn btn-outline-danger w-100" href="/logout">
          <i class="fas fa-sign-out-alt"></i> ログアウト
        </a>
      </div>
    </div>
  </div>
</header>
