<% layout('layouts/boilerplate') %>
<link rel="stylesheet" href="/css/finance-notice-board.css">

<div class="container mt-0 finance-notice-board notice-asset-page">
  <% if (inventoryCallout) { %>
    <div class="alert alert-warning d-flex flex-column flex-lg-row justify-content-between align-items-lg-center">
      <div class="fw-bold mb-2 mb-lg-0">
        <%= inventoryCallout.label %>度の棚卸し実施時期です。棚卸しを実施してください。
      </div>
      <a href="/asset/inventory?month=<%= inventoryCallout.monthValue %>" class="btn btn-warning text-white">棚卸しに進む</a>
    </div>
  <% } %>

  <% const latestInventoryLabel = latestInventory ? `${latestInventory.inventoryMonth.getFullYear()}年${String(latestInventory.inventoryMonth.getMonth() + 1).padStart(2, '0')}月` : '最新の棚卸し未登録'; %>
  <!-- 資産状況サマリー -->
  <div class="card shadow-sm mb-4">
    <div class="notice-heading d-flex flex-wrap gap-2 justify-content-between align-items-center">
      <div class="page-title-guide-row"><span class="fw-bold">資産状況 <small class="notice-asset-caption">現在の登録内容</small></span><a href="https://colts-wish-krs.craft.me/UJ4Y7muYdOwQlH/b/9FEF0134-024D-41B5-8B4D-44E9E627B86F/%E8%B3%87%E7%94%A3%E7%AE%A1%E7%90%86"
     target="_blank" rel="noopener"
     class="page-guide-link">
    ガイド
  </a></div>

    </div>
    <div class="card-body">
      <% const totalValue = Number(totalYen || 0); %>
      <% const totalClass = totalValue >= 0 ? 'asset-total-positive' : 'asset-total-negative'; %>
      <h4 class="asset-total-badge <%= totalClass %>">資産合計　¥<%= totalValue.toLocaleString() %></h4>
      <table class="table borderless mt-3">
        <tr>
          <td>金融資産</td>
          <td class="text-end">¥<%= totalByCf['金融資産'].toLocaleString() %></td>
        </tr>
        <tr>
          <td>実物資産</td>
          <td class="text-end">¥<%= totalByCf['実物資産'].toLocaleString() %></td>
        </tr>
        <tr>
          <td>無形資産</td>
          <td class="text-end">¥<%= totalByCf['無形資産'].toLocaleString() %></td>
        </tr>
        <tr>
          <td>負債</td>
          <td class="text-end">¥<%= totalByCf['負債'].toLocaleString() %></td>
        </tr>
      </table>
    </div>
  </div>

  <section class="card shadow-sm mb-4" id="assetList" aria-labelledby="assetListTitle">
    <div class="notice-heading d-flex flex-wrap gap-2 justify-content-between align-items-center">
      <strong id="assetListTitle">資産一覧</strong>
      <button type="button" id="newAssetBtn" class="btn notice-add-button btn-sm">＋ 資産を新規登録</button>
    </div>
    <div class="notice-asset-list" role="list" aria-label="現在の資産明細">
      <% assets.forEach(asset => {
        const assetPayload = { id: String(asset._id), asset_cf: asset.asset_cf, asset_item: asset.asset_item, code: asset.code || '', content: asset.content || '', amount: asset.amount, monetary_unit: asset.monetary_unit };
      %>
        <div class="finance-notice-row asset-management-row" role="listitem" data-id="<%= asset._id %>" data-asset="<%= JSON.stringify(assetPayload) %>" data-asset-cf="<%= asset.asset_cf %>" tabindex="0" aria-haspopup="menu" aria-label="右クリックまたは長押しで編集・削除">
          <div class="finance-notice-content">
            <span class="notice-chip notice-chip-cf"><%= asset.asset_cf %></span>
            <span class="notice-chip"><%= asset.asset_item %></span>
            <strong class="finance-notice-title"><%= asset.content %></strong>
            <% if (asset.code) { %><span class="notice-asset-caption"><%= asset.code %></span><% } %>
          </div>
          <div class="finance-notice-meta notice-asset-dates">
            <span>登録 <%= asset.entry_date ? new Date(asset.entry_date).toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo' }) : '-' %></span>
            <span>更新 <%= asset.update_date ? new Date(asset.update_date).toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo' }) : '-' %></span>
          </div>
          <div class="finance-notice-amount"><span class="notice-asset-caption d-block">円換算金額</span>¥<%= Number(asset.amountYen || 0).toLocaleString() %></div>
          <span class="finance-notice-more" aria-hidden="true">⋮</span>
        </div>
      <% }) %>
      <% if (!assets.length) { %><p class="notice-empty">資産はまだ登録されていません。「資産を新規登録」から追加してください。</p><% } %>
    </div>
  </section>

  <!-- 資産推移グラフ -->
  <div class="card shadow-sm mb-4">
    <div class="notice-heading d-flex flex-wrap gap-2 justify-content-between align-items-center">
      <strong>資産推移</strong>
      <div class="d-flex flex-wrap gap-2"><a href="/asset/inventory" class="btn notice-add-button btn-sm">棚卸の実施</a><a href="/asset/history" class="btn btn-outline-secondary btn-sm">棚卸履歴</a></div>
    </div>
    <div class="card-body">
      <% const hasChart = (chartData.labels || []).length > 0; %>
      <% if (!hasChart) { %>
        <div class="alert alert-secondary mb-0">棚卸履歴がありません。最新の棚卸しを登録してください。</div>
      <% } else { %>
        <canvas id="assetHistoryChart" height="140"></canvas>
      <% } %>
    </div>
  </div>

  <% if (showRateInfo) { %>
    <!-- レート情報 -->
    <div class="card mb-4">
      <div class="card-body text-muted small">
        <% Object.entries(exchangeRates || {}).forEach(([code, rate]) => { %><p>※ <%= code %> の円換算レート（取得時点）: <%= rate %> 円</p><% }) %>
        <% if (stockPrices) { %>
          <% Object.entries(stockPrices).forEach(([code, price]) => { %>
            <p>※ 株式 <%= code %>: 1株（前日終値） = <%= price.toLocaleString() %> 円</p>
          <% }) %>
        <% } %>
      </div>
    </div>
  <% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  const chartData = <%- JSON.stringify(chartData || {}) %>;

  if (chartData.labels && chartData.labels.length) {
    const ctx = document.getElementById('assetHistoryChart').getContext('2d');
    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: chartData.labels,
        datasets: [
          {
            label: '金融資産',
            data: chartData.series?.financial || [],
            backgroundColor: 'rgba(83, 123, 102, 0.72)',
            borderColor: '#537b66',
            stack: 'net'
          },
          {
            label: '実物資産',
            data: chartData.series?.physical || [],
            backgroundColor: 'rgba(145, 169, 127, 0.65)',
            borderColor: '#91a97f',
            stack: 'net'
          },
          {
            label: '無形資産',
            data: chartData.series?.intangible || [],
            backgroundColor: 'rgba(188, 167, 105, 0.65)',
            borderColor: '#bca769',
            stack: 'net'
          },
          {
            label: '負債',
            data: chartData.series?.debt || [],
            backgroundColor: 'rgba(171, 117, 99, 0.65)',
            borderColor: '#ab7563',
            stack: 'net'
          },
          {
            type: 'line',
            label: '合計',
            data: chartData.series?.total || [],
            borderColor: '#304b3a',
            backgroundColor: '#304b3a',
            tension: 0.2,
            pointRadius: 3,
            fill: false,
            yAxisID: 'y'
          }
        ]
      },
      options: {
        responsive: true,
        interaction: { intersect: false, mode: 'index' },
        plugins: {
          legend: { position: 'top' },
          tooltip: {
            callbacks: {
              label: (ctx) => `${ctx.dataset.label}: ¥${Number(ctx.raw || 0).toLocaleString()}`
            }
          }
        },
        scales: {
          y: {
            stacked: true,
            ticks: { callback: (value) => `¥${Number(value).toLocaleString()}` },
            beginAtZero: true
          },
          x: { stacked: true }
        }
      }
    });
  }
</script>

<%- include('../partials/assetModal') %>
