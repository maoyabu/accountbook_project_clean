<% layout('layouts/boilerplate') %>
<link rel="stylesheet" href="/css/finance-notice-board.css">
<div class="finance-notice-board notice-asset-page">
  <div class="notice-heading d-flex flex-wrap gap-2 justify-content-between align-items-center">
    <div><h5 class="mb-1"><%= monthValue %> の棚卸詳細</h5><span class="notice-asset-caption">更新 <%= new Date(inventory.updatedAt).toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo' }) %> · <%= inventory.updatedBy?.displayname || inventory.updatedBy?.username || '記録なし' %></span></div>
    <div class="d-flex gap-2"><a href="/asset/inventory?month=<%= monthValue %>" class="btn notice-add-button btn-sm">この月を編集</a><a href="/asset/history" class="btn btn-outline-secondary btn-sm">棚卸履歴へ戻る</a></div>
  </div>
  <div class="notice-asset-total my-3">資産合計 <strong>¥<%= Number(inventory.totalYen || 0).toLocaleString() %></strong></div>
  <p class="notice-asset-caption">保存時点の資産を表示しています。現在の資産一覧から削除した項目も含まれます。</p>
  <div class="table-responsive">
    <table class="table notice-asset-table">
      <thead><tr><th>内容</th><th class="text-end">数量／金額</th><th class="text-end">円換算金額</th><th>更新日時</th></tr></thead>
      <tbody>
        <% (inventory.items || []).forEach(item => { %>
          <tr><td><span class="notice-chip"><%= item.asset_cf %></span><span class="notice-chip"><%= item.asset_item %></span><strong><%= item.content %></strong><% if (item.code) { %><div class="notice-asset-caption"><%= item.code %></div><% } %></td><td class="text-end"><%= Number(item.amount || 0).toLocaleString() %></td><td class="text-end fw-bold">¥<%= Number(item.amountYen || 0).toLocaleString() %></td><td class="notice-asset-caption"><%= item.updatedAt ? new Date(item.updatedAt).toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo' }) : '-' %><br><%= item.updatedBy?.displayname || item.updatedBy?.username || '記録なし' %></td></tr>
        <% }) %>
        <% if (!inventory.items?.length) { %><tr><td colspan="4" class="notice-empty">明細がありません。</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
