<%- include('_mailHeader') %>
<div class="email-container">
  <div class="email-header">
    <h1>予算の到達状況</h1>
  </div>
  <p><%= name %> さん</p>
  <p><strong><%= month %></strong> の予算に対する到達状況をお知らせします。</p>
  <% groups.forEach(group => { %>
    <hr>
    <h3><%= group.groupName %></h3>
    <p>支出予算の到達率: <strong><%= group.totalRate %>%</strong> / 月の日数到達率: <strong><%= dayRate %>%</strong></p>
    <% const alertItems = group.alerts || []; %>
    <% if (alertItems.length === 0) { %>
      <p>※ しきい値を超えた支出項目はありません。</p>
    <% } else { %>
      <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px;">
        <% alertItems.forEach(alert => { %>
          <div style="background:#fff1f1;border:1px solid #f3c6c6;border-radius:12px;padding:10px;">
            <div style="font-weight:700;color:#d93025;font-size:14px;"><%= alert.targetLabel %></div>
            <div style="font-weight:600;color:#d93025;font-size:13px;margin-top:4px;">
              実績到達率: <%= alert.actualRate %>% （実績: <%= Number(alert.actual).toLocaleString('ja-JP') %> / 予算: <%= Number(alert.budget).toLocaleString('ja-JP') %>）
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  <% }) %>
  <p>
    予算設定の確認はこちら: <a href="<%= budgetUrl %>"><%= budgetUrl %></a>
  </p>
</div>
<%- include('_mailFooter') %>
